{
  "id": "umf-access-local-production-replay",
  "version": "0.1.0",
  "scope": "Local prerelease packaging and installed-wheel replay; no publication or native qualification",
  "python": "3.14.8",
  "checkerPythonTarget": "3.12",
  "runtimeAbi": {
    "distribution": "umf_access",
    "version": "0.1.0.dev0",
    "abi": "umf-access-runtime/0.1"
  },
  "runtimeDependencies": {
    "pydantic": "2.14.1",
    "pydantic-core": "2.50.1",
    "annotated-types": "0.8.0",
    "typing-extensions": "4.16.0",
    "typing-inspection": "0.4.4"
  },
  "buildDependencies": {
    "build": "1.3.0",
    "hatchling": "1.27.0",
    "packaging": "26.3",
    "pluggy": "1.7.0",
    "pyproject-hooks": "1.3.3",
    "trove-classifiers": "2026.9.21.13"
  },
  "checkers": {
    "mypy": "2.4.0",
    "pyright": "1.1.414"
  },
  "requiredExports": {
    "umf_access": [
      "RUNTIME_ABI"
    ],
    "umf_access.types": [
      "StrictModel",
      "ActionRef"
    ],
    "umf_access.values": [
      "validate_boolean",
      "validate_integer",
      "validate_decimal",
      "validate_string",
      "validate_binary",
      "validate_date",
      "validate_instant",
      "validate_local",
      "validate_length",
      "validate_range",
      "validate_allowed"
    ],
    "umf_access.codec_support": [
      "revalidate_model",
      "checked_row"
    ],
    "umf_access.dsl": [
      "Column",
      "FieldRef",
      "RecordRef",
      "Query",
      "Terminal",
      "Related"
    ],
    "umf_access.capture": [
      "ExpressionNode",
      "ProjectionRef",
      "CapturedKey",
      "render_logical",
      "capture"
    ]
  },
  "forbiddenImports": [
    "weft",
    "truss",
    "ashlar",
    "umf",
    "psycopg",
    "databricks",
    "pyspark"
  ],
  "nativeTargets": "UNTESTED; no driver extras or platform support selected"
}
