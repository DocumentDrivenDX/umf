      "FieldRef",
      "RecordRef",
      "Query",
      "Terminal",
      "Related"
    ],
    "umf_access.capture": [
      "ExpressionNode",
      "ProjectionRef",
      "CapturedKey",
      "render_logical",
      "capture"
    ]
  },
  "forbiddenImports": [
    "weft",
    "truss",
    "ashlar",
    "umf",
    "psycopg",
    "databricks",
    "pyspark"
