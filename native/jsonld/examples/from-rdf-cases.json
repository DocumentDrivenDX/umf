[
  {
    "id": "exact-native",
    "source": "<urn:s> <urn:p> \"9007199254740993\"^^<http://www.w3.org/2001/XMLSchema#integer> .\n<urn:s> <urn:p> \"333333333.33333329\"^^<http://www.w3.org/2001/XMLSchema#double> .\n<urn:s> <urn:p> \"-0.0\"^^<http://www.w3.org/2001/XMLSchema#double> .\n",
