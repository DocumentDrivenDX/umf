{
  "name": "@umf/core",
  "version": "0.10.12",
  "private": true,
  "type": "module",
  "files": [
    "dist/",
    "spec/"
  ],
  "packageManager": "bun@1.4.3",
  "imports": {
    "#umf-source": {
      "types": {
        "browser": "./src/index-browser-v4.ts",
        "default": "./src/index-node-v4.ts"
      },
      "browser": "./src/index-browser-v4.ts",
      "bun": "./src/index-node-v4.ts",
      "node": "./src/index-node-v4.ts",
      "default": "./src/index-browser-v4.ts"
    },
    "#security-candidate-condition": {
      "types": {
        "browser": "./src/extensions/security/candidate-condition-host-browser.ts",
        "default": "./src/extensions/security/candidate-condition-host-node.ts"
      },
      "browser": "./src/extensions/security/candidate-condition-host-browser.ts",
      "bun": "./src/extensions/security/candidate-condition-host-node.ts",
      "node": "./src/extensions/security/candidate-condition-host-node.ts",
      "default": "./src/extensions/security/candidate-condition-host-browser.ts"
    }
  },
  "exports": {
    ".": {
      "types": {
        "node": "./dist/src/index-node-v4.d.ts",
        "default": "./dist/src/index-browser-v4.d.ts"
      },
      "browser": "./dist/umf-browser.js",
      "node": "./dist/umf-node.js",
      "import": "./dist/umf-browser.js",
      "default": "./dist/umf-browser.js"
    },
    "./runtime/wasm": {
      "types": "./dist/runtime/wasm/index.d.ts",
      "node": "./dist/runtime/wasm/index-node.js",
      "import": "./dist/runtime/wasm/index.js"
    },
    "./loader-contract": {
      "types": {
        "node": "./dist/src/domain-packs/loader-contract-node.d.ts",
        "default": "./dist/src/domain-packs/loader-contract-browser.d.ts"
      },
      "browser": "./dist/loader-contract.js",
      "node": "./dist/loader-contract.node.js",
      "import": "./dist/loader-contract.js",
      "default": "./dist/loader-contract.js"
    }
  },
  "scripts": {
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit && bun node_modules/typescript/bin/tsc -p tsconfig.tools.json",
    "test": "bun run test:prepare && bun scripts/run-tests.ts",
    "test:fast": "bun scripts/run-tests.ts --keep-going --exclude-file scripts/slow-tests.txt",
    "build": "bun scripts/build.ts",
    "build:schema-browser": "bun scripts/build-schema-browser.ts",
    "test:schema-browser": "bun scripts/schema-browser-package-browser.ts",
    "test:browser": "bun scripts/browser.ts",
    "test:conformance": "bun scripts/conformance.ts",
    "test:schemas": "bun scripts/audit-extension-packages.ts && bun scripts/audit-json-schemas.ts",
    "build:protobuf": "bun scripts/build-protobuf.ts",
    "build:smithy-experiment": "bun scripts/build-smithy-js.ts",
    "build:postgresql": "bun scripts/build-postgresql.ts",
    "test:postgresql-catalog": "bun scripts/postgresql-catalog-oracle.ts",
    "build:arrow": "bun scripts/build-arrow.ts",
    "build:docs": "python3 scripts/actions-docs/render-diagrams.py && bun scripts/actions-docs/build.ts",
    "test:docs:build": "python3 scripts/actions-docs/render-diagrams.py --check && bun scripts/actions-docs/build.ts --check && bun scripts/actions-docs/check.ts && python3 scripts/actions-docs/render-negative-control.py && python3 scripts/actions-docs/build-negative-controls.py",
    "test:docs:examples": "bun scripts/actions-docs/portable-example.ts && bun scripts/actions-docs/refusal-example.ts && bun scripts/actions-docs/rule-example.ts",
    "test:docs:browser": "bun scripts/actions-docs/browser.ts",
    "docs:example": "bun scripts/actions-docs/inspect-example.ts",
    "docs:example:native": "bun scripts/actions-docs/native-example.ts",
    "docs:example:refusal": "bun scripts/actions-docs/refusal-example.ts",
    "docs:example:rule": "bun scripts/actions-docs/rule-example.ts",
    "test:prepare": "bun run build && bun run build:postgresql && bun scripts/build-test-prerequisites.ts && bun run build:smithy-experiment && bun scripts/prepare-action-tests.ts",
    "test:actions": "bun scripts/prepare-action-tests.ts && bun scripts/run-tests.ts tests/actions-reference",
    "build:sdk": "bun run build && bun scripts/package-sdk.ts",
    "test:sdk": "bun run build:sdk && python3 scripts/test-sdk-package.py",
    "check:saga-package": "python3 scripts/build-saga-package.py --check",
    "build:saga-runtime": "bun scripts/build-saga-runtime.ts",
    "test:access-e2e": "bun scripts/access-e2e.ts",
    "build:reference": "bun scripts/build-postgresql.ts && bun scripts/build-protobuf.ts && bun scripts/build-reference-wasm.ts && bun scripts/reference/build.ts",
    "test:reference": "bun test tests/reference && bun scripts/reference/build.ts --check",
    "test:reference:browser": "bun scripts/reference/browser.ts && bun scripts/reference/reader-browser.ts && bun scripts/reference/ontology-browser.ts",
    "check:reference-boundaries": "bun scripts/reference/check-boundaries.ts",
    "build:metamodel": "bun scripts/metamodel/build.ts",
    "check:metamodel": "bun scripts/metamodel/build.ts --check",
    "test:metamodel": "bun test tests/metamodel && bun scripts/metamodel-browser.ts",
    "check:core-authority": "bun scripts/check-core-authority.ts",
    "test:rust-core": "cargo test --locked -p umf-core -p umf-core-wire -p umf-tagged-wire -p umf-codegen -p umf-metamodel -p umf-metamodel-cli -p umf-cli -p umf-graphql",
    "check:release-versions": "python3 scripts/check-release-versions.py",
    "test:sdk-installed": "node scripts/test-native-sdk-install.mjs \"$UMF_SDK_PACKAGE\"",
    "build:visuals": "bun scripts/visuals/render-static.ts",
    "test:visuals:browser": "bun scripts/visual-rendering-browser.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@libpg-query/parser": "17.6.10",
    "@typespec/compiler": "1.16.0",
    "@typespec/emitter-framework": "0.21.0",
    "@typespec/events": "0.86.0",
    "@typespec/graphql": "0.3.0",
    "@typespec/http": "1.16.0",
    "@typespec/json-schema": "1.16.0",
    "@typespec/mutator-framework": "0.17.1",
    "@typespec/openapi": "1.16.0",
    "@typespec/openapi3": "1.16.0",
    "@typespec/protobuf": "0.86.0",
    "@typespec/rest": "0.86.0",
    "@typespec/sse": "0.86.0",
    "@typespec/streams": "0.86.0",
    "@typespec/versioning": "0.86.0",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "apache-arrow": "21.2.0",
    "avsc": "5.7.9",
    "buffer": "6.0.3",
    "flatbuffers": "25.9.23",
    "graphql": "17.0.2",
    "jsonld": "9.0.0",
    "n3": "2.7.12",
    "rdf-literal": "2.0.0",
    "rdf-validate-shacl": "0.6.5",
    "util": "0.12.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@documentdrivendx/umf-schema-browser": "2.1.0",
    "@documentdrivendx/umf-visual": "https://github.com/DocumentDrivenDX/umf-visual/releases/download/v0.5.0/documentdrivendx-umf-visual-0.5.0.tgz",
    "@launchql/protobufjs": "7.2.6",
    "@types/bun": "1.4.2",
    "@types/n3": "1.26.4",
    "hyparquet": "1.31.1",
    "playwright": "1.63.0",
    "rdfxml-streaming-parser": "3.3.0",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3"
  },
  "patchedDependencies": {
    "jsonld@9.0.0": "patches/jsonld@9.0.0.patch"
  },
  "license": "MIT OR Apache-2.0"
}
