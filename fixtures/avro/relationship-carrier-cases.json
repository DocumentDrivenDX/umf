      "schemaText": "{\"type\":\"record\",\"name\":\"Order\",\"namespace\":\"sales\",\"fields\":[{\"name\":\"customer\",\"type\":{\"type\":\"record\",\"name\":\"CustomerKey\",\"fields\":[{\"name\":\"id\",\"type\":\"float\"}]}}]}\n"
    },
