            }
          }
        }
      ],
      "expectedWrite": true,
      "expectedValues": [
        {
          "customer": {
            "id": {
              "$bytes": "00ff"
            }
          }
        }
      ],
      "schemaText": "{\"type\":\"record\",\"name\":\"Order\",\"namespace\":\"sales\",\"fields\":[{\"name\":\"customer\",\"type\":{\"type\":\"record\",\"name\":\"CustomerKey\",\"fields\":[{\"name\":\"id\",\"type\":\"bytes\"}]}}]}\n"
    },
    {
      "id": "float-key-narrows",
      "request": {
        "recordName": "Order",
        "namespace": "sales",
        "fieldName": "customer",
        "keyRecordName": "CustomerKey",
        "shape": "one",
        "components": [
          {
            "name": "id",
            "type": "float"
          }
        ]
      },
      "values": [
        {
          "customer": {
            "id": 1.0000000000000002
