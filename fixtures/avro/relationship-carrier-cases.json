            "type": "boolean"
          }
        ]
      },
      "values": [
        {
          "customer": {
            "id": true
          }
        }
      ],
      "expectedWrite": true,
      "expectedValues": [
        {
          "customer": {
            "id": true
          }
        }
      ],
      "schemaText": "{\"type\":\"record\",\"name\":\"Order\",\"namespace\":\"sales\",\"fields\":[{\"name\":\"customer\",\"type\":{\"type\":\"record\",\"name\":\"CustomerKey\",\"fields\":[{\"name\":\"id\",\"type\":\"boolean\"}]}}]}\n"
    },
    {
      "id": "binary-key",
      "request": {
        "recordName": "Order",
        "namespace": "sales",
        "fieldName": "customer",
        "keyRecordName": "CustomerKey",
        "shape": "one",
        "components": [
          {
