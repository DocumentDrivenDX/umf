{
  "umf": "0.10.0",
  "id": "postgresql18-exact-search-binding",
  "vocabularies": {
    "umf.binding": {
      "version": "0.2.0"
    }
  },
  "modules": [],
  "extensions": {
    "umf.binding": {
      "profile": "umf-binding-2",
      "logical": {
        "documentId": "typed-search-e2e",
        "coreVersion": "0.10.0"
      },
      "target": {
        "system": "postgresql",
        "version": "18",
        "subset": "typed-access-columns/0.1"
      },
      "elements": [
        {
          "module": "search",
          "element": "Doc",
          "table": "docs"
        }
      ],
      "fields": [
        {
          "module": "search",
          "element": "id",
          "storage": "column",
          "column": "id"
        },
        {
          "module": "search",
          "element": "body",
          "storage": "column",
          "column": "body"
        },
        {
          "module": "search",
          "element": "embedding",
          "storage": "column",
          "column": "embedding"
        },
        {
          "module": "search",
          "element": "owner",
          "storage": "column",
          "column": "owner"
        }
      ],
      "relationships": [],
      "indexes": []
    }
  }
}
