      "sourceAccepts": true,
      "targetAccepts": false
    },
    {
      "case": "nullability",
      "sourceAccepts": true,
      "targetAccepts": false
    },
    {
      "case": "uniqueItems",
      "sourceAccepts": false,
      "targetAccepts": true
    },
    {
      "case": "minItems",
      "sourceAccepts": false,
      "targetAccepts": true
    },
    {
