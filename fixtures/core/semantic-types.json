{
  "umf": "0.9.0",
  "id": "contact-semantic-types",
  "title": "Contact metadata",
  "vocabularies": {"future.native": {"version": "1.0.0"}},
  "modules": [{
    "id": "contacts",
    "namespace": "example.contact",
    "elements": [{
      "id": "email",
      "kind": "field",
      "scalarType": "string",
      "nullability": "absent-allowed",
      "cardinality": "one",
      "examples": [{"string": "sample@example.invalid"}],
      "semanticTypes": [{"vocabulary": "example.contact", "version": "2026-01", "term": "email"}],
      "extensions": {"future.native": {"domain_type": "email", "detection": {"pattern": "publisher-owned"}, "validations": [{"type": "publisher-expectation", "severity": "warning"}]}}
    }, {
      "id": "phone",
      "kind": "field",
      "scalarType": "string",
      "semanticTypes": [{"vocabulary": "example.contact", "version": "2026-01", "term": "phone_number"}],
      "extensions": {}
    }, {
      "id": "provider",
      "kind": "field",
      "scalarType": "string",
      "semanticTypes": [{"vocabulary": "example.healthcare", "version": "1.0.0", "term": "provider_id", "futureQualifier": {"retained": true}}],
      "extensions": {}
    }]
  }]
}
