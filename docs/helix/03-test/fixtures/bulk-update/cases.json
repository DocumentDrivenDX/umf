{
  "protocol": "bulk-update-test-cases/1",
  "owner": "UMF US-902; independent manifest consumer UMF US-903",
  "state": "authored expectations, runtime not executed",
  "model": "model.json",
  "population": [
    {
      "identity": "2",
      "key": "c2",
      "version": "1",
      "active": true,
      "last_seen": 50
    },
    {
      "identity": "10",
      "key": "c10",
      "version": "3",
      "active": true,
      "last_seen": 90
    },
    {
      "identity": "11",
      "key": "c11",
      "version": "2",
      "active": true,
      "last_seen": 99
    },
    {
      "identity": "12",
      "key": "c12",
      "version": "1",
      "active": true,
      "last_seen": 150
    }
  ],
  "cases": [
    {
      "id": "valid-update",
      "input": {
        "sql": "UPDATE Customer SET active=FALSE WHERE last_seen<:cutoff",
        "cutoff": {
          "integerToken": "100"
        },
        "batchSize": 2
      },
      "expected": {
        "selected": [
          "2",
          "10",
          "11"
        ],
        "partition": [
          2,
          1
        ],
        "values": [
          false,
          false,
          false
        ]
      }
    },
    {
      "id": "underfilled-partition",
      "input": {
        "counts": [
          1,
          2
        ],
        "batchSize": 2,
        "items": 3
      },
      "expected": {
        "refuse": "PAP_INVALID"
      }
    },
    {
      "id": "cross-namespace-token",
      "input": {
        "jobs": [
          {
            "namespace": "n1",
            "id": "j"
          },
          {
            "namespace": "n2",
            "id": "j"
          }
        ],
        "batch": 0,
        "item": 0
      },
      "expected": {
        "tokens": [
          "pap1/n1/j/0/0",
          "pap1/n2/j/0/0"
        ]
      }
    },
    {
      "id": "masked-null-predicate",
      "input": {
        "row": {
          "id": "12",
          "active": true,
          "last_seen": null
        },
        "predicate": "active=FALSE AND last_seen<100"
      },
      "expected": {
        "refuse": "WFT-MUTATION-DOMAIN",
        "runnable": false
      }
    },
    {
      "id": "forged-seal",
      "input": {
        "edit": "append target then recompute all digests",
        "issuerRetainedBytesMatch": false
      },
      "expected": {
        "refuse": "PAP_SEAL",
        "runnable": false
      }
    },
    {
      "id": "registry-preservation",
      "input": {
        "additionalCallback": "vendor.opaque/1",
        "actionOriginalBytes": true
      },
      "expected": {
        "callbackPreserved": true,
        "executionVerified": false
      }
    },
    {
      "id": "missing-snapshot-claim",
      "input": {
        "omit": "snapshot.coherentCut"
      },
      "expected": {
        "compatible": false
      }
    },
    {
      "id": "stopped-submit-replay",
      "input": {
        "equalRetainedSubmit": true,
        "state": "stopped"
      },
      "expected": {
        "status": "submitted",
        "state": "stopped"
      }
    },
    {
      "id": "cancelled-submit-replay",
      "input": {
        "equalRetainedSubmit": true,
        "state": "cancelled"
      },
      "expected": {
        "status": "submitted",
        "state": "cancelled"
      }
    },
    {
      "id": "stale-worker",
      "input": {
        "fence": "1",
        "currentFence": "2",
        "workerAuthorized": false
      },
      "expected": {
        "refuse": "AUTHORIZATION",
        "validJobUnchanged": true
      }
    },
    {
      "id": "deleted-before-guard",
      "input": {
        "originalTargetAbsent": true,
        "txInvoked": false
      },
      "expected": {
        "batch": "conflict",
        "code": "PAP_GUARD",
        "itemTerminal": false
      }
    },
    {
      "id": "rollback-before-stop-crash",
      "input": {
        "effectAdmitted": true,
        "originalTermination": "confirmed-noncommit",
        "terminalOutcome": null,
        "failureDisposition": null
      },
      "expected": {
        "job": "stopped",
        "code": "PAP_ABORT_DISPOSITION_UNKNOWN",
        "retry": false
      }
    },
    {
      "id": "unknown-native-status",
      "input": {
        "effectAdmitted": true,
        "pg_xact_status": null,
        "terminalOutcome": null
      },
      "expected": {
        "job": "reconciling",
        "retry": false
      }
    },
    {
      "id": "empty-manifest",
      "input": {
        "items": []
      },
      "expected": {
        "batches": [],
        "job": "completed",
        "businessReceipt": false
      }
    },
    {
      "id": "duplicate-json-member",
      "input": {
        "originalUtf8": "{\"protocol\":\"umf.actions.plan/1\",\"protocol\":\"other\"}"
      },
      "expected": {
        "refuse": "PAP_INVALID"
      }
    },
    {
      "id": "unpaired-surrogate",
      "input": {
        "originalUtf8": "{\"name\":\"\\ud800\"}"
      },
      "expected": {
        "refuse": "PAP_INVALID"
      }
    }
  ],
