{
  "umf": "0.8.0",
  "id": "product-local-action-demo",
  "vocabularies": {
    "umf.actions": {
      "version": "0.1.0"
    }
  },
  "modules": [
    {
      "id": "sales",
      "namespace": "sales",
      "elements": [
        {
          "id": "product-id",
          "name": "id",
          "kind": "field",
          "scalarType": "string",
          "cardinality": "one",
          "nullability": "required",
          "extensions": {}
        },
        {
          "id": "product-name",
          "name": "name",
          "kind": "field",
          "scalarType": "string",
          "cardinality": "one",
          "nullability": "required",
          "extensions": {}
        },
        {
          "id": "products",
          "name": "products",
          "kind": "record",
          "members": [
            {
              "module": "sales",
              "element": "product-id"
            },
            {
              "module": "sales",
              "element": "product-name"
            }
          ],
          "keys": [
            {
              "id": "pk",
              "name": "primary",
              "primary": true,
              "fields": [
                {
                  "module": "sales",
                  "element": "product-id"
                }
              ]
            }
          ],
          "extensions": {}
        }
      ],
      "extensions": {
        "umf.actions": {
          "actions": [
            {
              "id": "set-name-local",
              "name": "Set local product name",
              "description": "Set one name in this browser-local Truss store using an issued local-owner capability.",
              "parameters": [
                {
                  "id": "products",
                  "kind": "entity",
                  "target": {
                    "module": "sales",
                    "element": "products",
                    "key": "pk"
                  },
                  "required": true
                },
                {
                  "id": "name-value",
                  "kind": "value",
                  "field": {
                    "module": "sales",
                    "element": "product-name"
                  },
                  "required": true
                }
              ],
              "outputs": [],
              "preconditions": [],
              "postconditions": [],
              "failures": [],
              "reads": [],
              "writes": [
                {
                  "id": "customer-write",
                  "record": {
                    "module": "sales",
                    "element": "products"
                  },
                  "selector": {
                    "language": "umf.actions.keys",
                    "version": "1",
                    "expression": "{\"entity\":\"products\"}",
                    "references": [
                      {
                        "parameter": "products"
                      }
                    ]
                  },
                  "maxEntities": 1,
                  "fields": [
                    {
                      "module": "sales",
                      "element": "product-name"
                    }
                  ],
                  "relationships": [],
                  "create": false,
                  "delete": false
                }
              ],
              "binding": {
                "kind": "recipe",
                "profile": {
                  "id": "graph-write",
                  "version": "1"
                },
                "effects": [
                  {
                    "id": "set-name",
                    "kind": "set",
                    "entity": {
                      "parameter": "products"
                    },
                    "values": [
                      {
                        "field": {
                          "module": "sales",
                          "element": "product-name"
                        },
                        "value": {
                          "parameter": "name-value"
                        }
                      }
                    ]
                  }
                ]
              },
              "authorization": {
                "kind": "policy",
                "profile": {
                  "id": "umf.actions.local-store-owner",
                  "version": "1"
                },
                "resources": [
                  "customer-write"
                ]
              },
              "attribution": {
                "subject": "actor-profile",
                "profile": {
                  "id": "umf.actions.local-owner",
                  "version": "1"
                }
              },
              "atomicity": "single-store",
              "idempotency": "caller-key-optional",
              "result": {
                "identities": "created-and-changed",
                "version": "store-opaque",
                "receipt": "read-at-least"
              }
            }
          ]
        }
      }
    }
  ]
}
