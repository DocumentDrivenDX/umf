{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:actions:saga:protocol:1",
  "title": "Proposed saga logical protocol 1 requests",
  "oneOf": [
    {
      "$ref": "#/$defs/submitRequest"
    },
    {
      "$ref": "#/$defs/statusRequest"
    },
    {
      "$ref": "#/$defs/claimRequest"
    },
    {
      "$ref": "#/$defs/executeRequest"
    },
    {
      "$ref": "#/$defs/cancelRequest"
    },
    {
      "$ref": "#/$defs/reconcileRequest"
    },
    {
      "$ref": "#/$defs/resolveRequest"
    },
    {
      "$ref": "#/$defs/recover-controlRequest"
    },
    {
      "$ref": "#/$defs/historyRequest"
    }
  ],
  "$defs": {
    "instance": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "saga": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "module",
        "saga",
        "revision"
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
        },
        "operation": {
          "enum": [
            "submit",
            "claim",
            "execute",
            "cancel",
            "reconcile",
            "resolve"
          ]
        }
      },
      "required": [
        "id",
        "operation"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "urn:umf:actions:0.1.0#/$defs/key"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "urn:umf:actions:0.1.0#/$defs/literal"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "key",
        "components"
      ],
      "additionalProperties": false
    },
    "values": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "urn:umf:actions:0.1.0#/$defs/literal"
          },
          {
            "$ref": "#/$defs/entity"
          }
        ]
      }
    },
    "invocation": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "direction": {
          "enum": [
            "forward",
            "compensation"
          ]
        }
      },
      "required": [
        "step",
        "direction"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "direction": {
          "enum": [
            "forward",
            "compensation"
          ]
        },
        "state": {
          "enum": [
            "idle",
            "admitted",
            "indeterminate",
            "committed",
            "rejected",
            "conflict",
            "failed",
            "refused",
            "unnecessary",
            "irreversible"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "step",
        "direction",
        "state"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "status": {
          "const": "state"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "definition": {
          "$ref": "#/$defs/definition"
        },
        "phase": {
          "enum": [
            "queued",
            "running",
            "reconciling",
            "compensating",
            "succeeded",
            "compensated",
            "cancelled",
            "intervention-required"
          ]
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "forward": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "compensations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invocation"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outputs": {
          "$ref": "#/$defs/values"
        }
      },
      "required": [
        "status",
        "instance",
        "definition",
        "phase",
        "cancelRequested",
        "forward",
        "compensations",
        "pending"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "succeeded"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "required": [
              "outputs"
            ]
          },
          "else": {
            "not": {
              "required": [
                "outputs"
              ]
            }
          }
        }
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "denied",
            "unsupported",
            "expired",
            "conflict"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "status",
        "code"
      ],
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "properties": {
        "status": {
          "const": "indeterminate"
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        }
      },
      "required": [
        "status",
        "recovery"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "status": {
          "const": "failed"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        }
      },
      "required": [
        "status",
        "code",
        "recovery"
      ],
      "additionalProperties": false
    },
    "submitRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "umf.actions.saga/1"
        },
        "operation": {
          "const": "submit"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "target": {
          "$ref": "#/$defs/definition"
        },
        "inputs": {
          "$ref": "#/$defs/values"
        }
      },
      "required": [
        "protocol",
        "operation",
        "key",
        "target",
        "inputs"
      ],
      "additionalProperties": false
    },
    "statusRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "umf.actions.saga/1"
        },
        "operation": {
          "const": "status"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        }
      },
      "required": [
        "protocol",
        "operation",
        "instance"
      ],
      "additionalProperties": false
    },
    "claimRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "umf.actions.saga/1"
        },
        "operation": {
          "const": "claim"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        }
      },
      "required": [
        "protocol",
        "operation",
        "instance"
      ],
      "additionalProperties": false
    },
    "executeRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "umf.actions.saga/1"
        },
        "operation": {
          "const": "execute"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "fence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])",
          "maxLength": 256
        }
      },
      "required": [
        "protocol",
        "operation",
        "instance",
        "invocation",
        "fence"
      ],
      "additionalProperties": false
    },
    "cancelRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "umf.actions.saga/1"
        },
        "operation": {
          "const": "cancel"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        }
      },
      "required": [
        "protocol",
        "operation",
        "instance"
      ],
      "additionalProperties": false
    },
    "reconcileRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "umf.actions.saga/1"
        },
        "operation": {
          "const": "reconcile"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        }
      },
      "required": [
        "protocol",
        "operation",
        "instance"
      ],
      "additionalProperties": false
    },
    "resolveRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "umf.actions.saga/1"
        },
        "operation": {
          "const": "resolve"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
        }
      },
      "required": [
        "protocol",
        "operation",
        "instance",
        "invocation",
        "evidence"
      ],
      "additionalProperties": false
    },
    "recover-controlRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "umf.actions.saga/1"
        },
        "operation": {
          "const": "recover-control"
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        }
      },
      "required": [
        "protocol",
        "operation",
        "recovery"
      ],
      "additionalProperties": false
    },
    "historyRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "umf.actions.saga/1"
        },
        "operation": {
          "const": "history"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "protocol",
        "operation",
        "instance",
        "limit"
      ],
      "additionalProperties": false
    },
    "submitted": {
      "type": "object",
      "properties": {
        "status": {
          "const": "submitted"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "definition": {
          "$ref": "#/$defs/definition"
        }
      },
      "required": [
        "status",
        "instance",
        "definition"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "status": {
          "const": "claimed"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "fence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])",
          "maxLength": 256
        },
        "leaseUntil": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])"
        }
      },
      "required": [
        "status",
        "instance",
        "invocation",
        "fence",
        "leaseUntil"
      ],
      "additionalProperties": false
    },
    "idle": {
      "type": "object",
      "properties": {
        "status": {
          "const": "idle"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        }
      },
      "required": [
        "status",
        "instance"
      ],
      "additionalProperties": false
    },
    "actionOutcome": {
      "oneOf": [
        {
          "$ref": "urn:umf:actions:tx-results:1"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "rejected",
                "conflict",
                "failed",
                "denied",
                "unsupported",
                "expired"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "status",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "status": {
          "const": "outcome"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "result": {
          "$ref": "#/$defs/actionOutcome"
        }
      },
      "required": [
        "status",
        "instance",
        "invocation",
        "result"
      ],
      "additionalProperties": false
    },
    "cancelled": {
      "type": "object",
      "properties": {
        "status": {
          "const": "cancel-requested"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        }
      },
      "required": [
        "status",
        "instance"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "kind": {
          "enum": [
            "admitted",
            "outcome",
            "cancel",
            "retired",
            "authority-denied",
            "intervention",
            "resolved",
            "completed"
          ]
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "result": {
          "$ref": "#/$defs/actionOutcome"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "sequence",
        "kind",
        "actor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "outcome"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "invocation",
              "result"
            ]
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "properties": {
        "status": {
          "const": "history"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "instance",
        "events",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "recovered": {
      "type": "object",
      "properties": {
        "status": {
          "const": "recovered"
        },
        "operation": {
          "enum": [
            "submit",
            "claim",
            "execute",
            "cancel",
            "reconcile",
            "resolve"
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/submitted"
            },
            {
              "$ref": "#/$defs/claim"
            },
            {
              "$ref": "#/$defs/idle"
            },
            {
              "$ref": "#/$defs/outcome"
            },
            {
              "$ref": "#/$defs/cancelled"
            },
            {
              "$ref": "#/$defs/state"
            },
            {
              "$ref": "#/$defs/refusal"
            },
            {
              "$ref": "#/$defs/failure"
            }
          ]
        }
      },
      "required": [
        "status",
        "operation",
        "result"
      ],
      "additionalProperties": false
    },
    "submitResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/submitted"
        },
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "claimResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "$ref": "#/$defs/idle"
        },
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "executeResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/outcome"
        },
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "statusResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/state"
        },
        {
          "$ref": "#/$defs/refusal"
        }
      ]
    },
    "cancelResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/cancelled"
        },
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "reconcileResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/state"
        },
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "resolveResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/state"
        },
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "recover-controlResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/recovered"
        },
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "historyResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/page"
        },
        {
          "$ref": "#/$defs/refusal"
        }
      ]
    }
  }
}
