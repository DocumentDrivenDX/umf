{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:ddd:0.1.0",
  "title": "UMF-authored DDD semantic profile 0.1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/entity"
    },
    {
      "$ref": "#/$defs/value"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/service"
    },
    {
      "$ref": "#/$defs/repository"
    },
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/map"
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "module",
        "element"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "type": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "scalar"
            },
            "name": {
              "enum": [
                "string",
                "boolean",
                "integer",
                "decimal",
                "date-time",
                "bytes"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "concept"
            },
            "target": {
              "$ref": "#/$defs/reference"
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "required": [
        "type",
        "cardinality"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/type"
        },
        "cardinality": {
          "enum": [
            "one",
            "optional",
            "many"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invariant": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "language",
        "version",
        "expression",
        "references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "definition",
            "aggregate"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        }
      }
    },
    "term": {
      "type": "object",
      "required": [
        "term",
        "definition"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "concept": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/reference"
        },
        "output": {
          "$ref": "#/$defs/reference"
        },
        "emits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "direction",
        "equivalence",
        "description",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/reference"
        },
        "target": {
          "$ref": "#/$defs/reference"
        },
        "direction": {
          "enum": [
            "source-to-target",
            "target-to-source",
            "bidirectional"
          ]
        },
        "equivalence": {
          "enum": [
            "partial",
            "asserted-equivalent",
            "distinct"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "antiCorruptionLayer": {
          "type": "object",
          "required": [
            "ownerModule",
            "description"
          ],
          "properties": {
            "ownerModule": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "kind",
        "fields",
        "identity"
      ],
      "properties": {
        "kind": {
          "const": "entity"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "object",
          "required": [
            "fields",
            "scope"
          ],
          "properties": {
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scope": {
              "enum": [
                "context",
                "aggregate"
              ]
            }
          }
        },
        "aggregate": {
          "type": "object",
          "required": [
            "members"
          ],
          "properties": {
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reference"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "value": {
      "type": "object",
      "required": [
        "kind",
        "fields",
        "equality"
      ],
      "properties": {
        "kind": {
          "const": "value"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "equality": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "kind",
        "fields",
        "emittedBy",
        "immutable"
      ],
      "properties": {
        "kind": {
          "const": "domain-event"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "emittedBy": {
          "$ref": "#/$defs/reference"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "kind",
        "operations"
      ],
      "properties": {
        "kind": {
          "const": "domain-service"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "kind",
        "aggregate",
        "operations"
      ],
      "properties": {
        "kind": {
          "const": "repository"
        },
        "aggregate": {
          "$ref": "#/$defs/reference"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "kind",
        "terms"
      ],
      "properties": {
        "kind": {
          "const": "bounded-context"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        }
      }
    },
    "map": {
      "type": "object",
      "required": [
        "kind",
        "mappings"
      ],
      "properties": {
        "kind": {
          "const": "context-map"
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping"
          }
        }
      }
    }
  }
}
