{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:security:protection:domain-resolution:0.1.0",
  "type": "object",
  "properties": {
    "pins": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "documentId",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": "object"
          }
        },
        "required": [
          "revision",
          "document"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pins",
    "documents"
  ],
  "additionalProperties": false
}
