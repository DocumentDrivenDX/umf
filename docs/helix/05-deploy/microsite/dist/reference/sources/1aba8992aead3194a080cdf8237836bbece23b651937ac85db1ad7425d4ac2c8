{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:table-migration-phases:0.5",
  "title": "Single atomic field-replacement phase",
  "type": "object",
  "properties": {
    "executionProfile": {
      "type": "object",
      "properties": {
        "version": {
          "const": "umf.table-migration-execution/0.5"
        },
        "progressRelation": {
          "const": "umf_lifecycle_progress"
        },
        "ownerOnly": {
          "const": true
        },
        "ingressProfile": {
          "const": "umf.table-generation-ingress/0.1"
        }
      },
      "required": [
        "version",
        "progressRelation",
        "ownerOnly",
        "ingressProfile"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^phase-[0-9]{5}$"
          },
          "kind": {
            "const": "field-replacement"
          },
          "transaction": {
            "const": "required"
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8192,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^step-[0-9]{5}$"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "transaction",
          "steps"
        ]
      }
    }
  },
  "required": [
    "executionProfile",
    "phases"
  ],
  "additionalProperties": false
}
