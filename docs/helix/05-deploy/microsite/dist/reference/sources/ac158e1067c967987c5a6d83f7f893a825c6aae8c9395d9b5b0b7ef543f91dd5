{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:openapi-reference-result:0.1.0",
  "type": "object",
  "required": [
    "kind",
    "target",
    "chain",
    "effectiveAnnotations",
    "complete",
    "limitations"
  ],
  "properties": {
    "kind": {
      "enum": [
        "parameter",
        "header",
        "response",
        "request-body",
        "example",
        "link",
        "security-scheme"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "uri",
        "pointer",
        "node"
      ],
      "properties": {
        "uri": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    },
    "chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "uri",
          "pointer",
          "reference"
        ],
        "properties": {
          "uri": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "reference": {
            "$ref": "#/$defs/node"
          }
        },
        "additionalProperties": false
      }
    },
    "effectiveAnnotations": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "complete": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  }
}
