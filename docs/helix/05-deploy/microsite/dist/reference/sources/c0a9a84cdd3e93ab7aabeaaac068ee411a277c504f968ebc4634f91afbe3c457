{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:projection:tablespec-avro:0.1.0",
  "type": "object",
  "required": [
    "status",
    "source",
    "policy",
    "issues",
    "mappings"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "blocked",
        "projected"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "nativeSchema": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "recordName",
        "namespace",
        "fields",
        "lossPolicy"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "recordName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])"
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "name",
              "representation",
              "nullable"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
              },
              "representation": {
                "enum": [
                  "string",
                  "int32",
                  "int64",
                  "float32",
                  "float64",
                  "boolean",
                  "decimal",
                  "date",
                  "timestamp-micros",
                  "local-timestamp-micros",
                  "embedding-float32"
                ]
              },
              "nullable": {
                "anyOf": [
                  {
                    "const": "source"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "itemsNullable": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "itemsNullable"
                  ],
                  "properties": {
                    "itemsNullable": {
                      "type": "boolean"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "representation": {
                      "const": "embedding-float32"
                    }
                  }
                }
              }
            ]
          }
        },
        "lossPolicy": {
          "enum": [
            "strict",
            "allow-reported-loss"
          ]
        },
        "context": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "code",
          "classification",
          "detail",
          "retainedInSource"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "representation-change",
              "not-enforced",
              "unsupported",
              "annotation-only"
            ]
          },
          "detail": {
            "type": "string"
          },
          "retainedInSource": {
            "const": true
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "column",
          "field",
          "representation",
          "nullable"
        ],
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "representation": {
            "enum": [
              "string",
              "int32",
              "int64",
              "float32",
              "float64",
              "boolean",
              "decimal",
              "date",
              "timestamp-micros",
              "local-timestamp-micros",
              "embedding-float32"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "nullable": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "nativeSchema"
        ],
        "properties": {
          "target": {
            "$ref": "urn:umf:core:0.1.0"
          },
          "nativeSchema": {
            "type": "string"
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "target"
              ],
              "properties": {
                "target": {
                  "$ref": "urn:umf:core:0.1.0"
                },
                "nativeSchema": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "nativeSchema"
              ],
              "properties": {
                "target": {
                  "$ref": "urn:umf:core:0.1.0"
                },
                "nativeSchema": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
