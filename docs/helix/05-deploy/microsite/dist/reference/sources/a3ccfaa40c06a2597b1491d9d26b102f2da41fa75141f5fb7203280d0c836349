{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:spark:0.1.0",
  "type": "object",
  "properties": {
    "profile": {
      "const": "spark-datatype-json"
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "required": [
    "profile",
    "root"
  ],
  "additionalProperties": true,
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  }
}
