{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:table-migration-options:0.7",
  "title": "G04 checked field conversion source intent",
  "type": "object",
  "properties": {
    "version": {"const": "umf.table-migration-options/0.7"},
    "backfills": {"type": "array", "maxItems": 0},
    "concurrentIndexes": {"type": "array", "maxItems": 0},
    "reviewedChanges": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/marker"}},
    "validations": {"type": "array", "maxItems": 0},
    "conversions": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/conversion"}}
  },
  "required": ["version", "backfills", "concurrentIndexes", "reviewedChanges", "validations", "conversions"],
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object", "properties": {"module": {"type": "string", "minLength": 1, "maxLength": 256}, "element": {"type": "string", "minLength": 1, "maxLength": 256}},
      "required": ["module", "element"], "additionalProperties": false
    },
    "marker": {
      "type": "object", "properties": {"id": {"type": "string", "pattern": "^review-[a-f0-9]{24}$"}, "kind": {"enum": ["drop-column", "rename-column", "change-column-type", "tighten-not-null", "relax-not-null", "replace-check", "replace-foreign-key", "replace-index", "replace-primary-key", "change-policy", "change-default", "change-operation", "change-operation-context", "conversion-effects"]}, "path": {"type": "string", "minLength": 1}, "oldDigest": {"$ref": "#/$defs/digest"}, "newDigest": {"$ref": "#/$defs/digest"}},
      "required": ["id", "kind", "path", "oldDigest", "newDigest"], "additionalProperties": false
    },
    "conversion": {
      "type": "object", "properties": {
        "table": {"type": "string", "minLength": 1, "maxLength": 256}, "field": {"$ref": "#/$defs/ref"},
        "recipe": {"$ref": "#/$defs/recipe"}, "nulls": {"const": "preserve"}, "invalid": {"const": "abort"}, "recovery": {"$ref": "#/$defs/recovery"}
      }, "required": ["table", "field", "recipe", "nulls", "invalid", "recovery"], "additionalProperties": false
    },
    "recipe": {
      "oneOf": [
        {"$ref": "#/$defs/recipeEmpty"},
        {"type": "object", "properties": {"version": {"const": "umf.conversion-recipe/0.1"}, "kind": {"const": "numeric-rescale"}, "parameters": {"type": "object", "properties": {"rounding": {"enum": ["half-even", "toward-zero"]}}, "required": ["rounding"], "additionalProperties": false}}, "required": ["version", "kind", "parameters"], "additionalProperties": false},
        {"type": "object", "properties": {"version": {"const": "umf.conversion-recipe/0.1"}, "kind": {"const": "date-instant"}, "parameters": {"type": "object", "properties": {"at": {"const": "00:00:00"}, "offset": {"const": "Z"}}, "required": ["at", "offset"], "additionalProperties": false}}, "required": ["version", "kind", "parameters"], "additionalProperties": false},
        {"type": "object", "properties": {"version": {"const": "umf.conversion-recipe/0.1"}, "kind": {"const": "instant-date"}, "parameters": {"type": "object", "properties": {"time": {"enum": ["require-midnight", "discard"]}, "offset": {"const": "Z"}}, "required": ["time", "offset"], "additionalProperties": false}}, "required": ["version", "kind", "parameters"], "additionalProperties": false},
        {"type": "object", "properties": {"version": {"const": "umf.conversion-recipe/0.1"}, "kind": {"enum": ["text-boolean", "boolean-text"]}, "parameters": {"type": "object", "properties": {"trueToken": {"type": "string", "minLength": 1, "maxLength": 128}, "falseToken": {"type": "string", "minLength": 1, "maxLength": 128}}, "required": ["trueToken", "falseToken"], "additionalProperties": false}}, "required": ["version", "kind", "parameters"], "additionalProperties": false}
      ]
    },
    "recipeEmpty": {
      "type": "object", "properties": {"version": {"const": "umf.conversion-recipe/0.1"}, "kind": {"enum": ["numeric-exact", "text-date", "date-text", "text-instant", "instant-text", "text-uuid", "uuid-text"]}, "parameters": {"type": "object", "maxProperties": 0}},
      "required": ["version", "kind", "parameters"], "additionalProperties": false
    },
    "recovery": {
      "oneOf": [
        {"type": "object", "properties": {"mode": {"const": "irreversible"}, "reviewMarker": {"type": "string", "minLength": 1, "maxLength": 128}}, "required": ["mode", "reviewMarker"], "additionalProperties": false},
        {"type": "object", "properties": {"mode": {"const": "retained-originals"}, "policy": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "revision": {"type": "string", "minLength": 1, "maxLength": 256}}, "required": ["id", "revision"], "additionalProperties": false}}, "required": ["mode", "policy"], "additionalProperties": false},
        {"type": "object", "properties": {"mode": {"const": "round-trip"}, "proofProfile": {"const": "umf.exact-integer-widening-roundtrip/0.1"}}, "required": ["mode", "proofProfile"], "additionalProperties": false}
      ]
    },
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
