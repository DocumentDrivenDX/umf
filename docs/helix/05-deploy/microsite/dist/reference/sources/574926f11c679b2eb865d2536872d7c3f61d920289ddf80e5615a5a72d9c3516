{
  "id": "umf.semantic-types",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "Exact external semantic term references; meanings and value validators remain vocabulary-owned",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:semantic-types:0.1.0",
    "title": "Versioned semantic type annotations",
    "type": "object",
    "required": [
      "types"
    ],
    "properties": {
      "types": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "$defs": {
      "reference": {
        "type": "object",
        "required": [
          "vocabulary",
          "version",
          "term"
        ],
        "properties": {
          "vocabulary": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "term": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "semantics": "docs/helix/02-design/contracts/CONTRACT-051-semantic-types.md",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [],
    "evidence": [
      "tests/semantic-types/semantic-types.test.ts",
      "scripts/semantic-types-browser.ts"
    ]
  }
}
