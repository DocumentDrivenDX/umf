{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:iceberg:schema-json:0.1.0",
  "type": "object",
  "properties": {
    "type": {
      "const": "struct"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "schema-id": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "identifier-field-ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "uniqueItems": true
    }
  },
  "required": [
    "type",
    "fields"
  ],
  "additionalProperties": true,
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "doc": {
          "type": "string"
        },
        "initial-default": {},
        "write-default": {}
      },
      "required": [
        "id",
        "name",
        "required",
        "type"
      ],
      "additionalProperties": true
    },
    "type": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "struct"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "list"
            },
            "element-id": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "element-required": {
              "type": "boolean"
            },
            "element": {
              "$ref": "#/$defs/type"
            }
          },
          "required": [
            "type",
            "element-id",
            "element-required",
            "element"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "map"
            },
            "key-id": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "key": {
              "$ref": "#/$defs/type"
            },
            "value-id": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "value-required": {
              "type": "boolean"
            },
            "value": {
              "$ref": "#/$defs/type"
            }
          },
          "required": [
            "type",
            "key-id",
            "key",
            "value-id",
            "value-required",
            "value"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": [
                  "struct",
                  "list",
                  "map"
                ]
              }
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        }
      ]
    }
  }
}
