{
  "id": "umf.odcs",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "ODCS source contracts, native schema shapes and copied candidates",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:odcs:0.1.0",
    "type": "object",
    "properties": {
      "profile": {
        "const": "odcs-json-yaml"
      },
      "root": {
        "$ref": "#/$defs/node"
      },
      "originalSource": {
        "type": "string",
        "maxLength": 4000000
      },
      "originalFormat": {
        "enum": [
          "json",
          "yaml"
        ]
      }
    },
    "required": [
      "profile",
      "root",
      "originalSource",
      "originalFormat"
    ],
    "additionalProperties": true,
    "$defs": {
      "node": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "null"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "boolean"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "number"
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "items"
            ],
            "properties": {
              "kind": {
                "const": "array"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "members"
            ],
            "properties": {
              "kind": {
                "const": "object"
              },
              "members": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        ]
      }
    }
  },
  "semantics": "CONTRACT-023; preserve exact source and unknown values; native shape validity does not enforce a data contract",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "Open Data Contract Standard",
      "version": "3.0.0/3.0.1/3.0.2/3.1.0/3.2.0 schemas at f0bdad95346905d500be5ef4b2c2d9b1d95223b7",
      "subset": "JSON/YAML preservation and native shapes; local v3.2.0 reference/relationship checks and ID-selected rename candidates; no external resolution, quality/SLA execution or physical lowering"
    },
    "evidence": [
      "tests/odcs/odcs.test.ts",
      "fixtures/odcs/oracle-results.json",
      "fixtures/odcs/browser-results.json",
      "tests/odcs/references.test.ts",
      "tests/odcs/relationships.test.ts",
      "tests/odcs/rename.test.ts",
      "fixtures/odcs/rename/oracle-results.json",
      "fixtures/odcs/rename/browser-results.json"
    ]
  }
}
