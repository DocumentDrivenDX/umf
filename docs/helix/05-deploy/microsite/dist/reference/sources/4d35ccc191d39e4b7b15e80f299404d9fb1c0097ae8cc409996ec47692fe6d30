{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:parquet:levels:0.1.0",
  "type": "object",
  "required": [
    "source",
    "status",
    "complete",
    "diagnostics"
  ],
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "status": {
      "enum": [
        "decoded",
        "blocked"
      ]
    },
    "complete": {
      "const": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "rowGroup",
          "column",
          "offset",
          "repetition",
          "definition",
          "repetitionPadding",
          "definitionPadding",
          "valuesOffset",
          "nonNullValues",
          "rowStarts"
        ],
        "properties": {
          "rowGroup": {
            "type": "integer",
            "minimum": 0
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "repetition": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          },
          "definition": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          },
          "repetitionPadding": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          },
          "definitionPadding": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          },
          "valuesOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "nonNullValues": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "rowStarts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
