{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:delta-log:action-inspection:0.1.0",
  "type": "object",
  "required": [
    "source",
    "complete",
    "parsedAll",
    "lines",
    "diagnostics",
    "knownShapesValid"
  ],
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "complete": {
      "const": false
    },
    "parsedAll": {
      "type": "boolean"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line",
          "start",
          "end",
          "terminator",
          "status"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "terminator": {
            "enum": [
              "",
              "\n",
              "\r\n"
            ]
          },
          "status": {
            "enum": [
              "parsed",
              "blank",
              "invalid"
            ]
          },
          "action": {
            "type": "string"
          },
          "node": {
            "$ref": "#/$defs/node"
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "path",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "knownShapesValid": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  }
}
