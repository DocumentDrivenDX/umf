{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:table-migration:0.7",
  "title": "G04 source-bound checked field conversion plan",
  "type": "object",
  "properties": {
    "version": {"const": "umf.table-migration/0.7"},
    "canonicalization": {"const": "RFC8785"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "predecessor": {"$ref": "#/$defs/predecessor"},
    "previous": {"$ref": "urn:umf:table-deployment:0.1"},
    "next": {"$ref": "urn:umf:table-deployment:0.1"},
    "fromBundleDigest": {"$ref": "#/$defs/digest"},
    "toBundleDigest": {"$ref": "#/$defs/digest"},
    "steps": {"type": "array", "minItems": 2, "maxItems": 99999, "items": {"$ref": "#/$defs/conversionStep"}},
    "seedExecution": {"const": "none"},
    "phases": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/phase"}},
    "executionProfile": {"$ref": "#/$defs/executionProfile"},
    "approvalProfile": {"type": "object", "properties": {"version": {"const": "umf.table-migration-approval/0.1"}, "relation": {"const": "umf_lifecycle_approvals"}, "ownerOnly": {"const": true}}, "required": ["version", "relation", "ownerOnly"], "additionalProperties": false},
    "options": {"$ref": "urn:umf:table-migration-options:0.7"},
    "review": {"type": "array", "maxItems": 256, "items": {"type": "object", "properties": {"code": {"const": "IRREVERSIBLE_FIELD_CONVERSION"}, "path": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}, "required": ["code", "path", "message"], "additionalProperties": false}},
    "requiresApproval": {"const": true},
    "nativeQualified": {"const": false},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "required": ["version", "canonicalization", "id", "predecessor", "previous", "next", "fromBundleDigest", "toBundleDigest", "steps", "seedExecution", "phases", "executionProfile", "approvalProfile", "options", "review", "requiresApproval", "nativeQualified", "digest"],
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "predecessor": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "digest": {"$ref": "#/$defs/digest"}}, "required": ["id", "digest"], "additionalProperties": false},
    "ref": {"type": "object", "properties": {"module": {"type": "string", "minLength": 1}, "element": {"type": "string", "minLength": 1}}, "required": ["module", "element"], "additionalProperties": false},
    "conversionBinding": {"type": "object", "properties": {"profile": {"const": "umf.field-conversion-step/0.1"}, "selectionIndex": {"type": "integer", "minimum": 0, "maximum": 255}, "intentDigest": {"$ref": "#/$defs/digest"}, "beforeDomainDigest": {"$ref": "#/$defs/digest"}, "afterDomainDigest": {"$ref": "#/$defs/digest"}}, "required": ["profile", "selectionIndex", "intentDigest", "beforeDomainDigest", "afterDomainDigest"], "additionalProperties": false},
    "conversionStep": {"type": "object", "properties": {
      "id": {"type": "string", "pattern": "^step-[0-9]{5}$"}, "kind": {"const": "conversion"}, "sourcePath": {"type": "string", "minLength": 1}, "transaction": {"const": "required"}, "sql": {"const": ""},
      "preconditions": {"type": "object", "properties": {"phase": {"const": "before-plan"}, "kind": {"const": "installed-source-cohort"}, "bundleDigest": {"$ref": "#/$defs/digest"}}, "required": ["phase", "kind", "bundleDigest"], "additionalProperties": false},
      "expectedOutcome": {"type": "object", "properties": {"phase": {"const": "before-commit"}, "kind": {"const": "complete-next-source-catalog"}, "bundleDigest": {"$ref": "#/$defs/digest"}}, "required": ["phase", "kind", "bundleDigest"], "additionalProperties": false},
      "verification": {"const": "native-catalog-privileges-and-role-scope"}, "recovery": {"const": "rollback-transaction"},
      "operation": {"enum": ["capture-originals", "convert-field", "validate-conversion"]}, "phaseOperation": {"enum": ["capture-originals", "convert-field", "validate-conversion"]},
      "phaseTarget": {"type": "object", "properties": {"table": {"type": "string", "minLength": 1}, "field": {"$ref": "#/$defs/ref"}}, "required": ["table", "field"], "additionalProperties": false},
      "conversionBinding": {"$ref": "#/$defs/conversionBinding"}
    }, "required": ["id", "kind", "sourcePath", "transaction", "sql", "preconditions", "expectedOutcome", "verification", "recovery", "operation", "phaseOperation", "phaseTarget", "conversionBinding"], "additionalProperties": false,
      "oneOf": [
        {"properties": {"operation": {"const": "capture-originals"}, "phaseOperation": {"const": "capture-originals"}}},
        {"properties": {"operation": {"const": "convert-field"}, "phaseOperation": {"const": "convert-field"}}},
        {"properties": {"operation": {"const": "validate-conversion"}, "phaseOperation": {"const": "validate-conversion"}}}
      ]},
    "phase": {"type": "object", "properties": {"id": {"type": "string", "pattern": "^phase-[0-9]{5}$"}, "kind": {"const": "field-conversion"}, "transaction": {"const": "required"}, "steps": {"type": "array", "minItems": 2, "maxItems": 99999, "items": {"type": "string", "pattern": "^step-[0-9]{5}$"}}}, "required": ["id", "kind", "transaction", "steps"], "additionalProperties": false},
    "executionProfile": {"type": "object", "properties": {"version": {"const": "umf.table-migration-execution/0.6"}, "progressRelation": {"const": "umf_lifecycle_progress"}, "ownerOnly": {"const": true}, "ingressProfile": {"const": "umf.table-generation-ingress/0.1"}, "conversionProfile": {"const": "umf.checked-field-conversion/0.1"}, "originalsProfile": {"enum": ["umf.pg-row-originals/0.1", null]}}, "required": ["version", "progressRelation", "ownerOnly", "ingressProfile", "conversionProfile", "originalsProfile"], "additionalProperties": false}
  }
}
