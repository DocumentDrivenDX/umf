{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:sqlserver:physical-binding-projection:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "logical",
    "binding",
    "policy",
    "lossPolicy",
    "residuals",
    "mappings",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "project-binding-sqlserver"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "reported",
        "blocked"
      ]
    },
    "logical": {
      "$ref": "urn:umf:core:0.7.0"
    },
    "binding": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        },
        {
          "$ref": "urn:umf:core:0.7.0"
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "partitionFamilies"
      ],
      "properties": {
        "layout": {
          "$ref": "urn:umf:sqlserver:relationship-layout:1.0.0"
        },
        "partitionFamilies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "scheme",
              "column"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "scheme": {
                "type": "string"
              },
              "column": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "lossPolicy": {
      "enum": [
        "strict",
        "report"
      ]
    },
    "nativeSource": {
      "type": "string"
    },
    "nativeArchive": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        },
        {
          "$ref": "urn:umf:core:0.7.0"
        }
      ]
    },
    "candidate": {
      "type": "string"
    },
    "residuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "path",
          "reason",
          "value"
        ],
        "properties": {
          "source": {
            "enum": [
              "logical",
              "binding",
              "policy",
              "native"
            ]
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "value": {}
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourcePath",
          "target",
          "kind",
          "outcome"
        ],
        "properties": {
          "sourcePath": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "table",
              "column",
              "key",
              "relationship",
              "index"
            ]
          },
          "outcome": {
            "enum": [
              "approximated",
              "unknown"
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reported"
          }
        }
      },
      "then": {
        "required": [
          "candidate"
        ],
        "properties": {
          "lossPolicy": {
            "const": "report"
          }
        }
      },
      "else": {
        "properties": {
          "candidate": false
        }
      }
    },
    {
      "if": {
        "required": [
          "nativeSource"
        ]
      },
      "then": {
        "required": [
          "nativeArchive"
        ]
      },
      "else": {
        "properties": {
          "nativeArchive": false
        }
      }
    }
  ]
}
