{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:smithy:0.1.0",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "profile",
        "root"
      ],
      "properties": {
        "profile": {
          "const": "smithy-json-ast"
        },
        "root": {
          "$ref": "#/$defs/node"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "root"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "root": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "profile",
        "files"
      ],
      "properties": {
        "profile": {
          "const": "smithy-idl-sources"
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  ]
}
