{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:table-migration-discovery:0.4",
  "title": "G04 cycle-free checked-conversion discovery intent",
  "type": "object",
  "properties": {
    "version": {"const": "umf.table-migration-discovery/0.4"},
    "conversionIntents": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/intent"}}
  },
  "required": ["version", "conversionIntents"],
  "additionalProperties": false,
  "$defs": {
    "intent": {"type": "object", "properties": {"table": {"type": "string", "minLength": 1, "maxLength": 256}, "field": {"$ref": "urn:umf:table-migration-options:0.7#/$defs/ref"}, "recipe": {"$ref": "urn:umf:table-migration-options:0.7#/$defs/recipe"}, "nulls": {"const": "preserve"}, "invalid": {"const": "abort"}, "recovery": {"oneOf": [
      {"type": "object", "properties": {"mode": {"const": "irreversible"}}, "required": ["mode"], "additionalProperties": false},
      {"type": "object", "properties": {"mode": {"const": "retained-originals"}, "policy": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "revision": {"type": "string", "minLength": 1, "maxLength": 256}}, "required": ["id", "revision"], "additionalProperties": false}}, "required": ["mode", "policy"], "additionalProperties": false},
      {"type": "object", "properties": {"mode": {"const": "round-trip"}, "proofProfile": {"const": "umf.exact-integer-widening-roundtrip/0.1"}}, "required": ["mode", "proofProfile"], "additionalProperties": false}
    ]}}, "required": ["table", "field", "recipe", "nulls", "invalid", "recovery"], "additionalProperties": false}
  }
}
