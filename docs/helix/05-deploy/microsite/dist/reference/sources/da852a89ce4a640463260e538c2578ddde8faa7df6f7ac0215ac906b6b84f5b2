{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:avro-cardinality-classification:1.0.0",
  "title": "Avro schema Cardinality classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "source",
    "request",
    "binding",
    "mapping",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "classify-avro-cardinality"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "classified",
        "blocked"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.4.0"
    },
    "target": {
      "$ref": "urn:umf:core:0.4.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "nativeSource",
        "identity",
        "profile",
        "mode"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "nativeSource": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "schema"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "element"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "profile": {
          "enum": [
            "present-non-null-schema",
            "unresolved"
          ]
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.avro.cardinality",
        "version": "1.0.0",
        "nativeVersion": "1.12.0",
        "subset": "Declared shape of present non-null values; native union branches, availability, logical refinements and codec behavior remain separate"
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "cardinality",
        "outcome",
        "basis",
        "nodes"
      ],
      "properties": {
        "origin": {
          "const": "classified"
        },
        "cardinality": {
          "enum": [
            "one",
            "array",
            "map",
            "unspecified"
          ]
        },
        "outcome": {
          "enum": [
            "exact",
            "unknown",
            "not-expressible"
          ]
        },
        "basis": {
          "const": "Declared shape of present non-null values; native union branches, availability, logical refinements and codec behavior remain separate"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity",
              "location",
              "nativeFragment",
              "cardinality",
              "interpretation",
              "nativeAllowsNull",
              "definitions"
            ],
            "properties": {
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "module",
                  "element"
                ],
                "properties": {
                  "module": {
                    "type": "string",
                    "minLength": 1
                  },
                  "element": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "location": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "dependencyId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "nativeFragment": {
                "$ref": "urn:umf:native-json:0.1.0"
              },
              "cardinality": {
                "enum": [
                  "one",
                  "array",
                  "map",
                  "unspecified"
                ]
              },
              "interpretation": {
                "enum": [
                  "declared",
                  "unknown",
                  "unsupported"
                ]
              },
              "nativeAllowsNull": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "definitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "dependencyId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "reason",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "recovery": {
            "const": "Retain original native archive and author assertions; classification does not replace native meaning"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "target": true,
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target": false,
          "residuals": {
            "type": "array",
            "minItems": 1
          },
          "diagnostics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          },
          "request": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "strict"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "residuals": {
            "type": "array",
            "maxItems": 0
          },
          "mapping": {
            "type": "object",
            "properties": {
              "outcome": {
                "const": "exact"
              }
            }
          }
        }
      }
    }
  ]
}
