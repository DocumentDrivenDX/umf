        ],
        "native": {
          "subset": "Committed marketing campaign fixture and synthetic UTF-8 fixtures; untouched source-byte recovery only. No live Databricks acceptance, SQL execution or edited-source rewrite qualification.",
          "system": "Databricks AI/BI (Lakeview)",
          "version": "unversioned observed lvdash.json exports"
        },
        "validation": "semantic"
      },
      "coreVersion": "0.10.0",
      "description": "Lakeview dashboard composition with extension-defined kinds, explicit core Records/Fields, and byte-identical untouched UTF-8 source recovery",
      "id": "umf.lakeview",
      "kindCatalog": {
        "definitions": {
          "dashboard": {
            "description": "A native composition of pages, dataset/query declarations and layout items. Kind discovery certifies classification, not rendering or Databricks acceptance.",
            "scopes": [
              "document"
            ],
            "title": "Lakeview dashboard"
          },
          "data": {
            "description": "An identity container for native datasets and explicitly declared core data shapes; no table/storage equivalence is asserted.",
            "scopes": [
              "module"
            ],
            "title": "Lakeview data module"
          },
          "dataset": {
            "description": "A native query/dataset declaration on a core Record. Members are only explicit native column declarations, including context-dependent calculations; the row schema, grain and types remain unverified.",
            "scopes": [
              "element"
            ],
            "title": "Lakeview dataset"
          },
          "field": {
            "description": "A core Field for an explicit dataset column or query-output name. Its native source pointer defines provenance, not inferred type, nullability, storage or evaluation context.",
            "scopes": [
              "element"
            ],
            "title": "Lakeview named field"
          },
          "layout-item": {
            "description": "An opaque native widget/layout composition with references to named query-result Records. Widget, chart, filter and rendering semantics are not core meanings.",
            "scopes": [
              "element"
            ],
            "title": "Lakeview layout item"
          },
          "page": {
            "description": "An ordered native layout container, attached to a UMF module; native layout semantics remain Lakeview-owned.",
            "scopes": [
              "module"
            ],
            "title": "Lakeview page"
          },
          "query-result": {
            "description": "A core Record of explicitly named widget query outputs, with an exact dataset reference only when unambiguous. Expressions and aggregation remain opaque.",
            "scopes": [
              "element"
            ],
            "title": "Lakeview query result"
          }
        },
        "profile": "1.0.0"
      },
