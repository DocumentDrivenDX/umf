    "signatureText": [
      "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"urn:umf:openapi-dynamic-reference:0.1.0\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"source\",\n    \"target\",\n    \"node\",\n    \"complete\",\n    \"limitations\",\n    \"initialTarget\",\n    \"evaluationScope\",\n    \"resolution\"\n  ],\n  \"properties\": {\n    \"source\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"retrievalUri\",\n        \"pointer\",\n        \"baseUri\",\n        \"dialect\"\n      ],\n      \"properties\": {\n        \"retrievalUri\": {\n          \"type\": \"string\"\n        },\n        \"pointer\": {\n          \"type\": \"string\"\n        },\n        \"baseUri\": {\n          \"type\": \"string\"\n        },\n        \"dialect\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"target\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"retrievalUri\",\n        \"pointer\",\n        \"baseUri\",\n        \"dialect\"\n      ],\n      \"properties\": {\n        \"retrievalUri\": {\n          \"type\": \"string\"\n        },\n        \"pointer\": {\n          \"type\": \"string\"\n        },\n        \"baseUri\": {\n          \"type\": \"string\"\n        },\n        \"dialect\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"node\": {\n      \"$ref\": \"#/$defs/node\"\n    },\n    \"complete\": {\n      \"const\": false\n    },\n    \"limitations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1\n    },\n    \"initialTarget\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"retrievalUri\",\n        \"pointer\",\n        \"baseUri\",\n        \"dialect\"\n      ],\n      \"properties\": {\n        \"retrievalUri\": {\n          \"type\": \"string\"\n        },\n        \"pointer\": {\n          \"type\": \"string\"\n        },\n        \"baseUri\": {\n          \"type\": \"string\"\n        },\n        \"dialect\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"evaluationScope\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"maxItems\": 128,\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"resolution\": {\n      \"enum\": [\n        \"static\",\n        \"dynamic\"\n      ]\n    }\n  },\n  \"$defs\": {\n    \"node\": {\n      \"oneOf\": [\n        {\n          \"type\": \"object\",\n          \"required\": [\n            \"kind\"\n          ],\n          \"properties\": {\n            \"kind\": {\n              \"const\": \"null\"\n            }\n          }\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\n            \"kind\",\n            \"value\"\n          ],\n          \"properties\": {\n            \"kind\": {\n              \"const\": \"boolean\"\n            },\n            \"value\": {\n              \"type\": \"boolean\"\n            }\n          }\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\n            \"kind\",\n            \"value\"\n          ],\n          \"properties\": {\n            \"kind\": {\n              \"const\": \"string\"\n            },\n            \"value\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\n            \"kind\",\n            \"value\"\n          ],\n          \"properties\": {\n            \"kind\": {\n              \"const\": \"number\"\n            },\n            \"value\": {\n              \"type\": \"string\",\n              \"pattern\": \"^-?(0|[1-9][0-9]*)(\\\\.[0-9]+)?([eE][+-]?[0-9]+)?$\"\n            }\n          }\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\n            \"kind\",\n            \"items\"\n          ],\n          \"properties\": {\n            \"kind\": {\n              \"const\": \"array\"\n            },\n            \"items\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"$ref\": \"#/$defs/node\"\n              }\n            }\n          }\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\n            \"kind\",\n            \"members\"\n          ],\n          \"properties\": {\n            \"kind\": {\n              \"const\": \"object\"\n            },\n            \"members\": {\n              \"type\": \"object\",\n              \"additionalProperties\": {\n                \"$ref\": \"#/$defs/node\"\n              }\n            }\n          }\n        }\n      ]\n    }\n  }\n}\n"
