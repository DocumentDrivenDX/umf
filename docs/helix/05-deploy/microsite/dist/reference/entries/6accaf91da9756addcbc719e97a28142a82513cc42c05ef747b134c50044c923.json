              },
              "sort": {
                "properties": {
                  "by": {
                    "enum": [
                      "value-ascending",
                      "value-descending",
                      "label-ascending",
                      "label-descending",
                      "custom"
                    ]
                  },
                  "values": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "by"
