        "native": {
          "subset": "Native JSON tree preservation; semantic validation limited to known dialect/keywords and JavaScript-compatible numerics, format annotation-only; see CONTRACT-002 and evidence.",
          "system": "JSON Schema",
          "version": "2020-12"
        },
        "validation": "semantic"
      },
      "coreVersion": "0.1.0",
      "description": "JSON Schema Draft 2020-12 syntax, scoped validation, and lossless-number native interchange",
      "id": "umf.json-schema",
      "schema": {
        "$defs": {
          "node": {
            "oneOf": [
              {
                "properties": {
                  "kind": {
                    "const": "null"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "kind": {
                    "const": "boolean"
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "kind": {
                    "const": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "kind": {
                    "const": "number"
                  },
                  "value": {
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "items": {
                    "items": {
                      "$ref": "#/$defs/node"
                    },
                    "type": "array"
                  },
                  "kind": {
                    "const": "array"
                  }
                },
                "required": [
                  "kind",
                  "items"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "kind": {
                    "const": "object"
                  },
                  "members": {
                    "additionalProperties": {
                      "$ref": "#/$defs/node"
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "kind",
                  "members"
                ],
                "type": "object"
              }
            ]
          }
        },
        "$id": "urn:umf:json-schema:0.1.0",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "baseUri": {
            "minLength": 1,
            "type": "string"
          },
          "dialect": {
            "const": "https://json-schema.org/draft/2020-12/schema"
          },
          "resources": {
            "additionalProperties": {
              "$ref": "#/$defs/node"
            },
            "type": "object"
          },
          "root": {
            "$ref": "#/$defs/node"
          }
        },
        "required": [
          "dialect",
          "baseUri",
          "root",
          "resources"
        ],
        "type": "object"
      },
      "scopes": [
        "element"
