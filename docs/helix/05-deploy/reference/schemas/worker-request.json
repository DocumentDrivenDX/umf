{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "operationId": {
      "type": "string"
    },
    "coreProfile": {
      "type": "string"
    },
    "registryProfile": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000000
      }
    }
  },
  "required": [
    "protocol",
    "requestId",
    "operationId",
    "coreProfile",
    "registryProfile",
    "inputs"
  ],
  "additionalProperties": false
}
