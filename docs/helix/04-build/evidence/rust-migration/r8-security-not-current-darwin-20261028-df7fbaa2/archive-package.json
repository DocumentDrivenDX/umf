      "node": "./dist/umf-rust-codegen-candidate-v3-node.js",
      "import": "./dist/umf-rust-codegen-candidate-v3-browser.js"
    },
    "./rust-codegen-candidate/v4": {
      "types": "./dist/src/node-v4.d.ts",
      "browser": "./dist/umf-rust-codegen-candidate-v4-browser.js",
      "node": "./dist/umf-rust-codegen-candidate-v4-node.js",
      "import": "./dist/umf-rust-codegen-candidate-v4-browser.js"
    },
    "./loader-contract": {
