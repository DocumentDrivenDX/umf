      "id": "sol-final-via-context-null",
      "operation": "normalizeRowScope",
      "request": {
        "input": {
          "via": [
            {
              "table": "t",
              "person_column": "p",
              "key_column": "k"
            }
          ]
        },
        "context": {
          "ownerColumns": {},
          "via": null
        }
      },
      "expected": {
        "ok": false,
        "error": {
          "code": "ROW_SCOPE_FAILED",
          "message": "null is not an object (evaluating 'context.via.filter')"
        }
      }
    },
