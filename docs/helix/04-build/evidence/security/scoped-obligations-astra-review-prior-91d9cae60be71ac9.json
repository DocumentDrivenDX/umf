    "source": "\"\"\"Independent saved-formula replay of the explicitly conditional scoped model.\"\"\"\nimport hashlib,importlib.util,json,sys\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nROOT=Path('/Users/erik/.codex/worktrees/1598/umf');SELF=Path('/private/tmp/scoped-obligations-astra-review.py')\nif Path.cwd().resolve()!=ROOT or Path(__file__).resolve()!=SELF or len(sys.argv)!=1:raise RuntimeError('Unknown exact review invocation')\nPROOF=ROOT/'docs/helix/04-build/evidence/security/scoped-obligations-formal.json'\nSCRIPT=ROOT/'tools/security/prove-scoped-obligations.py'\nANNEX=ROOT/'docs/helix/02-design/spikes/security/scoped-obligation-matching-v0.2.md'\nRUST=Path('/Users/erik/Projects/weft/crates/weft-core/src/security_obligation_custody.rs')\nOUT=ROOT/'docs/helix/04-build/evidence/security/scoped-obligations-astra-review.json'\nsha=lambda b:hashlib.sha256(b).hexdigest()\nspec=importlib.util.find_spec('z3');assert spec and spec.origin\nsolver_root=Path(spec.origin).resolve().parent\npaths={SELF,PROOF,SCRIPT,ANNEX,RUST,Path(sys.executable).resolve()}\npaths.update(p for p in solver_root.rglob('*') if p.is_file() and '__pycache__' not in p.parts and p.suffix!='.pyc')\nfrozen={str(p):p.read_bytes() for p in sorted(paths)}\nprior=OUT.read_bytes() if OUT.exists() else None\nproof=json.loads(frozen[str(PROOF)])\nassert proof['sourceDigests']=={str(p):sha(frozen[str(p)]) for p in [SCRIPT,ANNEX,RUST]}\nassert proof['status']=='conditional-proof-passed' and proof['sourcesUnchanged'] is True\nassert proof['nativeImplementationQualified'] is False and proof['acceptanceCasesPromoted']==[]\nlaws=['paired-subjects-cannot-collapse-to-marginals','zero-edge-selection-keeps-independent-deployment-duty','unchosen-selected-origin-remains-mandatory','exact-atoms-do-not-substitute-full-contract','original-prerequisite-edges-cannot-be-removed','subject-variant-is-an-identity-coordinate','one-complete-capability-per-scope','correspondence-does-not-establish-release','zero-edge-profile-entry-is-independently-required','zero-edge-deployment-match-is-independently-required','unbounded-exact-relation-cannot-omit-required-atom','unbounded-exact-relation-cannot-add-surplus-atom']\nassert [c['id'] for c in proof['cases']]==laws\nimport z3\nrows=[]\nfor case in proof['cases']:\n for kind,expected in [('violation','unsat'),('negativeControl','sat'),('positivePopulation','sat')]:\n  q=case[kind];assert q['result']==expected and q['replayResult']==expected\n  ctx=z3.Context();solver=z3.Solver(ctx=ctx);solver.set(timeout=30000);solver.from_string(q['smt']);actual=str(solver.check())\n  if actual!=expected:raise RuntimeError(case['id']+'/'+kind+': '+actual)\n  rows.append({'id':case['id']+'/'+kind,'expected':expected,'observed':actual,'smtSha256':sha(q['smt'].encode()),'freshContext':True})\n  del solver,ctx\nif any(Path(p).read_bytes()!=b for p,b in frozen.items()):raise RuntimeError('Captured source/runtime changed')\nif (OUT.read_bytes() if OUT.exists() else None)!=prior:raise RuntimeError('Previous review changed')\nr={'id':'scoped-obligations-astra-review','status':'qualified-conditional-formal-review-passed','reviewer':'/root/astra_security_review','generatedAt':datetime.now(timezone.utc).isoformat(),'sourceDigests':{p:sha(b) for p,b in frozen.items()},'sourcesUnchanged':True,'reviewCommand':{'argv':[sys.executable,str(SELF)],'cwd':str(ROOT),'sourceSha256':sha(frozen[str(SELF)]),'source':frozen[str(SELF)].decode()},'formalReplay':{'receipt':str(PROOF),'sha256':sha(frozen[str(PROOF)]),'solverVersion':z3.get_version_string(),'formulaCount':len(rows),'observations':rows},'remainingFindings':[],'recommendedCoverage':[],'scope':'Independent replay of all thirty-six retained formulas in separate fresh Z3 contexts, plus read-only inspection of the actual producer and governing draft. Ten finite Boolean laws are conditional relation/guard sanity checks; positive cases force success and negative controls replace a specified guard/matcher. Two quantified laws establish the immediate no-omission/no-surplus consequences of assumed pointwise extensional equality on a typed atom relation. Their alternatives instantiate closed finite-support relations with two distinct origins and cases, preserve all five coordinate projections bidirectionally, and demonstrate required omission or surplus after the origin/case swap. The two new profile/deployment controls independently remove one conjunct with the other true; they apply to any selected capability, including zero-edge selections, without modeling the edge relation in those formulas. Required relation correctness, profile inventory completeness, arbitrary-size capability assignment, Rust/parser/matcher refinement, DAG correctness, physical enforcement and native qualification are not established. The producer was not rerun and no Rust tests, Cargo, or native acquisition occurred. Solver package and Python executable bytes are retained; system libraries and platform remain trusted execution premises. No theorem asserts independent profile completeness or backend admission.','nativeImplementationQualified':False,'acceptanceCasesPromoted':[],'acceptanceCriteria':['US-056-AC7','US-056-AC10']}\nif prior is not None:\n h=sha(prior);archive=OUT.with_name(OUT.stem+'-prior-'+h[:16]+'.json')\n if archive.exists() and archive.read_bytes()!=prior:raise RuntimeError('Archive collision')\n if not archive.exists():archive.write_bytes(prior)\n r['previousReceipt']={'path':str(archive),'sha256':h,'scope':'Historical only.'}\nOUT.write_text(json.dumps(r,indent=2)+'\\n')\nprint(json.dumps({'status':r['status'],'formulas':len(rows),'unsat':sum(x['observed']=='unsat' for x in rows),'sat':sum(x['observed']=='sat' for x in rows),'sourcePins':len(frozen),'sourcesUnchanged':True,'output':str(OUT),'sha256':sha(OUT.read_bytes())}))\n"
