{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:avro-relationship-classification:1.0.0",
  "title": "Avro Relationship classification and original native archive recovery",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "source",
    "request",
    "binding",
    "observations",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "classify-avro-relationships"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "classified",
        "blocked"
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        },
        {
          "$ref": "urn:umf:core:0.7.0"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        },
        {
          "$ref": "urn:umf:core:0.7.0"
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "profile",
        "nativeSource"
      ],
      "properties": {
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "profile": {
          "const": "schema-structure"
        },
        "nativeSource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "dependencies"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "schema"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "schema": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.avro.relationships",
        "version": "1.0.0",
        "nativeVersion": "1.12.0",
        "subset": "Structural observations informed by Apache Avro 1.12.0 and fastavro 1.12.2 discovery; no name resolution, native validity certification, authored association inference or native equivalence"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nativePath",
          "kind",
          "nativeNode",
          "nameResolution",
          "enforcement",
          "authorIntent",
          "provenance",
          "scope"
        ],
        "properties": {
          "nativePath": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "record",
              "named-type-token",
              "union",
              "array",
              "map"
            ]
          },
          "nativeNode": {
            "$ref": "#/$defs/node"
          },
          "nameResolution": {
            "const": "unverified"
          },
          "enforcement": {
            "const": "not-expressible"
          },
          "authorIntent": {
            "const": "unknown"
          },
          "provenance": {
            "const": "inferred"
          },
          "scope": {
            "const": "schema-structure"
          }
        }
      }
    },
    "residuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "outcome",
          "reason",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "outcome": {
            "const": "not-expressible"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "recovery": {
            "const": "Original native archive retained; no authored relationship inferred"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "report"
              }
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target": false,
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          }
        }
      }
    }
  ]
}
