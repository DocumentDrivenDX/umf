{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:record-sqlserver-projection:1.0.0",
  "title": "Authored record to SQL Server DDL",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "source",
    "author",
    "request",
    "binding",
    "residuals",
    "mappings",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "project-record-sqlserver"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "projected",
        "blocked"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.2.0"
    },
    "author": {
      "$ref": "urn:umf:core:kind-operation:1.0.0#/$defs/declaration"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sql"
      ],
      "properties": {
        "format": {
          "const": "sqlserver-ddl"
        },
        "sql": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tableName",
        "mode",
        "fields",
        "namespace",
        "identifierCollation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tableName": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "author",
              "columnName",
              "nativeType"
            ],
            "properties": {
              "author": {
                "$ref": "urn:umf:core:kind-operation:1.0.0#/$defs/declaration"
              },
              "columnName": {
                "type": "string",
                "minLength": 1
              },
              "nativeType": {
                "enum": [
                  "bit",
                  "tinyint",
                  "smallint",
                  "int",
                  "bigint",
                  "decimal(38,9)",
                  "real",
                  "float(53)",
                  "nvarchar(max)",
                  "varbinary(max)",
                  "date",
                  "time(7)",
                  "datetime2(7)",
                  "datetimeoffset(7)"
                ]
              }
            }
          }
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "identifierCollation": {
          "const": "Latin1_General_100_BIN2"
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.core.record.sqlserver",
        "version": "1.0.0",
        "nativeVersion": "16.0.4295.3",
        "subset": "Authored flat record with explicit builtin nullable carriers; requires database identifier collation Latin1_General_100_BIN2; no value-domain equivalence"
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "reason",
          "outcome",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "unknown",
              "not-expressible"
            ]
          },
          "recovery": {
            "const": "Recover source meaning with retained projection receipt; native-only import does not recover author intent"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin",
          "kind",
          "idealPath",
          "nativePath",
          "outcome"
        ],
        "properties": {
          "origin": {
            "const": "authored"
          },
          "kind": {
            "enum": [
              "record",
              "field"
            ]
          },
          "idealPath": {
            "type": "string"
          },
          "nativePath": {
            "const": "/sql"
          },
          "outcome": {
            "enum": [
              "exact",
              "unknown",
              "not-expressible"
            ]
          }
        }
      }
    },
    "nativeSql": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "nativeSql"
        ],
        "properties": {
          "target": true,
          "nativeSql": true
        }
      },
      "else": {
        "properties": {
          "target": false,
          "nativeSql": false
        }
      }
    },
    {
      "$comment": "UMF projection policy",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "warning"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              },
              "diagnostics": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "request": {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "strict"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "maxItems": 0
              },
              "mappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "const": "exact"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "mappings": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "enum": [
                        "unknown",
                        "approximated",
                        "not-expressible"
                      ]
                    }
                  },
                  "required": [
                    "outcome"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
