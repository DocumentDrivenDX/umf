{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:record-avro-projection:1.0.0",
  "title": "Authored record to explicit Avro record fields",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "source",
    "author",
    "request",
    "binding",
    "residuals",
    "mappings",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "project-record-avro"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "projected",
        "blocked"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.2.0"
    },
    "author": {
      "$ref": "urn:umf:core:kind-operation:1.0.0#/$defs/declaration"
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recordName",
        "namespace",
        "mode",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "author",
              "fieldName",
              "nativeType"
            ],
            "properties": {
              "author": {
                "$ref": "urn:umf:core:kind-operation:1.0.0#/$defs/declaration"
              },
              "nativeType": {
                "enum": [
                  "null",
                  "boolean",
                  "int",
                  "long",
                  "float",
                  "double",
                  "bytes",
                  "string",
                  "date",
                  "time-millis",
                  "time-micros",
                  "timestamp-millis",
                  "timestamp-micros",
                  "local-timestamp-micros",
                  "decimal(38,9)"
                ]
              },
              "fieldName": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
              }
            }
          }
        },
        "recordName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "namespace": {
          "type": "string",
          "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)?(?![\\s\\S])"
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.core.record.avro",
        "version": "1.0.0",
        "nativeVersion": "1.12.0",
        "subset": "Authored flat record with explicit primitive/logical field carriers; no presence, execution or value-domain equivalence"
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "reason",
          "outcome",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "unknown",
              "not-expressible"
            ]
          },
          "recovery": {
            "const": "Recover source meaning with retained projection receipt; native-only import does not recover author intent"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin",
          "kind",
          "idealPath",
          "nativePath",
          "outcome"
        ],
        "properties": {
          "origin": {
            "const": "authored"
          },
          "kind": {
            "enum": [
              "record",
              "field"
            ]
          },
          "idealPath": {
            "type": "string"
          },
          "nativePath": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "exact",
              "unknown",
              "not-expressible"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "target": true
        }
      },
      "else": {
        "properties": {
          "target": false
        }
      }
    },
    {
      "$comment": "UMF projection policy",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "warning"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              },
              "diagnostics": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "request": {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "strict"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "maxItems": 0
              },
              "mappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "const": "exact"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "mappings": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "enum": [
                        "unknown",
                        "approximated",
                        "not-expressible"
                      ]
                    }
                  },
                  "required": [
                    "outcome"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
