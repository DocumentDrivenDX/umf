{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:key-parquet-projection:1.0.0",
  "title": "Explicit authored Key projection to Parquet declarations with retained ideal recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "source",
    "authors",
    "request",
    "binding",
    "mappings",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "project-keys-parquet"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "projected",
        "blocked"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.6.0"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:umf:core:key-operation:1.0.0#/$defs/declaration"
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record",
        "recordName",
        "mode",
        "columns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "element"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "recordName": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "name",
              "carrier"
            ],
            "properties": {
              "field": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "module",
                  "element"
                ],
                "properties": {
                  "module": {
                    "type": "string",
                    "minLength": 1
                  },
                  "element": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "carrier": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "nativeType"
                    ],
                    "properties": {
                      "kind": {
                        "const": "primitive"
                      },
                      "nativeType": {
                        "enum": [
                          "boolean",
                          "int32",
                          "int64",
                          "float32",
                          "float64",
                          "binary",
                          "string",
                          "date",
                          "time-millis",
                          "time-micros",
                          "timestamp-millis-utc",
                          "timestamp-micros-utc"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "bits",
                      "signed"
                    ],
                    "properties": {
                      "kind": {
                        "const": "integer"
                      },
                      "bits": {
                        "enum": [
                          8,
                          16,
                          32,
                          64
                        ]
                      },
                      "signed": {
                        "type": "boolean"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "bytes"
                    ],
                    "properties": {
                      "kind": {
                        "const": "fixed"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "carrier",
                      "precision",
                      "scale"
                    ],
                    "properties": {
                      "kind": {
                        "const": "decimal"
                      },
                      "carrier": {
                        "enum": [
                          "int32",
                          "int64",
                          "bytes",
                          "fixed"
                        ]
                      },
                      "precision": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "scale": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "carrier": {
                              "const": "fixed"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "bytes"
                          ],
                          "properties": {
                            "bytes": true
                          }
                        },
                        "else": {
                          "properties": {
                            "bytes": false
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "fieldId": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            }
          }
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.parquet.keys",
        "version": "1.0.0",
        "nativeVersion": "PyArrow 21.0.0 / parquet-format 219e3f12a62f9476e830c21e26d030d231f7c017",
        "subset": "Authored required singular scalar Record Fields projected to an empty file with explicit Parquet carriers; no native collection uniqueness, key identity or exact input conversion; per-key residual recovery is required"
      }
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "keyName",
          "idealPath",
          "nativePaths",
          "columns",
          "primary",
          "origin",
          "enforcement",
          "outcome"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "minLength": 1
          },
          "keyName": {
            "type": "string",
            "minLength": 1
          },
          "idealPath": {
            "type": "string",
            "minLength": 1
          },
          "nativePaths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "primary": {
            "type": "boolean"
          },
          "origin": {
            "const": "authored"
          },
          "enforcement": {
            "const": "not-expressible"
          },
          "outcome": {
            "const": "not-expressible"
          }
        }
      }
    },
    "residuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "reason",
          "outcome",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "unknown",
              "not-expressible"
            ]
          },
          "recovery": {
            "const": "Recover authored source from retained receipt; native import alone does not recover authored identity"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "report"
              }
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target": false,
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          }
        }
      }
    }
  ]
}
