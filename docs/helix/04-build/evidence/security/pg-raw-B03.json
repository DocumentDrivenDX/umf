        ],
        "acl": "{umf_sec_guardian=X/umf_sec_guardian,umf_sec_alice=X/umf_sec_guardian,umf_sec_bob=X/umf_sec_guardian,umf_sec_outsider=X/umf_sec_guardian}",
        "definition": "CREATE OR REPLACE FUNCTION security_raw.allowed(resource_id text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$\n SELECT EXISTS(SELECT 1 FROM security_raw.m2m_resource_project o\n JOIN security_raw.m2m_employee_project a ON a.project_id=o.project_id\n JOIN security_raw.employee e ON e.id=a.employee_id\n WHERE o.resource_id=$1 AND a.active AND e.native_login=session_user::text)\n$function$\n"
      },
      {
        "name": "note_cell",
        "identity": "bag jsonb",
        "owner": "umf_sec_guardian",
        "definer": false,
        "settings": [
          "search_path=pg_catalog"
