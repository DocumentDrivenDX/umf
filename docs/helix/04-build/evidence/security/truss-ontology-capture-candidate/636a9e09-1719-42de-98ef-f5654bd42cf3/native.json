      "{\"search_path=pg_catalog, pg_temp\"}",
      "CREATE OR REPLACE FUNCTION protected_capture.capture()\n RETURNS TABLE(database_oid oid, backend_pid integer, xid xid8, person_oid oid, actor_oid oid)\n LANGUAGE sql\n SET search_path TO 'pg_catalog', 'pg_temp'\nAS $function$ SELECT (SELECT oid FROM pg_database WHERE datname=current_database()),pg_backend_pid(),pg_current_xact_id(),\n(SELECT oid FROM pg_roles WHERE rolname=session_user),(SELECT oid FROM pg_roles WHERE rolname=current_user) $function$\n"
    ],
