  "nativeViews": [
    {
      "name": "salary_public",
      "owner": "umf_sec_guardian",
      "acl": "{umf_sec_guardian=arwdDxtm/umf_sec_guardian,umf_sec_alice=r/umf_sec_guardian,umf_sec_bob=r/umf_sec_guardian,umf_sec_outsider=r/umf_sec_guardian}",
      "options": [
        "security_barrier=true"
      ],
      "definition": " SELECT id,\n    'restricted'::text AS salary_display\n   FROM security_raw.resource r;"
    },
    {
      "name": "salary_query",
      "owner": "umf_sec_guardian",
      "acl": "{umf_sec_guardian=arwdDxtm/umf_sec_guardian,umf_sec_alice=r/umf_sec_guardian}",
      "options": [
        "security_barrier=true"
      ],
      "definition": " SELECT r.id,\n    ((p.bag ->> 'salary'::text))::numeric AS salary\n   FROM (security_raw.resource r\n     JOIN security_raw.resource_private_carrier p ON ((p.resource_id = r.id)));"
    },
    {
      "name": "salary_weak",
      "owner": "umf_sec_guardian",
      "acl": "{umf_sec_guardian=arwdDxtm/umf_sec_guardian,umf_sec_alice=r/umf_sec_guardian,umf_sec_bob=r/umf_sec_guardian,umf_sec_outsider=r/umf_sec_guardian}",
      "options": [
        "security_barrier=true"
      ],
      "definition": " SELECT r.id,\n    'restricted'::text AS salary_display\n   FROM (security_raw.resource r\n     JOIN security_raw.resource_private_carrier p ON ((p.resource_id = r.id)))\n  WHERE (((p.bag ->> 'salary'::text))::numeric >= (200)::numeric);"
    }
  ],
  "scope": "PostgreSQL 17.9 fixed raw-table stable-cut fixture. Output-only masking with a pre-mask predicate leaks hidden-value selection. A public surface without the protected column refuses original-field query operations, while a separate Alice-only native privilege surface supports filter/order/group/join/aggregate with authored vectors. This is not a compiler binding, complete query lineage, protected-field transformation algebra, source authority or production backend B08 qualification."
