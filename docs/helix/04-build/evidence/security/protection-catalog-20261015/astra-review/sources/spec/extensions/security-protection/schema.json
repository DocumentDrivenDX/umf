{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:security-protection:0.1.0:envelope",
  "title": "Protection catalog envelope and transform identity scaffold only",
  "description": "Structural envelope only. Payload members are preserved, not interpreted; this schema never establishes a usable transform.",
  "type": "object",
  "properties": {
    "vocabulary": {
      "const": "umf.security.protection"
    },
    "version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "transforms": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": true
      }
    },
    "native": {}
  },
  "required": [
    "vocabulary",
    "version",
    "id",
    "revision",
    "transforms"
  ],
  "additionalProperties": true
}
