{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:relationship-operation:2.0.0",
  "title": "Read-only original0.8 relationship inspection and lookup",
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "module"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lookupIdentity": {
      "type": "object",
      "required": [
        "module",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source",
        "target",
        "sourceMultiplicity",
        "targetMultiplicity",
        "targetLifecycle",
        "directed"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "module",
              "element"
            ],
            "additionalProperties": false,
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "element": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "target": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "module",
              "element",
              "key"
            ],
            "additionalProperties": false,
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "element": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sourceMultiplicity": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "const": "*"
                }
              ]
            }
          }
        },
        "targetMultiplicity": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "const": "*"
                }
              ]
            }
          }
        },
        "targetLifecycle": {
          "enum": [
            "owned",
            "independent",
            "unspecified"
          ]
        },
        "directed": {
          "type": "boolean"
        },
        "inverse": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "associationRecord": {
          "type": "object",
          "required": [
            "module",
            "element"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "inspection": {
      "type": "object",
      "required": [
        "operation",
        "version",
        "source",
        "identity",
        "path",
        "meaning",
        "provenance",
        "diagnostics",
        "residuals"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "inspect-core-relationships"
        },
        "version": {
          "const": "2.0.0"
        },
        "source": {
          "$ref": "urn:umf:core:0.8.0"
        },
        "identity": {
          "type": "object",
          "required": [
            "module"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "path": {
          "type": "string"
        },
        "provenance": {
          "const": "unverified"
        },
        "meaning": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "state"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "missing"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "relationships",
                "uninterpretedPaths"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "known"
                },
                "relationships": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:umf:core:0.8.0#/$defs/relationship"
                  }
                },
                "uninterpretedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 0
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "relationships",
                "uninterpretedPaths"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "partial"
                },
                "relationships": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:umf:core:0.8.0#/$defs/relationship"
                  }
                },
                "uninterpretedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "path",
              "message",
              "severity"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              }
            }
          }
        },
        "residuals": {
          "type": "array",
          "maxItems": 0,
          "description": "Core authoring and read operations retain the complete source without projection loss; native binding residuals are separate."
        }
      }
    },
    "lookup": {
      "type": "object",
      "required": [
        "operation",
        "version",
        "source",
        "identity",
        "path",
        "relationship",
        "uninterpretedPaths",
        "provenance",
        "diagnostics",
        "residuals"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "lookup-core-relationship"
        },
        "version": {
          "const": "2.0.0"
        },
        "source": {
          "$ref": "urn:umf:core:0.8.0"
        },
        "identity": {
          "type": "object",
          "required": [
            "module",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "path": {
          "type": "string"
        },
        "relationship": {
          "$ref": "urn:umf:core:0.8.0#/$defs/relationship"
        },
        "uninterpretedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "const": "unverified"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "path",
              "message",
              "severity"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              }
            }
          }
        },
        "residuals": {
          "type": "array",
          "maxItems": 0,
          "description": "Core authoring and read operations retain the complete source without projection loss; native binding residuals are separate."
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/inspection"
    },
    {
      "$ref": "#/$defs/lookup"
    }
  ],
  "description": "Structure only. Verify retained operation and current context by recomputation; do not infer native enforcement or authenticated authorship."
}
