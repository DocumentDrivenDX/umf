    "views": [
      {
        "name": "resource_disclosure",
        "definition": " SELECT r.id,\n    jsonb_build_array(jsonb_build_object('field', '{\"moduleId\": \"m\", \"elementId\": \"resourceId\", \"documentId\": \"domain\"}'::jsonb, 'disposition', 'original', 'value', jsonb_build_object('string', r.id)), security_raw.note_cell(p.bag),\n        CASE\n            WHEN (r.id = 'RAB'::text) THEN jsonb_build_object('field', '{\"moduleId\": \"m\", \"elementId\": \"salary\", \"documentId\": \"domain\"}'::jsonb, 'disposition', 'transformed', 'outputType', '{\"moduleId\": \"m\", \"elementId\": \"resourceId\", \"documentId\": \"domain\"}'::jsonb, 'value', jsonb_build_object('string', 'restricted'))\n            ELSE jsonb_build_object('field', '{\"moduleId\": \"m\", \"elementId\": \"salary\", \"documentId\": \"domain\"}'::jsonb, 'disposition', 'withheld')\n        END) AS cells\n   FROM (security_raw.resource r\n     LEFT JOIN security_raw.resource_private_carrier p ON ((p.resource_id = r.id)));",
        "settings": [
          "security_barrier=true"
        ]
      },
      {
        "name": "resource_project",
        "definition": " SELECT r.id AS resource_id,\n    o.project_id\n   FROM (((security_raw.resource r\n     JOIN security_raw.m2m_resource_project o ON ((o.resource_id = r.id)))\n     JOIN security_raw.m2m_employee_project a ON (((a.project_id = o.project_id) AND a.active)))\n     JOIN security_raw.employee e ON ((e.id = a.employee_id)))\n  WHERE (e.native_login = (SESSION_USER)::text);",
        "settings": [
          "security_barrier=true"
        ]
      }
    ],
