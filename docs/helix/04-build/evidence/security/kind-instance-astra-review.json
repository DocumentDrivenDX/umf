    "source": "\"\"\"Independent saved-SMT review; never executes a producer, Cargo or native code.\"\"\"\nimport hashlib, importlib.util, json, sys\nfrom pathlib import Path\nfrom datetime import datetime, timezone\n\nROOT = Path('/Users/erik/.codex/worktrees/1598/umf')\nOWNER = Path('/Users/erik/Projects/weft')\nSELF = Path('/private/tmp/kind-instance-astra-review.py')\nif Path.cwd().resolve() != ROOT or Path(__file__).resolve() != SELF or len(sys.argv) != 1:\n    raise RuntimeError('Unknown exact review invocation')\nBASE = ROOT / 'docs/helix/04-build/evidence/security'\nOUT = BASE / 'kind-instance-astra-review.json'\nsha = lambda b: hashlib.sha256(b).hexdigest()\ngroups = [\n    ('kind-completeness-formal', [\n        'same-source-kinds-cannot-fragment-across-origins',\n        'different-scopes-may-use-different-instance-complete-origins',\n        'instance-completeness-cannot-discharge-native-evidence',\n    ], [ROOT / 'tools/security/prove-kind-completeness.py',\n        ROOT / 'docs/helix/02-design/spikes/security/backend-requirement-issuer-v0.2.md',\n        OWNER / 'crates/weft-core/src/security_obligation_matching.rs']),\n    ('source-demands-formal', [\n        'whole-capability-before-source-quantifier',\n        'different-scopes-may-use-different-complete-capabilities',\n        'original-use-needs-primary-original-and-application',\n        'equal-marginals-cannot-substitute-scoped-edges',\n        'source-correspondence-cannot-discharge-native-execution',\n    ], [ROOT / 'tools/security/prove-source-demands.py',\n        ROOT / 'docs/helix/02-design/spikes/security/source-demand-binding-v0.1.md',\n        OWNER / 'crates/weft-core/src/security_obligation_sources.rs',\n        OWNER / 'crates/weft-core/src/security_semantic_coverage.rs']),\n    ('scoped-obligations-formal', [\n        'paired-subjects-cannot-collapse-to-marginals',\n        'zero-edge-selection-keeps-independent-deployment-duty',\n        'unchosen-selected-origin-remains-mandatory',\n        'exact-atoms-do-not-substitute-full-contract',\n        'original-prerequisite-edges-cannot-be-removed',\n        'subject-variant-is-an-identity-coordinate',\n        'one-complete-capability-per-scope',\n        'correspondence-does-not-establish-release',\n        'zero-edge-profile-entry-is-independently-required',\n        'zero-edge-deployment-match-is-independently-required',\n        'unbounded-exact-relation-cannot-omit-required-atom',\n        'unbounded-exact-relation-cannot-add-surplus-atom',\n    ], [ROOT / 'tools/security/prove-scoped-obligations.py',\n        ROOT / 'docs/helix/02-design/spikes/security/scoped-obligation-matching-v0.2.md',\n        OWNER / 'crates/weft-core/src/security_obligation_custody.rs']),\n]\nspec = importlib.util.find_spec('z3')\nassert spec and spec.origin\nsolver_root = Path(spec.origin).resolve().parent\ndef solver_files():\n    return {p for p in solver_root.rglob('*') if p.is_file() and '__pycache__' not in p.parts and p.suffix != '.pyc'}\nruntime_paths = solver_files()\npaths = {SELF, Path(sys.executable).resolve(), *runtime_paths}\nfor name, laws, source_paths in groups:\n    paths.add(BASE / (name + '.json'))\n    paths.update(source_paths)\nfrozen = {str(p): p.read_bytes() for p in sorted(paths)}\nprior = OUT.read_bytes() if OUT.exists() else None\n# Existing individual reviews remain historical and are never rewritten here.\nhistorical_paths = [BASE / 'kind-completeness-astra-review.json', BASE / 'scoped-obligations-astra-review.json']\nhistorical = {str(p): p.read_bytes() for p in historical_paths if p.exists()}\nimport z3\nassert z3.get_version_string() == '4.15.4'\nobservations, receipt_audits = [], []\nfor name, laws, source_paths in groups:\n    path = BASE / (name + '.json')\n    raw = frozen[str(path)]\n    proof = json.loads(raw)\n    expected_pins = {str(p): sha(frozen[str(p)]) for p in source_paths}\n    assert proof['sourceDigests'] == expected_pins, name + ': source inventory/digest mismatch'\n    assert proof['status'] == 'conditional-proof-passed' and proof['sourcesUnchanged'] is True\n    assert proof['nativeImplementationQualified'] is False and proof['acceptanceCasesPromoted'] == []\n    assert proof['solverVersion'] == '4.15.4'\n    assert [c['id'] for c in proof['cases']] == laws\n    for case in proof['cases']:\n        assert case['covers'] == ['US-056-AC7', 'US-056-AC10']\n        for kind, expected in [('violation', 'unsat'), ('negativeControl', 'sat'), ('positivePopulation', 'sat')]:\n            query = case[kind]\n            assert query['result'] == expected and query['replayResult'] == expected\n            ctx = z3.Context()\n            solver = z3.Solver(ctx=ctx)\n            solver.set(timeout=30000)\n            solver.from_string(query['smt'])\n            observed = str(solver.check())\n            if observed != expected:\n                raise RuntimeError(name + '/' + case['id'] + '/' + kind + ': ' + observed)\n            observations.append({'id': name + '/' + case['id'] + '/' + kind,\n                'receipt': name, 'law': case['id'], 'queryKind': kind,\n                'expected': expected, 'observed': observed,\n                'smtSha256': sha(query['smt'].encode()), 'freshContext': True})\n            del solver, ctx\n    receipt_audits.append({'path': str(path), 'sha256': sha(raw),\n        'lawCount': len(laws), 'formulaCount': len(laws) * 3,\n        'sourcePinCount': len(source_paths), 'sourceDigests': expected_pins,\n        'exactSourceInventoryMatched': True, 'allFormulaOutcomesMatched': True})\nassert len(observations) == 60 and len({o['id'] for o in observations}) == 60\nassert solver_files() == runtime_paths\nif any(Path(p).read_bytes() != data for p, data in frozen.items()):\n    raise RuntimeError('Captured input/runtime changed')\nif any(Path(p).read_bytes() != data for p, data in historical.items()):\n    raise RuntimeError('Historical review changed')\nif (OUT.read_bytes() if OUT.exists() else None) != prior:\n    raise RuntimeError('Previous combined review changed')\nreceipt = {\n    'id': 'kind-instance-astra-review',\n    'status': 'qualified-conditional-formal-review-passed',\n    'reviewer': '/root/astra_security_review',\n    'generatedAt': datetime.now(timezone.utc).isoformat(),\n    'sourceDigests': {p: sha(data) for p, data in frozen.items()}, 'sourcesUnchanged': True,\n    'reviewCommand': {'argv': [sys.executable, str(SELF)], 'cwd': str(ROOT),\n        'sourceSha256': sha(frozen[str(SELF)]), 'source': frozen[str(SELF)].decode()},\n    'formalReplay': {'solverVersion': z3.get_version_string(), 'formulaCount': 60,\n        'unsatCount': 20, 'satCount': 40, 'receipts': receipt_audits, 'observations': observations},\n    'remainingFindings': [],\n    'historicalReviews': [{'path': p, 'sha256': sha(data), 'preservedUnchanged': True,\n        'scope': 'Historical only; no pin refresh or freshness assertion.'} for p, data in historical.items()],\n    'scope': 'Independent replay of all60 retained formulas in fresh Z3 contexts:9 kind-completeness,15 source-demand and36 scoped-obligation formulas. Exact closed law identities, expected outcomes, source-path sets and current source bytes were checked for each proof receipt. Eighteen laws are finite conditional Boolean composition/guard models; two scoped laws state no-omission/no-addition under assumed pointwise extensional equality over an unbounded typed atom relation. Nonempty SAT witnesses and explicit weakened controls remain distinct from the UNSAT checks. The source-level and instance-level Rust modules are pinned lineage only; this does not prove typed owner extraction, independently complete kind/occurrence or case inventories, profile authentication, arbitrary-size capability assignment, Rust/parser/DAG refinement or native execution. No producer, Cargo or native fixture was executed. Python executable and selected complete Z3 package file inventory are pinned; dynamic system libraries/platform are trusted premises. No backend acceptance or release authority is established.',\n    'nativeImplementationQualified': False, 'acceptanceCasesPromoted': [],\n    'acceptanceCriteria': ['US-056-AC7', 'US-056-AC10'],\n}\nassert sum(o['observed'] == 'unsat' for o in observations) == 20\nassert sum(o['observed'] == 'sat' for o in observations) == 40\nif prior is not None:\n    h = sha(prior)\n    archive = OUT.with_name(OUT.stem + '-prior-' + h[:16] + '.json')\n    if archive.exists() and archive.read_bytes() != prior:\n        raise RuntimeError('Archive collision')\n    if not archive.exists():\n        archive.write_bytes(prior)\n    receipt['previousReceipt'] = {'path': str(archive), 'sha256': h, 'scope': 'Historical only.'}\nOUT.write_text(json.dumps(receipt, indent=2) + '\\n')\nprint(json.dumps({'status': receipt['status'], 'formulaCount': 60, 'unsat': 20, 'sat': 40,\n    'groups': [9, 15, 36], 'sourcePins': len(frozen), 'sourcesUnchanged': True,\n    'output': str(OUT), 'sha256': sha(OUT.read_bytes())}))\n"
  },
