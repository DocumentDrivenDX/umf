{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:facets-postgresql-projection:1.0.0",
  "title": "Authored scalar facets to PostgreSQL carriers and CHECKs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "source",
    "author",
    "request",
    "binding",
    "mapping",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "project-facets-postgresql"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "projected",
        "blocked"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.5.0"
    },
    "author": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:facet-operation:1.0.0#/$defs/declaration"
        },
        {
          "$ref": "urn:umf:core:kind-operation:4.0.0#/$defs/declaration"
        }
      ]
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tableName",
        "columnName",
        "nativeType",
        "mode",
        "namespace",
        "encoding",
        "obligation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tableName": {
          "type": "string",
          "minLength": 1
        },
        "columnName": {
          "type": "string",
          "minLength": 1
        },
        "nativeType": {
          "enum": [
            "boolean",
            "smallint",
            "integer",
            "bigint",
            "numeric",
            "real",
            "double precision",
            "text",
            "bytea",
            "date",
            "time",
            "time with time zone",
            "timestamp",
            "timestamp with time zone",
            "varchar",
            "char"
          ]
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "enum": [
            "checked",
            "type-modifier",
            "carrier-only"
          ]
        },
        "obligation": {
          "enum": [
            "value-domain",
            "exact-input"
          ]
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.core.facets.postgresql",
        "version": "1.0.0",
        "nativeVersion": "17.4",
        "subset": "Single authored scalar Field; explicit carrier and checked/type-modifier/carrier-only policy; non-null facet domains, retained losses and ideal recovery; no general SQL expression conversion or native equivalence"
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "idealPath",
        "nativePath",
        "outcome",
        "facets",
        "encoding"
      ],
      "properties": {
        "origin": {
          "const": "authored"
        },
        "idealPath": {
          "type": "string"
        },
        "nativePath": {
          "const": "/stmts/0/stmt/CreateStmt/tableElts/0/ColumnDef"
        },
        "outcome": {
          "enum": [
            "exact",
            "unknown",
            "not-expressible",
            "approximated"
          ]
        },
        "facets": {
          "type": "object",
          "description": "Missing members impose no bound. Unknown members and qualifiers are retained without interpretation.",
          "properties": {
            "length": {
              "type": "object",
              "required": [
                "max",
                "unit"
              ],
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unit": {
                  "enum": [
                    "unicode-scalar",
                    "byte"
                  ]
                }
              },
              "additionalProperties": false
            },
            "precision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Decimal coefficient digit bound; requires scale. Absolute coefficient is less than 10^precision. No implicit rounding."
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Fixed fractional digit count; requires precision. Semantic validation requires scale <= precision. Value equals integer coefficient times 10^-scale."
            },
            "integerWidth": {
              "type": "object",
              "required": [
                "bits",
                "signed"
              ],
              "properties": {
                "bits": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "signed": {
                  "type": "boolean"
                }
              },
              "description": "Signed [-2^(bits-1),2^(bits-1)-1] or unsigned [0,2^bits-1]; mathematical domain, not a physical storage-width assertion.",
              "additionalProperties": false
            }
          },
          "dependentRequired": {
            "precision": [
              "scale"
            ],
            "scale": [
              "precision"
            ]
          },
          "additionalProperties": false
        },
        "encoding": {
          "enum": [
            "checked",
            "type-modifier",
            "carrier-only"
          ]
        }
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "reason",
          "outcome",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "unknown",
              "not-expressible",
              "approximated"
            ]
          },
          "recovery": {
            "const": "Recover source meaning with retained projection receipt; native-only import does not recover author intent"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        }
      }
    },
    "nativeSql": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "nativeSql"
        ],
        "properties": {
          "target": true,
          "nativeSql": true
        }
      },
      "else": {
        "properties": {
          "target": false,
          "nativeSql": false
        }
      }
    },
    {
      "$comment": "UMF projection policy",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "warning"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              },
              "diagnostics": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "request": {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "strict"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "maxItems": 0
              },
              "mapping": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "exact"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "mapping": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "enum": [
                      "unknown",
                      "approximated",
                      "not-expressible"
                    ]
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
