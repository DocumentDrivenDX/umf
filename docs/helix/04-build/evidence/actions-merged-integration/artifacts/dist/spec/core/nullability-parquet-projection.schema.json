{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:nullability-parquet-projection:1.0.0",
  "title": "Authored availability projection to Parquet leaf schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "source",
    "author",
    "request",
    "binding",
    "mapping",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "project-nullability-parquet"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "projected",
        "blocked"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.3.0"
    },
    "author": {
      "$ref": "urn:umf:core:nullability-operation:1.0.0#/$defs/declaration"
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recordName",
        "fieldName",
        "nativeType",
        "mode",
        "scope",
        "carrier"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nativeType": {
          "enum": [
            "boolean",
            "int32",
            "int64",
            "float32",
            "float64",
            "binary",
            "string",
            "date",
            "time-millis",
            "time-micros",
            "timestamp-millis-utc",
            "timestamp-micros-utc"
          ]
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "recordName": {
          "type": "string",
          "minLength": 1
        },
        "fieldName": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "row-leaf-value",
            "repeated-element-value",
            "write-input",
            "unresolved"
          ]
        },
        "carrier": {
          "enum": [
            "definition-level",
            "unresolved"
          ]
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.core.nullability.parquet",
        "version": "1.0.0",
        "nativeVersion": "parquet-format@219e3f12a62f9476e830c21e26d030d231f7c017",
        "subset": "Single authored Field with explicit carrier and required/optional leaf in an empty file; no row conversion, writer-input or logical equivalence"
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "idealPath",
        "nativePath",
        "outcome",
        "nullability",
        "encoding",
        "basis",
        "scope",
        "carrier"
      ],
      "properties": {
        "origin": {
          "const": "authored"
        },
        "idealPath": {
          "type": "string"
        },
        "nativePath": {
          "const": "/schema/1/repetition_type"
        },
        "outcome": {
          "enum": [
            "exact",
            "unknown",
            "not-expressible"
          ]
        },
        "nullability": {
          "enum": [
            "required",
            "absent-allowed",
            "unspecified"
          ]
        },
        "encoding": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "basis": {
          "enum": [
            "authored-requirement",
            "no-authored-requirement",
            "unprojected-requirement"
          ]
        },
        "scope": {
          "enum": [
            "row-leaf-value",
            "repeated-element-value",
            "write-input",
            "unresolved"
          ]
        },
        "carrier": {
          "enum": [
            "definition-level",
            "unresolved"
          ]
        }
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "reason",
          "outcome",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "unknown",
              "not-expressible"
            ]
          },
          "recovery": {
            "const": "Recover source meaning with retained projection receipt; native-only import does not recover author intent"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "target": true
        }
      },
      "else": {
        "properties": {
          "target": false
        }
      }
    },
    {
      "$comment": "UMF projection policy",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "warning"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              },
              "diagnostics": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "request": {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "strict"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "maxItems": 0
              },
              "mapping": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "exact"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "mapping": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "enum": [
                      "unknown",
                      "approximated",
                      "not-expressible"
                    ]
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
