{
  "id": "umf.owl",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "OWL 2 RDF graph preservation and local ontology metadata views",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:owl:0.1.0",
    "type": "object",
    "properties": {
      "profile": {
        "enum": [
          "rdf11-nquads",
          "rdf11-turtle",
          "rdf11-trig"
        ]
      },
      "baseIRI": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "namedGraphs": {
        "type": "array",
        "maxItems": 10000,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "iri"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "blank"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": true
            }
          ]
        }
      },
      "blankNodeScope": {
        "type": "string",
        "minLength": 1
      },
      "quads": {
        "type": "array",
        "maxItems": 10000,
        "items": {
          "type": "object",
          "properties": {
            "subject": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "iri"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "blank"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": true
                }
              ]
            },
            "predicate": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "iri"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": true
            },
            "object": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "iri"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "blank"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "literal"
                    },
                    "value": {
                      "type": "string"
                    },
                    "datatype": {
                      "type": "string"
                    },
                    "language": {
                      "type": "string",
                      "pattern": "^[a-z]+(?:-[a-z0-9]+)*$"
                    }
                  },
                  "required": [
                    "kind",
                    "value",
                    "datatype"
                  ],
                  "additionalProperties": true
                }
              ]
            },
            "graph": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "iri"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "blank"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "default"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": true
                }
              ]
            }
          },
          "required": [
            "subject",
            "predicate",
            "object",
            "graph"
          ],
          "additionalProperties": true
        }
      },
      "originalSource": {
        "type": "string",
        "maxLength": 4000000
      },
      "owlVersion": {
        "const": "2"
      }
    },
    "required": [
      "profile",
      "blankNodeScope",
      "quads",
      "originalSource",
      "owlVersion"
    ],
    "additionalProperties": true,
    "allOf": [
      {
        "if": {
          "properties": {
            "profile": {
              "enum": [
                "rdf11-turtle",
                "rdf11-trig"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "baseIRI": {}
          },
          "required": [
            "baseIRI"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "profile": {
              "const": "rdf11-trig"
            }
          }
        },
        "then": {
          "properties": {
            "namedGraphs": {}
          },
          "required": [
            "namedGraphs"
          ]
        }
      }
    ]
  },
  "semantics": "CONTRACT-029; RDF graph fidelity only; OWL axiom validation and reasoning unimplemented",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "OWL",
      "version": "OWL 2 Second Edition 2012-12-11",
      "subset": "Turtle RDF graph preservation; explicit headers/declarations, local expressions, axiom annotations, negative/n-ary assertions and chain/key/disjoint-union lists. No complete structural OWL mapping, validity, profile, import execution or entailment claim"
    },
    "evidence": [
      "tests/owl/annotations.test.ts",
      "fixtures/owl/annotations-oracle.json",
      "fixtures/owl/annotation-case-oracle.json",
      "fixtures/owl/annotation-case-browser.json",
      "tests/owl/expressions.test.ts",
      "fixtures/owl/expression-oracle.json",
      "tests/owl/roundtrip.test.ts",
      "fixtures/owl/oracle-results.json",
      "fixtures/owl/browser-results.json",
      "tests/owl/axioms.test.ts",
      "fixtures/owl/special-oracle.json",
      "fixtures/owl/special-browser.json",
      "tests/owl/declarations.test.ts",
      "fixtures/owl/declarations-oracle.json",
      "fixtures/owl/declarations-browser.json",
      "tests/owl/list-axioms.test.ts",
      "fixtures/owl/list-axioms-oracle.json",
      "fixtures/owl/list-axioms-browser.json"
    ]
  }
}
