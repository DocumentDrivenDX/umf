{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:parquet:metadata-transform:0.1.0",
  "type": "object",
  "required": [
    "source",
    "status",
    "complete",
    "diagnostics"
  ],
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "status": {
      "enum": [
        "transformed",
        "blocked"
      ]
    },
    "complete": {
      "const": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "added": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "unchangedPrefixBytes": {
      "type": "integer",
      "minimum": 4
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "transformed"
          }
        }
      },
      "then": {
        "properties": {
          "output": true,
          "added": true,
          "unchangedPrefixBytes": true
        },
        "required": [
          "output",
          "added",
          "unchangedPrefixBytes"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "output": true
              },
              "required": [
                "output"
              ]
            },
            {
              "properties": {
                "added": true
              },
              "required": [
                "added"
              ]
            },
            {
              "properties": {
                "unchangedPrefixBytes": true
              },
              "required": [
                "unchangedPrefixBytes"
              ]
            }
          ]
        }
      }
    }
  ]
}
