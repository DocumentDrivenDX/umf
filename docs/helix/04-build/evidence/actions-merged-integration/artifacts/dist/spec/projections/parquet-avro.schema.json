{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:projection:parquet-avro:0.1.0",
  "type": "object",
  "required": [
    "status",
    "source",
    "policy",
    "issues",
    "mappings"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "blocked",
        "projected"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "nativeSchema": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "recordName",
        "namespace",
        "fieldNames",
        "maps",
        "lossPolicy"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "recordName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])"
        },
        "lossPolicy": {
          "enum": [
            "strict",
            "allow-reported-loss"
          ]
        },
        "fieldNames": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[1-9][0-9]*(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
          }
        },
        "maps": {
          "const": "entry-arrays"
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "code",
          "classification",
          "detail",
          "retainedInSource"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "representation-change",
              "not-enforced",
              "unsupported",
              "annotation-only"
            ]
          },
          "detail": {
            "type": "string"
          },
          "retainedInSource": {
            "const": true
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "nativeSchema"
        ],
        "properties": {
          "target": {
            "$ref": "urn:umf:core:0.1.0"
          },
          "nativeSchema": {
            "type": "string"
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "target"
              ],
              "properties": {
                "target": {
                  "$ref": "urn:umf:core:0.1.0"
                },
                "nativeSchema": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "nativeSchema"
              ],
              "properties": {
                "target": {
                  "$ref": "urn:umf:core:0.1.0"
                },
                "nativeSchema": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
