{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:spark:rename:0.1.0",
  "type": "object",
  "required": [
    "source",
    "document",
    "complete",
    "validation",
    "renamedCollationPaths",
    "diagnostics"
  ],
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "document": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "complete": {
      "const": false
    },
    "validation": {
      "type": "object",
      "required": [
        "valid",
        "complete",
        "diagnostics"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "path",
              "severity",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "renamedCollationPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "path",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
