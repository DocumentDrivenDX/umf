{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:projection:postgresql-row-json-schema:0.1.0",
  "type": "object",
  "required": [
    "status",
    "source",
    "policy",
    "issues",
    "mappings",
    "complete"
  ],
  "properties": {
    "status": {
      "enum": [
        "blocked",
        "projected"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "nativeSchema": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "schemaId",
        "relation",
        "columns",
        "lossPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schemaId": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "object",
          "required": [
            "schema",
            "name"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "sql-text",
              "json-boolean",
              "json-int32",
              "json-value"
            ]
          }
        },
        "lossPolicy": {
          "enum": [
            "strict",
            "allow-reported-loss"
          ]
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "code",
          "classification",
          "detail",
          "retainedInSource"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "representation-change",
              "not-enforced",
              "unsupported",
              "annotation-only"
            ]
          },
          "detail": {
            "type": "string"
          },
          "retainedInSource": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "column",
          "nativeType",
          "encoding",
          "targetPointer"
        ],
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "nativeType": {
            "type": "string",
            "minLength": 1
          },
          "encoding": {
            "type": "string",
            "minLength": 1
          },
          "targetPointer": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "complete": {
      "const": false
    },
    "sql": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "nativeSchema",
          "sql"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "target"
              ]
            },
            {
              "required": [
                "nativeSchema"
              ]
            },
            {
              "required": [
                "sql"
              ]
            }
          ]
        }
      }
    }
  ]
}
