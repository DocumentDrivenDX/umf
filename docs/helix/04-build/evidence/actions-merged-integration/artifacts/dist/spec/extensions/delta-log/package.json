{
  "id": "umf.delta.log",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "Exact Delta JSON-lines source capture with independent action inspection",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:delta-log:0.1.0",
    "type": "object",
    "required": [
      "profile",
      "text"
    ],
    "properties": {
      "profile": {
        "const": "delta-jsonl-source"
      },
      "text": {
        "type": "string",
        "maxLength": 1000000
      }
    },
    "additionalProperties": true
  },
  "semantics": "CONTRACT-018. Source text is authoritative, including invalid lines and unknown actions; inspection does not reconcile state or authorize writes.",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "structural",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "Delta JSON transaction log",
      "version": "Protocol 3b1b99cd077ec9c84c8a94c250dea3730cc33392; pinned delta-rs corpus",
      "subset": "Bounded exact text capture and line/action envelope inspection. Native action semantics, commit validity and snapshot reconciliation remain unverified."
    },
    "evidence": [
      "tests/delta/log.test.ts",
      "tests/delta/actions.test.ts",
      "tests/delta/reconcile.test.ts",
      "tests/delta/checkpoint.test.ts",
      "fixtures/delta/checkpoint/oracle-results.json",
      "fixtures/delta/checkpoint/browser-results.json",
      "tests/delta/history-upstream.test.ts",
      "fixtures/delta/upstream/history-oracle-results.json",
      "fixtures/delta/upstream/history-browser-results.json",
      "fixtures/delta/history/oracle-results.json",
      "fixtures/delta/history/browser-results.json",
      "fixtures/delta/upstream/action-results.json",
      "fixtures/delta/upstream/action-oracle-results.json",
      "fixtures/delta/upstream/log-results.json",
      "fixtures/delta/upstream/log-browser-results.json"
    ]
  }
}
