{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:rdf:rename:0.1.0",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "from": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "status": {
      "enum": [
        "candidate",
        "blocked"
      ]
    },
    "complete": {
      "const": false
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "before",
          "after"
        ],
        "additionalProperties": false
      }
    },
    "candidate": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source",
    "from",
    "to",
    "status",
    "complete",
    "changes",
    "diagnostics"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "required": [
          "candidate"
        ]
      },
      "else": {
        "not": {
          "required": [
            "candidate"
          ]
        },
        "properties": {
          "changes": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
