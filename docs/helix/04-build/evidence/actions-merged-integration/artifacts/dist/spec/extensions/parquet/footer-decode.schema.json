{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:parquet:footer-decode:0.1.0",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "status": {
      "enum": [
        "decoded",
        "blocked"
      ]
    },
    "complete": {
      "const": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "value": {
      "$ref": "#/$defs/value"
    },
    "consumedBytes": {
      "type": "integer",
      "minimum": 1
    },
    "trailingBytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "source",
    "status",
    "complete",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "i8",
                "i16",
                "i32",
                "i64"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "double"
            },
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          },
          "required": [
            "kind",
            "bits"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "binary"
            },
            "hex": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$"
            }
          },
          "required": [
            "kind",
            "hex"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "uuid"
            },
            "hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          "required": [
            "kind",
            "hex"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "list",
                "set"
              ]
            },
            "elementType": {
              "enum": [
                "bool",
                "i8",
                "i16",
                "i32",
                "i64",
                "double",
                "binary",
                "list",
                "set",
                "map",
                "struct",
                "uuid"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "kind",
            "elementType",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "map"
            },
            "keyType": {
              "enum": [
                "bool",
                "i8",
                "i16",
                "i32",
                "i64",
                "double",
                "binary",
                "list",
                "set",
                "map",
                "struct",
                "uuid"
              ]
            },
            "valueType": {
              "enum": [
                "bool",
                "i8",
                "i16",
                "i32",
                "i64",
                "double",
                "binary",
                "list",
                "set",
                "map",
                "struct",
                "uuid"
              ]
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/$defs/value"
                  },
                  "value": {
                    "$ref": "#/$defs/value"
                  }
                },
                "required": [
                  "key",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "entries"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "struct"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767
                  },
                  "value": {
                    "$ref": "#/$defs/value"
                  }
                },
                "required": [
                  "id",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
