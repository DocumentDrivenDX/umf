{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:tablespec-facet-classification:1.0.0",
  "title": "TableSpec profile-qualified facet classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "outcome",
    "source",
    "request",
    "binding",
    "mapping",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "classify-tablespec-facets"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "classified",
        "blocked"
      ]
    },
    "outcome": {
      "enum": [
        "exact",
        "approximated",
        "not-expressible",
        "unknown"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.5.0"
    },
    "target": {
      "$ref": "urn:umf:core:0.5.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "mode",
        "profile",
        "input",
        "obligation"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "profile": {
          "enum": [
            "declared-metadata",
            "json-schema",
            "pyspark-schema",
            "gx-spark",
            "gx-suite-spark",
            "ingest-cast",
            "unresolved"
          ]
        },
        "input": {
          "enum": [
            "raw",
            "model-normalized"
          ]
        },
        "obligation": {
          "enum": [
            "value-domain",
            "exact-input"
          ]
        },
        "author": {
          "$ref": "urn:umf:core:facet-operation:1.0.0#/$defs/declaration"
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.tablespec.facets",
        "version": "1.0.0",
        "nativeVersion": "647e8e566ad78b864282ec65c0b0b2237aa63084",
        "subset": "Scalar-column facet interpretation under explicit consumer/input/obligation profiles; length claims cover well-formed Unicode scalar strings only; no whole-model validation, pipeline execution or native equivalence"
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "idealPath",
        "nativePath",
        "nativeFragment",
        "facets",
        "observations"
      ],
      "properties": {
        "origin": {
          "const": "classified"
        },
        "idealPath": {
          "type": "string",
          "minLength": 1
        },
        "nativePath": {
          "type": "string",
          "minLength": 1
        },
        "nativeFragment": {
          "$ref": "urn:umf:native-json:0.1.0"
        },
        "facets": {
          "type": "object",
          "description": "Missing members impose no bound. Unknown members and qualifiers are retained without interpretation.",
          "properties": {
            "length": {
              "type": "object",
              "required": [
                "max",
                "unit"
              ],
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unit": {
                  "enum": [
                    "unicode-scalar",
                    "byte"
                  ]
                }
              },
              "additionalProperties": false
            },
            "precision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Decimal coefficient digit bound; requires scale. Absolute coefficient is less than 10^precision. No implicit rounding."
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Fixed fractional digit count; requires precision. Semantic validation requires scale <= precision. Value equals integer coefficient times 10^-scale."
            },
            "integerWidth": {
              "type": "object",
              "required": [
                "bits",
                "signed"
              ],
              "properties": {
                "bits": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "signed": {
                  "type": "boolean"
                }
              },
              "description": "Signed [-2^(bits-1),2^(bits-1)-1] or unsigned [0,2^bits-1]; mathematical domain, not a physical storage-width assertion.",
              "additionalProperties": false
            }
          },
          "dependentRequired": {
            "precision": [
              "scale"
            ],
            "scale": [
              "precision"
            ]
          },
          "additionalProperties": false
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept",
              "idealPath",
              "nativePath",
              "interpretation",
              "outcome",
              "basis"
            ],
            "properties": {
              "concept": {
                "enum": [
                  "length",
                  "decimal",
                  "integerWidth",
                  "conversion",
                  "native"
                ]
              },
              "idealPath": {
                "type": "string",
                "minLength": 1
              },
              "nativePath": {
                "type": "string",
                "minLength": 1
              },
              "interpretation": {
                "enum": [
                  "declared",
                  "inferred",
                  "unknown",
                  "unsupported"
                ]
              },
              "outcome": {
                "enum": [
                  "exact",
                  "approximated",
                  "not-expressible",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "targetPath",
          "value",
          "reason",
          "outcome",
          "binding",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "targetPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "approximated",
              "not-expressible",
              "unknown"
            ]
          },
          "binding": {
            "const": {
              "id": "umf.tablespec.facets",
              "version": "1.0.0",
              "nativeVersion": "647e8e566ad78b864282ec65c0b0b2237aa63084",
              "subset": "Scalar-column facet interpretation under explicit consumer/input/obligation profiles; length claims cover well-formed Unicode scalar strings only; no whole-model validation, pipeline execution or native equivalence"
            }
          },
          "recovery": {
            "const": "Retain original native archive and authored facets; interpretation does not replace native meaning"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "target": true,
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target": false,
          "residuals": {
            "type": "array",
            "minItems": 1
          },
          "diagnostics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "exact"
          }
        }
      },
      "then": {
        "properties": {
          "residuals": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "residuals": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          },
          "request": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "strict"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "exact"
          },
          "residuals": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
