{
  "id": "umf.linkml",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "LinkML source schemas with explicit metamodel selection and exact native preservation",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:linkml:0.1.0",
    "type": "object",
    "properties": {
      "profile": {
        "const": "linkml-json-yaml"
      },
      "metamodelVersion": {
        "type": "string",
        "minLength": 1
      },
      "root": {
        "$ref": "#/$defs/node"
      },
      "originalSource": {
        "type": "string",
        "maxLength": 4000000
      },
      "originalFormat": {
        "enum": [
          "json",
          "yaml"
        ]
      }
    },
    "required": [
      "profile",
      "metamodelVersion",
      "root",
      "originalSource",
      "originalFormat"
    ],
    "additionalProperties": true,
    "$defs": {
      "node": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "null"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "boolean"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "number"
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "items"
            ],
            "properties": {
              "kind": {
                "const": "array"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "members"
            ],
            "properties": {
              "kind": {
                "const": "object"
              },
              "members": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        ]
      }
    }
  },
  "semantics": "CONTRACT-024; source is authoritative, independently of native loader normalization or schema diagnostics",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "LinkML",
      "version": "linkml-model 1.11.0 commit 051e945bb8d64ffd60639c666615ace88d561e2f; native loader runtime 1.11.0rc2",
      "subset": "JSON/YAML schema source, complete pinned metamodel JSON Schema, copied metadata edits, explicit supplied import graph, document-local class-slot membership and 29-field scalar induction; explicit import merge modes; no native retrieval, induced model, instance validation or generators"
    },
    "evidence": [
      "tests/linkml/linkml.test.ts",
      "fixtures/linkml/oracle-results.json",
      "fixtures/linkml/browser-results.json",
      "tests/linkml/metamodel.test.ts",
      "fixtures/linkml/metamodel/oracle-results.json",
      "tests/linkml/imports.test.ts",
      "fixtures/linkml/imports/oracle-results.json",
      "fixtures/linkml/imports/browser-results.json",
      "tests/linkml/class-slots.test.ts",
      "fixtures/linkml/class-slots/oracle-results.json",
      "fixtures/linkml/class-slots/browser-results.json",
      "tests/linkml/slot-values.test.ts",
      "fixtures/linkml/slot-values/oracle-results.json",
      "fixtures/linkml/slot-values/browser-results.json",
      "tests/linkml/slot-corpus.test.ts",
      "fixtures/linkml/slot-corpus/oracle-results.json",
      "fixtures/linkml/slot-corpus/browser-results.json",
      "tests/linkml/merge.test.ts",
      "fixtures/linkml/merge/oracle-results.json",
      "fixtures/linkml/merge/browser-results.json",
      "tests/linkml/metamodel-merge.test.ts",
      "fixtures/linkml/metamodel-merge/oracle-results.json",
      "fixtures/linkml/metamodel-merge/browser-results.json"
    ]
  }
}
