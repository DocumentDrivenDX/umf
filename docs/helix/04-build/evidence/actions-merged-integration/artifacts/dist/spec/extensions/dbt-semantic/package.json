{
  "id": "umf.dbt.semantic",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "Exact dbt semantic manifest with DSI-version-scoped serialized shape checks",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:dbt:semantic:0.1.0",
    "type": "object",
    "properties": {
      "profile": {
        "const": "dbt-semantic-json"
      },
      "root": {
        "$ref": "#/$defs/node"
      }
    },
    "required": [
      "profile",
      "root"
    ],
    "additionalProperties": true,
    "$defs": {
      "node": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "null"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "boolean"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "number"
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "items"
            ],
            "properties": {
              "kind": {
                "const": "array"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "members"
            ],
            "properties": {
              "kind": {
                "const": "object"
              },
              "members": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        ]
      }
    }
  },
  "semantics": "CONTRACT-022 AC10–AC11; retain source independently of derived shape diagnostics; semantic validation and execution remain external",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "dbt semantic manifest",
      "version": "dbt-semantic-interfaces 0.8.5, dbt Core 1.10.0",
      "subset": "Exact JSON preservation, copied candidate edits and derived nullable serialized shapes; no metric execution or semantic-validator equivalence"
    },
    "evidence": [
      "tests/dbt/semantic.test.ts",
      "fixtures/dbt/semantic/oracle-results.json",
      "fixtures/dbt/semantic/browser-results.json",
      "tests/dbt/semantic-metrics.test.ts",
      "fixtures/dbt/semantic-metrics/oracle-results.json",
      "fixtures/dbt/semantic-metrics/browser-results.json"
    ]
  }
}
