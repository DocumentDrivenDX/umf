{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:parquet:experimental-values:0.1.0",
  "description": "Experimental value view; not a public decoder or complete value-validity contract",
  "type": "array",
  "items": {
    "$ref": "#/$defs/value"
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "struct"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/value"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "map"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "value"
                ],
                "properties": {
                  "key": {
                    "$ref": "#/$defs/value"
                  },
                  "value": {
                    "$ref": "#/$defs/value"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "bits",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "int",
                "uint"
              ]
            },
            "bits": {
              "enum": [
                8,
                16,
                32,
                64
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-[1-9][0-9]*|[1-9][0-9]*)$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "bits",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "bits": {
              "enum": [
                32,
                64
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]+)?)(?:e[+-]?[0-9]+)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "string",
                "enum",
                "json"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-[1-9][0-9]*|[1-9][0-9]*)$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "unit",
            "isAdjustedToUTC",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "time",
                "timestamp"
              ]
            },
            "unit": {
              "enum": [
                "MILLIS",
                "MICROS",
                "NANOS"
              ]
            },
            "isAdjustedToUTC": {
              "type": "boolean"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-[1-9][0-9]*|[1-9][0-9]*)$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
