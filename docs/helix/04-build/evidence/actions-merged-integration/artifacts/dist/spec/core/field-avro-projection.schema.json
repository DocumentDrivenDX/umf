{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:field-avro-projection:1.0.0",
  "title": "Authored Field to explicit Avro record field",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "source",
    "author",
    "request",
    "binding",
    "mapping",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "project-field-avro"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "projected",
        "blocked"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.2.0"
    },
    "author": {
      "$ref": "urn:umf:core:kind-operation:1.0.0#/$defs/declaration"
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recordName",
        "namespace",
        "fieldName",
        "nativeType",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nativeType": {
          "enum": [
            "null",
            "boolean",
            "int",
            "long",
            "float",
            "double",
            "bytes",
            "string",
            "date",
            "time-millis",
            "time-micros",
            "timestamp-millis",
            "timestamp-micros",
            "local-timestamp-micros",
            "decimal(38,9)"
          ]
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "recordName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "fieldName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "namespace": {
          "type": "string",
          "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)?(?![\\s\\S])"
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.core.field.avro",
        "version": "1.0.0",
        "nativeVersion": "1.12.0",
        "subset": "Single authored Field with explicit primitive/logical carrier in a record; no presence, execution or value-domain equivalence"
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "idealPath",
        "nativePath",
        "outcome"
      ],
      "properties": {
        "origin": {
          "const": "authored"
        },
        "idealPath": {
          "type": "string"
        },
        "nativePath": {
          "const": "/fields/0"
        },
        "outcome": {
          "enum": [
            "exact",
            "unknown",
            "not-expressible"
          ]
        }
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "reason",
          "outcome",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "unknown",
              "not-expressible"
            ]
          },
          "recovery": {
            "const": "Recover source meaning with retained projection receipt; native-only import does not recover author intent"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "target": true
        }
      },
      "else": {
        "properties": {
          "target": false
        }
      }
    },
    {
      "$comment": "UMF projection policy",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "warning"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              },
              "diagnostics": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "request": {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "strict"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "maxItems": 0
              },
              "mapping": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "exact"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "projected"
              },
              "mapping": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "enum": [
                      "unknown",
                      "approximated",
                      "not-expressible"
                    ]
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "residuals": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
