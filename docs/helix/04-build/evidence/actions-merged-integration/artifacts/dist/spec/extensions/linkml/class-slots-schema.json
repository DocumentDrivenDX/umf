{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:linkml:class-slots:0.1.0",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "className": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "scope": {
      "const": "document"
    },
    "status": {
      "enum": [
        "resolved",
        "blocked"
      ]
    },
    "complete": {
      "const": false
    },
    "ancestors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "declarations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "className": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "slot",
                    "attribute"
                  ]
                }
              },
              "required": [
                "className",
                "path",
                "kind"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "declarations"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source",
    "className",
    "scope",
    "status",
    "complete",
    "ancestors",
    "slots",
    "diagnostics"
  ],
  "additionalProperties": false
}
