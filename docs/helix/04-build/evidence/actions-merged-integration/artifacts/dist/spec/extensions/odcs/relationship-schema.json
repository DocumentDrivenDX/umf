{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:odcs:relationship-report:0.1.0",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "status": {
      "enum": [
        "checked",
        "blocked"
      ]
    },
    "complete": {
      "const": false
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "schema",
              "property"
            ]
          },
          "status": {
            "enum": [
              "resolved",
              "blocked"
            ]
          },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fromPath": {
                  "type": "string"
                },
                "toPath": {
                  "type": "string"
                }
              },
              "required": [
                "fromPath",
                "toPath"
              ],
              "additionalProperties": false
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "severity": {
                  "enum": [
                    "error",
                    "warning"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "path",
                "severity",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "scope",
          "status",
          "pairs",
          "diagnostics"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "blocked"
                }
              }
            },
            "then": {
              "properties": {
                "pairs": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "pairs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source",
    "status",
    "complete",
    "relationships",
    "diagnostics"
  ],
  "additionalProperties": false
}
