{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:openapi-dynamic-reference:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "target",
    "node",
    "complete",
    "limitations",
    "initialTarget",
    "evaluationScope",
    "resolution"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrievalUri",
        "pointer",
        "baseUri",
        "dialect"
      ],
      "properties": {
        "retrievalUri": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        },
        "baseUri": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrievalUri",
        "pointer",
        "baseUri",
        "dialect"
      ],
      "properties": {
        "retrievalUri": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        },
        "baseUri": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        }
      }
    },
    "node": {
      "$ref": "#/$defs/node"
    },
    "complete": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "initialTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrievalUri",
        "pointer",
        "baseUri",
        "dialect"
      ],
      "properties": {
        "retrievalUri": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        },
        "baseUri": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        }
      }
    },
    "evaluationScope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string"
      }
    },
    "resolution": {
      "enum": [
        "static",
        "dynamic"
      ]
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  }
}
