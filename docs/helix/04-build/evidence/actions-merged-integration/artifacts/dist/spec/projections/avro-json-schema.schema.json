{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:projection:avro-json-schema:0.1.0",
  "type": "object",
  "required": [
    "status",
    "source",
    "policy",
    "issues",
    "mappings"
  ],
  "properties": {
    "status": {
      "enum": [
        "blocked",
        "projected"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "nativeSchema": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schemaId",
        "long",
        "bytes",
        "union",
        "lossPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schemaId": {
          "type": "string",
          "minLength": 1
        },
        "long": {
          "const": "decimal-string"
        },
        "bytes": {
          "const": "hex-string"
        },
        "union": {
          "const": "untagged"
        },
        "lossPolicy": {
          "enum": [
            "strict",
            "allow-reported-loss"
          ]
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "code",
          "classification",
          "detail",
          "retainedInSource"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "representation-change",
              "not-enforced",
              "unsupported",
              "annotation-only"
            ]
          },
          "detail": {
            "type": "string"
          },
          "retainedInSource": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sourcePath",
          "targetPointer"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sourcePath": {
            "type": "string"
          },
          "targetPointer": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "nativeSchema"
        ]
      },
      "else": {
        "not": {
          "required": [
            "target"
          ]
        }
      }
    }
  ]
}
