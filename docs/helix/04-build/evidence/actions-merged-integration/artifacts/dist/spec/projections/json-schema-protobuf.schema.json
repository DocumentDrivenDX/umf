{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:projection:json-schema-protobuf:0.1.0",
  "type": "object",
  "required": [
    "status",
    "source",
    "policy",
    "issues",
    "mappings"
  ],
  "properties": {
    "status": {
      "enum": [
        "blocked",
        "projected"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "target": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "nativeSource": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "packageName",
        "messageName",
        "fields",
        "integerType",
        "lossPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "packageName": {
          "type": "string"
        },
        "messageName": {
          "type": "string"
        },
        "integerType": {
          "enum": [
            "int64",
            "uint64",
            "sint64",
            "int32",
            "uint32",
            "sint32"
          ]
        },
        "lossPolicy": {
          "enum": [
            "strict",
            "allow-reported-loss"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "number"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 536870911
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "code",
          "classification",
          "detail",
          "retainedInSource"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "representation-change",
              "not-enforced",
              "unsupported",
              "annotation-only"
            ]
          },
          "detail": {
            "type": "string"
          },
          "retainedInSource": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourcePath",
          "targetMessage",
          "targetField",
          "number"
        ],
        "properties": {
          "sourcePath": {
            "type": "string"
          },
          "targetMessage": {
            "type": "string"
          },
          "targetField": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "targetDiagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "nativeSource",
          "targetDiagnostics"
        ]
      },
      "else": {
        "not": {
          "required": [
            "target"
          ]
        }
      }
    }
  ]
}
