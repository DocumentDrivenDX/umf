{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:avro:facet-binding:1.0.0",
  "title": "Retained Avro facet interpretation profile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "origin",
    "location",
    "binding",
    "profile",
    "obligation",
    "outcome",
    "observations"
  ],
  "properties": {
    "origin": {
      "const": "classified"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "dependencyId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.avro.facets",
        "version": "1.0.0"
      }
    },
    "profile": {
      "enum": [
        "declared-schema",
        "apache-datum-writer",
        "fastavro-schemaless-writer",
        "unresolved"
      ]
    },
    "obligation": {
      "enum": [
        "value-domain",
        "exact-input"
      ]
    },
    "outcome": {
      "enum": [
        "exact",
        "approximated",
        "not-expressible",
        "unknown"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept",
          "idealPath",
          "location",
          "interpretation",
          "outcome",
          "basis"
        ],
        "properties": {
          "concept": {
            "enum": [
              "length",
              "decimal",
              "integerWidth",
              "conversion",
              "native"
            ]
          },
          "idealPath": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "dependencyId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "interpretation": {
            "enum": [
              "declared",
              "inferred",
              "unknown",
              "unsupported"
            ]
          },
          "outcome": {
            "enum": [
              "exact",
              "approximated",
              "not-expressible",
              "unknown"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
