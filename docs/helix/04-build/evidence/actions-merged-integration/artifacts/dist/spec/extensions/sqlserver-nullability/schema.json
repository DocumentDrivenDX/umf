{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:sqlserver:nullability-binding:1.0.0",
  "title": "Retained SQL Server availability binding scope",
  "type": "object",
  "required": [
    "origin",
    "binding",
    "scope",
    "carrier",
    "interpretation",
    "nativePath"
  ],
  "properties": {
    "origin": {
      "const": "classified"
    },
    "binding": {
      "const": {
        "id": "umf.sqlserver.nullability",
        "version": "1.0.0"
      }
    },
    "scope": {
      "enum": [
        "stored-relation",
        "query-result",
        "write-input",
        "unresolved"
      ]
    },
    "carrier": {
      "enum": [
        "sql-null",
        "unresolved"
      ]
    },
    "interpretation": {
      "enum": [
        "declared",
        "unknown",
        "unsupported"
      ]
    },
    "nativePath": {
      "type": "string",
      "minLength": 1
    }
  }
}
