{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:postgresql-key-classification:1.0.0",
  "title": "PostgreSQL key observations and strict/report residual recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "outcome",
    "source",
    "request",
    "binding",
    "observations",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "classify-postgresql-keys"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "classified",
        "blocked"
      ]
    },
    "outcome": {
      "enum": [
        "exact",
        "unknown",
        "not-expressible"
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeSource",
        "supplement",
        "mode",
        "profile"
      ],
      "properties": {
        "nativeSource": {
          "type": "string",
          "minLength": 1
        },
        "supplement": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "profile": {
          "const": "captured-stored-values"
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.postgresql.keys",
        "version": "1.0.0",
        "nativeVersion": "17.4",
        "subset": "Correlated captured indexes over relations including descendants; observed enforcement/equality only, no authored identity, authentication, exact-input conversion or native equivalence"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "nativePath",
          "fields",
          "primary",
          "enforcement",
          "equality",
          "authorIntent",
          "provenance",
          "scope",
          "reasons"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "table",
              "index"
            ],
            "properties": {
              "schema": {
                "type": "string",
                "minLength": 1
              },
              "table": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "nativePath": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "module",
                "element"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "element": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "primary": {
            "type": "boolean"
          },
          "enforcement": {
            "enum": [
              "immediate-unique-nonnull",
              "conditional",
              "deferred",
              "nullable",
              "not-unique",
              "unavailable",
              "unknown"
            ]
          },
          "equality": {
            "enum": [
              "exact-on-representable-values",
              "incompatible",
              "unknown"
            ]
          },
          "authorIntent": {
            "const": "unknown"
          },
          "provenance": {
            "const": "inferred"
          },
          "scope": {
            "const": "relation-with-descendants"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "outcome",
          "reason",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "outcome": {
            "enum": [
              "unknown",
              "not-expressible"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "recovery": {
            "const": "Original native catalog and supplement retained; authored key intent is not inferred"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target": false,
          "residuals": {
            "type": "array",
            "minItems": 1
          },
          "diagnostics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "exact"
          }
        }
      },
      "then": {
        "properties": {
          "residuals": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "residuals": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          },
          "request": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "strict"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "exact"
          }
        }
      }
    }
  ]
}
