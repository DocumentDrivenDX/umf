{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:delta-log:reconciliation:0.1.0",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "blocked",
        "reconciled"
      ]
    },
    "complete": {
      "const": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "source": {
            "$ref": "urn:umf:core:0.1.0"
          }
        },
        "required": [
          "version",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "source": {
          "$ref": "urn:umf:core:0.1.0"
        }
      },
      "required": [
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "path",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "protocol": {
          "$ref": "#/$defs/node"
        },
        "metaData": {
          "$ref": "#/$defs/node"
        },
        "adds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "removes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "transactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "commitInfo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/node"
              }
            },
            "required": [
              "version",
              "line",
              "action",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "protocol",
        "metaData",
        "adds",
        "removes",
        "transactions",
        "domains",
        "commitInfo",
        "deferred"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "complete",
    "sources",
    "diagnostics"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reconciled"
          }
        }
      },
      "then": {
        "required": [
          "state"
        ]
      },
      "else": {
        "not": {
          "required": [
            "state"
          ]
        }
      }
    }
  ],
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  }
}
