    "form": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "nativePath": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "scalarType": {
                "type": "string"
              },
              "control": {
                "enum": [
                  "text",
                  "number",
                  "checkbox"
                ]
              },
              "requiredPresence": {
                "const": true
              },
              "nullable": {
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "target",
              "path",
              "nativePath",
              "description",
              "scalarType",
              "control",
              "requiredPresence",
              "nullable"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false
    },
    "agentContext": {
      "type": "object",
      "properties": {
        "operationPath": {
          "type": "string"
        },
        "operation": {
          "type": "object"
        },
        "aggregate": {
          "$ref": "urn:umf:ddd:0.1.0#/$defs/entity"
        },
        "service": {
          "$ref": "urn:umf:ddd:0.1.0#/$defs/service"
        },
        "contextPointer": {
          "const": "/context"
        },
        "limitsPointer": {
          "const": "/limits"
        }
      },
      "required": [
        "operationPath",
        "operation",
        "aggregate",
        "service",
        "contextPointer",
        "limitsPointer"
      ],
      "additionalProperties": false
    },
    "humanDocumentation": {
      "type": "string"
    }
  },
  "required": [
    "profile",
    "context",
    "limits",
    "transform",
    "visualization",
    "pipeline",
    "validator",
    "form",
    "agentContext",
    "humanDocumentation"
  ],
  "additionalProperties": false
}
