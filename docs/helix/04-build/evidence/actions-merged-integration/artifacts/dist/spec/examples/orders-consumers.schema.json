      }
    },
    "transform": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "exact-key-rename"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "nativePath": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "scalarType": {
                "type": "string"
              },
              "control": {
                "enum": [
                  "text",
                  "number",
                  "checkbox"
                ]
              },
              "requiredPresence": {
                "const": true
              },
              "nullable": {
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "target",
              "path",
              "nativePath",
              "description",
              "scalarType",
              "control",
              "requiredPresence",
              "nullable"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "fields"
      ],
      "additionalProperties": false
    },
    "visualization": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string"
              },
              "element": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "module",
              "element",
              "path",
              "label",
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
