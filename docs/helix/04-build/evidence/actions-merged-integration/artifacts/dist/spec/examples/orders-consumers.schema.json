{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:example:orders-consumers:1",
  "type": "object",
  "properties": {
    "profile": {
      "const": "orders-consumer-demo-1"
    },
    "context": {
      "$ref": "urn:umf:core:element-selection:0.1.0"
    },
    "limits": {
      "type": "array",
      "items": {
