    "pipeline": {
      "type": "object",
      "properties": {
        "execution": {
          "const": "local-transform-and-validation-only"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
