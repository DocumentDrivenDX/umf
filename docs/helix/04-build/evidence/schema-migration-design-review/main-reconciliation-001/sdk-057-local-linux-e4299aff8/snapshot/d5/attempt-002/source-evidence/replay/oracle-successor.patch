+def encode_observed(value):
+    """Losslessly encode only the native value types in the frozen D5 row domain."""
+    if value is None or type(value) in (bool, int, str):
+        return value
+    if isinstance(value, Decimal):
+        return {"$type": "decimal", "value": str(value)}
+    if type(value) is date:
+        return {"$type": "date", "value": value.isoformat()}
+    if type(value) is float:
+        if math.isfinite(value):
+            return {"$type": "float-hex", "value": value.hex()}
+        return {"$type": "float-nonfinite", "value": "nan" if math.isnan(value) else "+inf" if value > 0 else "-inf"}
+    if isinstance(value, (tuple, list)):
+        return [encode_observed(item) for item in value]
+    raise TypeError(f"Unknown native row value type: {type(value).__name__}")
 
 
