+    def test_pg18_set_operations_retain_types_group_operators_and_permissions(self):
+        group = "({SORTGROUPCLAUSE :tleSortGroupRef 0 :eqop 96 :sortop 97 :nulls_first false :hashable true})"
+        base = "{SETOPERATIONSTMT :op 3 :all false :larg {RANGETBLREF :rtindex 1} :rarg {RANGETBLREF :rtindex 2} :colTypes (o 23) :colTypmods (i -1) :colCollations (o 0) :groupClauses " + group + "}"
+        for operation in (1, 2, 3):
+            result = analyze(base.replace(":op 3", ":op " + str(operation)))
+            self.assertEqual(result['typeOids'], [23])
+            self.assertEqual(result['operatorOids'], [96, 97])
+            self.assertEqual(result['sortOperatorOids'], [97])
+            self.assertEqual(result['intrinsicNodes'][0]['columnTypeOids'], [23])
+        union_all = base.replace(":op 3", ":op 1").replace(":all false", ":all true").replace(group, "<>")
+        self.assertEqual(analyze(union_all)['operatorOids'], [])
+        nested = base.replace("{RANGETBLREF :rtindex 1}", union_all)
+        query = "{QUERY :setOperations " + nested + " :rtable ({RTEPERMISSIONINFO :relid 1259 :requiredPerms 2 :checkAsUser 0 :selectedCols (b 8)}) :targetList ({TARGETENTRY :expr {FUNCEXPR :funcid 65 :funcresulttype 16 :args ({VAR :vartype 23})}})}"
+        result = analyze(query)
+        self.assertEqual(result['relationPermissions'][0]['relid'], 1259)
+        self.assertEqual(result['functionOids'], [65])
+        self.assertEqual(result['typeOids'], [16, 23])
+        self.assertEqual(len(result['intrinsicNodes']), 2)
+
