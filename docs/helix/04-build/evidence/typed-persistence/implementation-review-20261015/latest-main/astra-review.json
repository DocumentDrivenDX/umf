      "disposition": "resolved; current source inspected and exact rebuilt-wheel/regression receipts verified"
    },
    {
      "id": "IR07",
      "severity": "P2",
      "title": "Cross-module Field IDs collided in local codec wire inventories",
      "path": "src/compilation/admission/index.ts",
      "section": "record wireIds and request.projections inventory admission",
      "counterexample": "A Record owns commerce/amount and other/amount with distinct Python names. The generator emitted two CodecField entries with field=\"amount\"; the local inventory boundary then refused every codec call (or an unchecked mapping could overwrite meaning).",
      "repair": "Fail closed before emission for duplicate unqualified Field IDs in owned Record or projection inventory. Qualified local wire identities require a separately specified extension.",
      "regression": "tests/compilation/access-generator.test.ts: cross-module duplicate wire Field IDs refuse instead of overwriting codecs",
      "disposition": "resolved; current source inspected and exact rebuilt-wheel/regression receipts verified"
    },
    {
      "id": "IR08",
      "severity": "P2",
      "title": "Source-provenance bridge violated Python package import boundaries",
      "path": "python/umf_access/src/umf_access/reviewed.py",
      "section": "module imports and _check_source",
      "counterexample": "reviewed imported private dsl._nodes and loaded RUNTIME_ABI from the package facade, violating the package ownership graph and creating a facade back-edge; the mandatory boundary gate failed.",
      "repair": "Define RUNTIME_ABI in types, preserve its public facade re-export, and import reference classes through the public dsl API; explicitly re-export KeyLiteral without changing its class identity.",
      "regression": "scripts/check-access-python-boundaries.py and installed-wheel import/runtime replay",
      "disposition": "resolved; current source inspected and exact rebuilt-wheel/regression receipts verified"
    }
