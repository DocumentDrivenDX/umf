  "findings": [
    {
      "id": "IR01",
      "severity": "P2",
      "title": "Native read validation discarded extras and exposed input values",
      "path": "python/umf_access/src/umf_access/postgres_read.py",
      "section": "_execute parameter reconstruction and result validation",
      "counterexample": "model_copy(update={unexpected: value}) extra was dropped by reconstruction from declared field names; direct model_validate on strict host models leaked invalid values/validator messages.",
      "repair": "General BaseModel raw-graph revalidation and sanitized validation boundary for parameters/results; preserve exact parameter class check.",
      "disposition": "resolved in reviewed source manifest; focused and integrated regressions pass"
    },
    {
      "id": "IR02",
      "severity": "P2",
      "title": "Non-null hidden continuation components accepted null",
      "path": "python/umf_access/src/umf_access/postgres_read.py",
      "section": "continuation input/output carriers",
      "counterexample": "Replace a non-null root Key component by None while retaining identity_digest: old input check skipped validation and next page could silently skip rows. Hidden sort outputs were also returned without carrier validation.",
      "repair": "Validate every component against exact carrier and nullable flag both before dispatch and before issuing continuation; initial no-after placeholders remain distinct.",
      "disposition": "resolved in reviewed source manifest; focused and integrated regressions pass"
    },
    {
      "id": "IR03",
      "severity": "P2",
      "title": "Nested-only Fields admitted as projected row columns",
      "path": "src/compilation/admission/index.ts",
      "section": "request.projections ownership resolution",
      "counterexample": "Add tags array with tagItem nested Field and select tagItem in root projection: old root.fields.find admitted it though it is not an owned row member.",
      "repair": "Require owned members in admission and emitter projection resolution; regression refuses nested-only projection.",
      "disposition": "resolved in reviewed source manifest; focused and integrated regressions pass",
      "retractedHypothesis": "A separate suspected ambiguity from sharing one owned Field across two Records was disproved by core KEY_MEMBER_OWNER rejection; it is not a finding."
    },
    {
      "id": "IR04",
      "severity": "P1",
      "title": "Native unique-index admission did not prove query equality",
      "path": "python/umf_access/src/umf_access/postgres_read.py",
      "section": "_KEYS catalog observation",
      "counterexample": "A text Key column with nondeterministic case-insensitive collation and UNIQUE INDEX(id COLLATE C) stores a and A, while query equality treats both equal. Old attribute-only index check accepted it, breaking to-one joins and keyset progress.",
      "repair": "Require ready/valid/immediate unpredicated btree unique index, NOT NULL Key fields, built-in qualified opclasses matching carrier, exact index/column collation and deterministic Key collation.",
      "disposition": "resolved in reviewed source manifest; focused and integrated regressions pass",
      "test": "python/umf_access/tests/test_native_key_admission.py"
    },
    {
      "id": "IR05",
      "severity": "P1",
      "title": "Generated query could bind to a different model generation",
      "path": "python/umf_access/src/umf_access/reviewed.py",
      "section": "build_query, CatalogRead.artifact and generated reference metadata",
      "counterexample": "Generated Record/Field metadata had only schema/logical names, allowing model A query to build against different model B with matching names/carriers, or mix roots, joined refs and Key carriers from different generation inputs.",
      "repair": "Immutable GeneratedSource carries exact document ID/core version/document SHA/input digest/runtime ABI through generated models/references and captured Key parameters/literals. Build checks every referenced cohort and binding model bytes before Weft; catalog carries local source metadata and load checks generated or explicitly supplied expected source.",
      "disposition": "resolved in reviewed source manifest; focused and integrated regressions pass",
      "test": "python/umf_access/tests/test_reviewed_source.py"
    }
  ],
