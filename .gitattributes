# Check out text as LF everywhere: fixtures, hashes and byte comparisons assume LF,
# so a Windows core.autocrlf=true checkout must not rewrite them to CRLF.
* text=auto eol=lf
# Preserve pinned native test-source bytes, including mixed upstream line endings.
native/rdfxml/sources/** -text
native/shacl/sources/** -text
fixtures/shacl/corpus/** -text
native/tablespec/sources/** -text
# Lakeview reconstruction fixtures are original bytes, including BOM/CRLF and
# intentional trailing whitespace; Git must not normalize them on checkout.
fixtures/lakeview/*.lvdash.json -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Medical source/row checksums cover original bytes, including native CRLF.
spec/domain-packs/medical*/sources/** -text
spec/domain-packs/medical*/data/** -text
spec/domain-packs/medical-terminology/sources/*.txt whitespace=cr-at-eol

spec/domain-packs/medical-carrier/sources/cms-*.csv -text whitespace=cr-at-eol
spec/domain-packs/medical-imaging/sources/*.dcm binary

# Generated bundles may contain literal trailing spaces in dependency strings.
# Qualification receipt hashes cover exact checker stdout, including final blank lines.
# Release diagnostic hashes retain exact compiler code frames and patch context.

# Current qualification hashes cover exact native stdout/stderr, including
# progress carriage returns, code-frame spacing and final blank lines.
fixtures/validation/uuid/model-runs/*.log -text whitespace=-blank-at-eol,-blank-at-eof
fixtures/validation/uuid/composition-runs/*.log -text whitespace=-blank-at-eol,-blank-at-eof
# Generated reference notices retain the exact bundled third-party license text.
# Captured candidate/replay logs are hashed as observed, including code frames.

# Archived diagnostics retain exact original code-frame whitespace and hashes.
# Preserve qualified portable-kernel and compiler output bytes, including final blank lines.
python/src/umf/constraint_kernel.py whitespace=-blank-at-eof
python/src/umf/literal_kernel.py whitespace=-blank-at-eof
python/src/umf/generated_resources.py whitespace=-blank-at-eof

