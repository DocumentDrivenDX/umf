{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:compilation:access-request:0.1",
  "type": "object",
  "required": [
    "contract",
    "sources",
    "logical",
    "bindings",
    "records",
    "actions",
    "projections",
    "package",
    "names",
    "mode",
    "profileId",
    "profileVersion",
    "coreVersion"
  ],
  "properties": {
    "contract": {
      "const": "umf-access-generate/0.1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "format",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "json",
              "yaml"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "logical": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "element"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "action"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "record",
          "fields"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "record": {
            "type": "object",
            "required": [
              "module",
              "element"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "element": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "module",
                "element"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "element": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "package": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "pointer",
          "python"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string"
          },
          "python": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "mode": {
      "enum": [
        "strict",
        "report"
      ]
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "profileVersion": {
      "type": "string",
      "minLength": 1
    },
    "coreVersion": {
      "const": "0.10.0"
    }
  },
  "additionalProperties": false
}
