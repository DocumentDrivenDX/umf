{
  "id": "umf.postgresql.catalog",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "Versioned observed PostgreSQL catalog captures with reconstruction archives",
  "schema": {
    "type": "object",
    "required": [
      "profile",
      "state",
      "root"
    ],
    "properties": {
      "profile": {
        "const": "postgresql-catalog-capture"
      },
      "state": {
        "enum": [
          "captured",
          "modified"
        ]
      },
      "root": {
        "$ref": "#/$defs/node"
      }
    },
    "additionalProperties": true,
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:postgresql-catalog:0.1.0",
    "$defs": {
      "node": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "null"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "boolean"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "number"
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "items"
            ],
            "properties": {
              "kind": {
                "const": "array"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "members"
            ],
            "properties": {
              "kind": {
                "const": "object"
              },
              "members": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        ]
      }
    }
  },
  "semantics": "CONTRACT-015. Captured catalog observations and original schema-only dump are retained together. Candidate edits mark the capture modified; no synchronization, execution or universal catalog coverage is implied.",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "UMF PostgreSQL catalog capture profile",
      "version": "0.1.0 / PostgreSQL 17",
      "subset": "The exact evidence query and metadata fields in capture.schema.json, with pg_dump plain schema-only archive; no full pg_catalog or server-state validation"
    },
    "evidence": [
      "tests/postgresql/catalog.test.ts",
      "scripts/postgresql-catalog-oracle.ts"
    ]
  }
}
