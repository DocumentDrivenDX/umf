{
  "type": "object",
  "properties": {
    "compatible": {
      "type": "boolean"
    },
    "executionVerified": {
      "const": false
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "unsupported",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "additionalProperties": true
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:umf:actions:plan:1#/$defs/diagnostic"
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "compatible",
    "executionVerified",
    "obligations",
    "diagnostics"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:actions:plan-assessment:1"
}
