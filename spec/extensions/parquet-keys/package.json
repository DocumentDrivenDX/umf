{
  "id": "umf.parquet.keys",
  "version": "1.0.0",
  "coreVersion": "0.1.0",
  "description": "Experimental Parquet Key observations with exact native archives and explicit enforcement losses",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:parquet:key-binding:1.0.0",
    "title": "Parquet schema observations without authored identity",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "origin",
      "binding",
      "observations"
    ],
    "properties": {
      "origin": {
        "const": "classified"
      },
      "binding": {
        "const": {
          "id": "umf.parquet.keys",
          "version": "1.0.0",
          "nativeVersion": "PyArrow 21.0.0 / parquet-format 219e3f12a62f9476e830c21e26d030d231f7c017",
          "subset": "Physical schema observations with original file bytes; no collection uniqueness, authored identity inference, page validation or native equivalence"
        }
      },
      "observations": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nativePath",
            "index",
            "path",
            "kind",
            "definitionLevel",
            "repetitionLevel",
            "nativeField",
            "enforcement",
            "authorIntent",
            "provenance",
            "scope"
          ],
          "properties": {
            "nativePath": {
              "type": "string",
              "minLength": 1
            },
            "index": {
              "type": "integer",
              "minimum": 1
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "kind": {
              "enum": [
                "physical-leaf",
                "physical-group"
              ]
            },
            "definitionLevel": {
              "type": "integer",
              "minimum": 0
            },
            "repetitionLevel": {
              "type": "integer",
              "minimum": 0
            },
            "nativeField": {},
            "enforcement": {
              "const": "not-expressible"
            },
            "authorIntent": {
              "const": "unknown"
            },
            "provenance": {
              "const": "inferred"
            },
            "scope": {
              "const": "file-schema"
            }
          }
        }
      }
    }
  },
  "semantics": "CONTRACT-040 and TD-044. Native classification and separate core 0.6.0 authored scalar projection retain per-key identity residuals. Qualified binding acceptance is recorded in docs/helix/04-build/evidence/parquet-key-acceptance.md; Key admission and all-five delivery remain separate.",
  "scopes": [
    "document"
  ],
  "capabilities": {
    "validation": "structural",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "Apache Parquet / PyArrow",
      "version": "PyArrow 21.0.0 / parquet-format 219e3f12a62f9476e830c21e26d030d231f7c017",
      "subset": "Physical schema observations with original file bytes; no collection uniqueness, authored identity inference, page validation or native equivalence"
    },
    "evidence": [
      "tests/core-ideals/key-parquet.test.ts",
      "fixtures/validation/key-parquet-discovery-native.json",
      "fixtures/validation/key-parquet-browser.json",
      "tests/core-ideals/key-parquet-projection.test.ts",
      "fixtures/validation/key-parquet-projection-native.json",
      "fixtures/validation/key-parquet-projection-browser.json"
    ]
  }
}
