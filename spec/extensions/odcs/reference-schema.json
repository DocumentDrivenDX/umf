{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:odcs:reference-result:0.1.0",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "usage": {
      "enum": [
        "element",
        "foreignKey"
      ]
    },
    "status": {
      "enum": [
        "resolved",
        "blocked"
      ]
    },
    "complete": {
      "const": false
    },
    "target": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "notation": {
          "enum": [
            "id",
            "name"
          ]
        },
        "node": {
          "$ref": "#/$defs/node"
        }
      },
      "required": [
        "path",
        "notation",
        "node"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source",
    "reference",
    "usage",
    "status",
    "complete",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ]
      },
      "else": {
        "not": {
          "required": [
            "target"
          ]
        }
      }
    }
  ]
}
