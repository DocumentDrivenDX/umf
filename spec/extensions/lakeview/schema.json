{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:lakeview:0.1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/dashboard"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/data"
    },
    {
      "$ref": "#/$defs/dataset"
    },
    {
      "$ref": "#/$defs/layout-item"
    }
  ],
  "$defs": {
    "dashboard": {
      "type": "object",
      "required": [
        "kind",
        "native",
        "order"
      ],
      "properties": {
        "kind": {
          "const": "dashboard"
        },
        "native": {
          "$ref": "#/$defs/node"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": [
        "kind",
        "native",
        "order"
      ],
      "properties": {
        "kind": {
          "const": "page"
        },
        "native": {
          "$ref": "#/$defs/node"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "data"
        }
      },
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "required": [
        "kind",
        "native"
      ],
      "properties": {
        "kind": {
          "const": "dataset"
        },
        "native": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": true
    },
    "layout-item": {
      "type": "object",
      "required": [
        "kind",
        "native"
      ],
      "properties": {
        "kind": {
          "const": "layout-item"
        },
        "native": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": true
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  }
}
