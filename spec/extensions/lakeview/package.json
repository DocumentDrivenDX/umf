{
  "id": "umf.lakeview",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "Databricks AI/BI (Lakeview) dashboard JSON retained exactly by document, page, dataset and layout item, with a reported projection to umf.dashboard",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:lakeview:0.1.0",
    "oneOf": [
      {
        "$ref": "#/$defs/dashboard"
      },
      {
        "$ref": "#/$defs/page"
      },
      {
        "$ref": "#/$defs/data"
      },
      {
        "$ref": "#/$defs/dataset"
      },
      {
        "$ref": "#/$defs/layout-item"
      }
    ],
    "$defs": {
      "dashboard": {
        "type": "object",
        "required": [
          "kind",
          "native",
          "order"
        ],
        "properties": {
          "kind": {
            "const": "dashboard"
          },
          "native": {
            "$ref": "#/$defs/node"
          },
          "order": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      },
      "page": {
        "type": "object",
        "required": [
          "kind",
          "native",
          "order"
        ],
        "properties": {
          "kind": {
            "const": "page"
          },
          "native": {
            "$ref": "#/$defs/node"
          },
          "order": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      },
      "data": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "data"
          }
        },
        "additionalProperties": true
      },
      "dataset": {
        "type": "object",
        "required": [
          "kind",
          "native"
        ],
        "properties": {
          "kind": {
            "const": "dataset"
          },
          "native": {
            "$ref": "#/$defs/node"
          }
        },
        "additionalProperties": true
      },
      "layout-item": {
        "type": "object",
        "required": [
          "kind",
          "native"
        ],
        "properties": {
          "kind": {
            "const": "layout-item"
          },
          "native": {
            "$ref": "#/$defs/node"
          }
        },
        "additionalProperties": true
      },
      "node": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "null"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "boolean"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "number"
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "items"
            ],
            "properties": {
              "kind": {
                "const": "array"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "members"
            ],
            "properties": {
              "kind": {
                "const": "object"
              },
              "members": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        ]
      }
    }
  },
  "semantics": "CONTRACT-056. The native .lvdash.json is held as an exact-token, order-preserving tagged tree split by identity: top-level members on the document, pages on page modules, datasets on elements of one data module and layout items on page elements. Export reassembles compact JSON equal to the source. Widget specs, queries and expressions are not executed or validated against Databricks, so interpretation is never complete. Projection into umf.dashboard returns a loss report with a JSON Pointer for every native construct it does not express.",
  "scopes": [
    "document",
    "module",
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "Databricks AI/BI (Lakeview) dashboard",
      "version": "observed .lvdash.json, widget spec versions 1-3",
      "subset": "Exact retention and export of exported dashboard files; neutral projection of counter, bar, line, area, scatter, pie, heatmap, table, text and filter widgets; no Databricks workspace oracle"
    },
    "evidence": [
      "tests/lakeview/interchange.test.ts",
      "fixtures/lakeview/marketing-campaign.lvdash.json"
    ]
  }
}
