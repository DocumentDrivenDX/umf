{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:table-migration-phases:0.4",
  "title": "Source-bound single existing-column default-change phase",
  "type": "object",
  "properties": {
    "executionProfile": {
      "type": "object",
      "properties": {
        "version": {
          "const": "umf.table-migration-execution/0.4"
        },
        "progressRelation": {
          "const": "umf_lifecycle_progress"
        },
        "ownerOnly": {
          "const": true
        }
      },
      "required": [
        "version",
        "progressRelation",
        "ownerOnly"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^phase-[0-9]{5}$"
          },
          "kind": {
            "const": "default-change"
          },
          "transaction": {
            "const": "required"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^step-[0-9]{5}$"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "transaction",
          "steps"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "executionProfile",
    "phases"
  ],
  "additionalProperties": false
}
