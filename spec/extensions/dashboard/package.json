{
  "id": "umf.dashboard",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "Platform-neutral analytics dashboard declarations: pages, datasets, visuals, text and filters",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:dashboard:0.1.0",
    "title": "UMF-authored dashboard semantic profile 0.1.0",
    "oneOf": [
      {
        "$ref": "#/$defs/dashboard"
      },
      {
        "$ref": "#/$defs/page"
      },
      {
        "$ref": "#/$defs/data"
      },
      {
        "$ref": "#/$defs/dataset"
      },
      {
        "$ref": "#/$defs/visual"
      },
      {
        "$ref": "#/$defs/text"
      },
      {
        "$ref": "#/$defs/filter"
      }
    ],
    "$defs": {
      "reference": {
        "type": "object",
        "required": [
          "module",
          "element"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "expression": {
        "type": "object",
        "required": [
          "language",
          "text"
        ],
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      },
      "modeColor": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "light": {
            "$ref": "#/$defs/color"
          },
          "dark": {
            "$ref": "#/$defs/color"
          }
        }
      },
      "theme": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fontFamily": {
            "type": "string",
            "minLength": 1
          },
          "palette": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/color"
            }
          },
          "roles": {
            "type": "object",
            "properties": {
              "canvasBackground": {
                "$ref": "#/$defs/modeColor"
              },
              "widgetBackground": {
                "$ref": "#/$defs/modeColor"
              },
              "widgetBorder": {
                "$ref": "#/$defs/modeColor"
              },
              "font": {
                "$ref": "#/$defs/modeColor"
              },
              "selection": {
                "$ref": "#/$defs/modeColor"
              }
            }
          }
        }
      },
      "position": {
        "type": "object",
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "field": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "enum": [
              "column",
              "measure"
            ]
          },
          "type": {
            "enum": [
              "string",
              "boolean",
              "integer",
              "decimal",
              "date",
              "date-time"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "encoding": {
        "type": "object",
        "required": [
          "channel",
          "field",
          "aggregation"
        ],
        "properties": {
          "channel": {
            "enum": [
              "x",
              "y",
              "value",
              "target",
              "color",
              "size",
              "angle",
              "label",
              "detail",
              "tooltip",
              "column"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "aggregation": {
            "enum": [
              "none",
              "measure",
              "sum",
              "avg",
              "count",
              "count-distinct",
              "min",
              "max",
              "custom"
            ]
          },
          "expression": {
            "$ref": "#/$defs/expression"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scale": {
            "enum": [
              "quantitative",
              "temporal",
              "categorical"
            ]
          },
          "sort": {
            "type": "object",
            "required": [
              "by"
            ],
            "properties": {
              "by": {
                "enum": [
                  "value-ascending",
                  "value-descending",
                  "label-ascending",
                  "label-descending",
                  "custom"
                ]
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "format": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "number",
                  "currency",
                  "percent",
                  "date"
                ]
              },
              "decimals": {
                "type": "integer",
                "minimum": 0
              },
              "abbreviation": {
                "enum": [
                  "none",
                  "compact"
                ]
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          }
        }
      },
      "dashboard": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "pages",
          "layout"
        ],
        "properties": {
          "kind": {
            "const": "dashboard"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "layout": {
            "type": "object",
            "required": [
              "columns"
            ],
            "properties": {
              "columns": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "theme": {
            "$ref": "#/$defs/theme"
          }
        }
      },
      "page": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "role"
        ],
        "properties": {
          "kind": {
            "const": "page"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "canvas",
              "global-filters"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "data": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "data"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "dataset": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "source",
          "fields"
        ],
        "properties": {
          "kind": {
            "const": "dataset"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "grain": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "table"
                ],
                "properties": {
                  "kind": {
                    "const": "table"
                  },
                  "table": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "query"
                ],
                "properties": {
                  "kind": {
                    "const": "query"
                  },
                  "query": {
                    "$ref": "#/$defs/expression"
                  }
                }
              }
            ]
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/field"
            }
          }
        }
      },
      "visual": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "chart",
          "dataset",
          "encodings",
          "position"
        ],
        "properties": {
          "kind": {
            "const": "visual"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "trace": {
            "type": "string",
            "minLength": 1
          },
          "chart": {
            "enum": [
              "counter",
              "bar",
              "line",
              "area",
              "scatter",
              "pie",
              "heatmap",
              "table"
            ]
          },
          "dataset": {
            "$ref": "#/$defs/reference"
          },
          "rows": {
            "enum": [
              "aggregated",
              "detail"
            ]
          },
          "encodings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/encoding"
            }
          },
          "position": {
            "$ref": "#/$defs/position"
          }
        }
      },
      "text": {
        "type": "object",
        "required": [
          "kind",
          "content",
          "position"
        ],
        "properties": {
          "kind": {
            "const": "text"
          },
          "trace": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "object",
            "required": [
              "format",
              "text"
            ],
            "properties": {
              "format": {
                "enum": [
                  "plain",
                  "markdown"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "position": {
            "$ref": "#/$defs/position"
          }
        }
      },
      "filter": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "control",
          "targets",
          "position"
        ],
        "properties": {
          "kind": {
            "const": "filter"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "trace": {
            "type": "string",
            "minLength": 1
          },
          "control": {
            "enum": [
              "single-select",
              "multi-select",
              "date-range",
              "range",
              "text-search"
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "dataset",
                "field"
              ],
              "properties": {
                "dataset": {
                  "$ref": "#/$defs/reference"
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "default": {
            "type": "object",
            "required": [
              "values"
            ],
            "properties": {
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          },
          "position": {
            "$ref": "#/$defs/position"
          }
        }
      }
    }
  },
  "semantics": "CONTRACT-055. Pages, datasets, visuals, text blocks and filters are declarations independent of any BI platform. Dataset queries, field expressions and custom aggregations are retained with their language/version and are not parsed, executed or translated. Layout is an abstract grid; rendering, interactivity beyond declared filter targets, permissions and refresh are not described. Unknown fields remain incomplete interpretation. No native Lakeview or Tableau serialization is claimed.",
  "scopes": [
    "document",
    "module",
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "UMF-authored dashboard profile",
      "version": "0.1.0",
      "subset": "Versioned semantic declarations in UMF JSON/YAML; expressions retained, not executed; no Lakeview, Tableau or other BI tool compatibility claimed"
    },
    "evidence": [
      "tests/dashboard/profile.test.ts"
    ]
  }
}
