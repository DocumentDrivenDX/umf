{
  "id": "umf.tablespec.facets",
  "version": "1.0.0",
  "coreVersion": "0.1.0",
  "description": "Experimental profile-qualified TableSpec facet classification and authored projection with retained source meaning",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:tablespec:facet-binding:1.0.0",
    "title": "Retained TableSpec facet interpretation profile",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "origin",
      "binding",
      "profile",
      "input",
      "obligation",
      "outcome",
      "observations"
    ],
    "properties": {
      "origin": {
        "const": "classified"
      },
      "binding": {
        "const": {
          "id": "umf.tablespec.facets",
          "version": "1.0.0"
        }
      },
      "profile": {
        "enum": [
          "declared-metadata",
          "json-schema",
          "pyspark-schema",
          "gx-spark",
          "gx-suite-spark",
          "ingest-cast",
          "unresolved"
        ]
      },
      "input": {
        "enum": [
          "raw",
          "model-normalized"
        ]
      },
      "obligation": {
        "enum": [
          "value-domain",
          "exact-input"
        ]
      },
      "outcome": {
        "enum": [
          "exact",
          "approximated",
          "not-expressible",
          "unknown"
        ]
      },
      "observations": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concept",
            "idealPath",
            "nativePath",
            "interpretation",
            "outcome",
            "basis"
          ],
          "properties": {
            "concept": {
              "enum": [
                "length",
                "decimal",
                "integerWidth",
                "conversion",
                "native"
              ]
            },
            "idealPath": {
              "type": "string",
              "minLength": 1
            },
            "nativePath": {
              "type": "string",
              "minLength": 1
            },
            "interpretation": {
              "enum": [
                "declared",
                "inferred",
                "unknown",
                "unsupported"
              ]
            },
            "outcome": {
              "enum": [
                "exact",
                "approximated",
                "not-expressible",
                "unknown"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "semantics": "CONTRACT-040 and TD-043; experimental core 0.5.0 facet classification and authored projection; strict/report residuals and verified source recovery; full binding acceptance is recorded separately",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "structural",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "TableSpec",
      "version": "647e8e566ad78b864282ec65c0b0b2237aa63084",
      "subset": "Scalar-column facet interpretation under explicit consumer/input/obligation profiles; length claims cover well-formed Unicode scalar strings only; no whole-model validation, pipeline execution or native equivalence; authored projection uses explicit native scalar carriers and consumer profiles, with strict/report loss handling and retained ideal recovery"
    },
    "evidence": [
      "tests/core-ideals/facets-tablespec.test.ts",
      "tests/core-ideals/facets-tablespec-suite.test.ts",
      "tests/core-ideals/facets-tablespec-projection.test.ts",
      "spec/core/facets-tablespec-projection.schema.json",
      "fixtures/validation/facets-tablespec-native.json",
      "fixtures/validation/facets-tablespec-browser.json"
    ]
  }
}
