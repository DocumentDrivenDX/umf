{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:sqlserver:constraints:0.1.0",
  "type": "object",
  "required": [
    "complete",
    "tables"
  ],
  "properties": {
    "complete": {
      "const": false
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "table",
          "available",
          "keys",
          "foreign_keys",
          "checks"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "table": {
            "type": "object",
            "required": [
              "schema",
              "name"
            ],
            "properties": {
              "schema": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "available": {
            "type": "object",
            "required": [
              "keys",
              "foreign_keys",
              "checks"
            ],
            "properties": {
              "keys": {
                "type": "boolean"
              },
              "foreign_keys": {
                "type": "boolean"
              },
              "checks": {
                "type": "boolean"
              }
            }
          },
          "keys": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            }
          },
          "foreign_keys": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    }
  }
}
