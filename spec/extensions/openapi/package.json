{
  "id": "umf.openapi",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "OpenAPI JSON/YAML exact tree and source preservation",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:openapi:0.1.0",
    "type": "object",
    "required": [
      "profile",
      "root",
      "originalSource",
      "originalFormat"
    ],
    "properties": {
      "profile": {
        "const": "openapi-json-yaml-0.1"
      },
      "root": {
        "$ref": "#/$defs/node"
      },
      "originalSource": {
        "type": "string"
      },
      "originalFormat": {
        "enum": [
          "json",
          "yaml"
        ]
      },
      "baseUri": {
        "type": "string",
        "minLength": 1
      },
      "resources": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "uri",
            "root",
            "originalSource",
            "originalFormat"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "root": {
              "$ref": "#/$defs/node"
            },
            "originalSource": {
              "type": "string"
            },
            "originalFormat": {
              "enum": [
                "json",
                "yaml"
              ]
            }
          }
        }
      }
    },
    "$defs": {
      "node": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "null"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "boolean"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "number"
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "items"
            ],
            "properties": {
              "kind": {
                "const": "array"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "members"
            ],
            "properties": {
              "kind": {
                "const": "object"
              },
              "members": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        ]
      }
    },
    "dependentRequired": {
      "resources": [
        "baseUri"
      ]
    }
  },
  "semantics": "CONTRACT-011. Exact native JSON tree and source archive; pinned OpenAPI/Swagger object schemas provide bounded validation, not reference, transport or runtime conformance.",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "OpenAPI",
      "version": "Swagger 2.0 schema 2017-08-27; OpenAPI 3.0 schema 2024-10-18; 3.1 schema 2026-08-03; 3.2 schema 2026-08-30",
      "subset": "JSON-compatible JSON/YAML standalone descriptions; 2.0/3.0 check the Schema Object subset in their official schemas, known 3.1/3.2 embedded dialect keyword syntax is checked; unknown dialects are retained without reinterpretation; references and runtime rules remain incomplete; explicit URI-addressed resource archives and literal document-pointer lookup, without schema scope inference"
    },
    "evidence": [
      "tests/openapi/native.test.ts",
      "tests/openapi/corpus.test.ts",
      "fixtures/openapi/corpus-oracle-results.json",
      "tests/openapi/bundle.test.ts",
      "fixtures/openapi/resource-bundle-oracle-results.json",
      "tests/openapi/schemas.test.ts",
      "fixtures/openapi/embedded-schema-oracle-results.json",
      "tests/openapi/references.test.ts",
      "fixtures/openapi/reference-oracle-results.json",
      "tests/openapi/extraction.test.ts",
      "tests/openapi/scope.test.ts",
      "fixtures/openapi/scope-oracle-results.json",
      "tests/openapi/dynamic.test.ts",
      "fixtures/openapi/dynamic-oracle-results.json"
    ]
  }
}
