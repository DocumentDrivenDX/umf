{
  "id": "umf.dataset-source",
  "version": "1.0.0",
  "coreVersion": "0.1.0",
  "description": "Dataset source references and provenance, without retrieval or authentication",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:dataset-source:1.0.0",
    "type": "object",
    "required": [
      "kind",
      "data_kind"
    ],
    "properties": {
      "kind": {
        "enum": [
          "synthetic",
          "external"
        ]
      },
      "data_kind": {
        "enum": [
          "fabricated",
          "observed",
          "deidentified",
          "unknown"
        ]
      },
      "description": {
        "type": "string"
      },
      "generator": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "additionalProperties": true
      },
      "reference": {
        "type": "string",
        "minLength": 1
      },
      "format": {
        "type": "string",
        "minLength": 1
      },
      "revision": {
        "type": "string",
        "minLength": 1
      },
      "checksum": {
        "type": "object",
        "required": [
          "algorithm",
          "value"
        ],
        "properties": {
          "algorithm": {
            "const": "sha256"
          },
          "value": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": true
      },
      "license": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "redistribution": {
            "enum": [
              "allowed",
              "restricted",
              "unknown"
            ]
          },
          "attribution": {
            "type": "string"
          },
          "notices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      },
      "provenance": {
        "type": "object",
        "properties": {
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "transformations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "external"
            }
          }
        },
        "then": {
          "properties": {
            "reference": {},
            "format": {}
          },
          "required": [
            "reference",
            "format"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "synthetic"
            }
          }
        },
        "then": {
          "properties": {
            "generator": {}
          },
          "required": [
            "generator"
          ]
        }
      }
    ],
    "additionalProperties": true
  },
  "semantics": "References are data. No imports, fetching, generation, loading or ontology semantics are authorized.",
  "scopes": [
    "document"
  ],
  "capabilities": {
    "validation": "structural",
    "directions": [],
    "evidence": [
      "tests/domain-packs/schema.test.ts"
    ]
  }
}
