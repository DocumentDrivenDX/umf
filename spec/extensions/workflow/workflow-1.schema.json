{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umf.dev/spec/extensions/workflow/workflow-1.schema.json",
  "title": "UMF workflow declaration 1",
  "type": "object",
  "properties": {
    "profile": {
      "enum": [
        "umf.workflow/1",
        "umf.workflow.correlated/1"
      ]
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$(?![\\s\\S])",
      "maxLength": 128
    },
    "versionPolicy": {
      "const": "drain"
    },
    "entry": {
      "$ref": "#/$defs/id"
    },
    "record": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      },
      "maxItems": 256
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      },
      "maxItems": 256
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "maxItems": 256
    },
    "guards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guard"
      },
      "maxItems": 256
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "maxItems": 1024,
      "minItems": 1
    },
    "reentry": {
      "$ref": "#/$defs/reentry"
    },
    "inFlight": {
      "enum": [
        "bounce",
        "reenroll"
      ]
    },
    "effectFacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      },
      "maxItems": 256
    },
    "edges": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "predicateProfile": {
      "const": "umf.workflow.predicates/1"
    }
  },
  "required": [
    "profile",
    "id",
    "version",
    "versionPolicy",
    "entry",
    "record",
    "effects",
    "events",
    "guards",
    "steps",
    "inFlight",
    "predicateProfile"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$(?![\\s\\S])",
      "maxLength": 128
    },
    "duration": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "elapsed",
            "count"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "elapsed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "elapsed"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "count"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "count"
              },
              "count": {
                "type": "string"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "ns",
                  "us",
                  "ms",
                  "s",
                  "min",
                  "h",
                  "fixed-day",
                  "fixed-week"
                ]
              }
            },
            "required": [
              "kind",
              "count",
              "unit"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "boolean",
            "text",
            "integer",
            "duration",
            "instant"
          ]
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "optional"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "boolean",
            "text",
            "integer",
            "duration",
            "instant"
          ]
        },
        "class": {
          "enum": [
            "success",
            "definitive-failure",
            "retriable",
            "unknown",
            "engine-timeout"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "class"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "parameter": {
          "$ref": "#/$defs/id"
        },
        "field": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "parameter",
        "field"
      ],
      "additionalProperties": false
    },
    "outcomeRoute": {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/id"
        },
        "next": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "outcome",
        "next"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "maxItems": 256
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          },
          "maxItems": 256
        },
        "await": {
          "type": "string",
          "enum": [
            "none",
            "accepted",
            "result"
          ]
        },
        "idempotency": {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "enrollment",
                "record"
              ]
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "enum": [
                      "workflow",
                      "record",
                      "enrollment",
                      "step",
                      "effect",
                      "field"
                    ]
                  },
                  "field": {
                    "$ref": "#/$defs/id"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              "maxItems": 16,
              "minItems": 1
            },
            "enforcement": {
              "enum": [
                "provider",
                "ledger",
                "provider-and-ledger"
              ]
            }
          },
          "required": [
            "scope",
            "parts",
            "enforcement"
          ],
          "additionalProperties": false
        },
        "binding": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "external"
            },
            "action": {
              "$ref": "#/$defs/id"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            "profile": {
              "const": "umf.workflow.external-effect/1"
            }
          },
          "required": [
            "kind",
            "action",
            "revision",
            "profile"
          ],
          "additionalProperties": false
        },
        "emits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 256
        },
        "retry": {
          "type": "object",
          "properties": {
            "class": {
              "enum": [
                "none",
                "idempotent",
                "reconcile-first"
              ]
            },
            "maxRetries": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,2})$(?![\\s\\S])"
            }
          },
          "required": [
            "class",
            "maxRetries"
          ],
          "additionalProperties": false
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        }
      },
      "required": [
        "id",
        "inputs",
        "outcomes",
        "await",
        "idempotency",
        "binding",
        "emits",
        "retry"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "keyType": {
          "type": "string",
          "enum": [
            "text",
            "integer"
          ]
        }
      },
      "required": [
        "id",
        "keyType"
      ],
      "additionalProperties": false
    },
    "pair": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/term"
        },
        {
          "$ref": "#/$defs/term"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "term": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "field",
            "literal"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "field"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "field"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "literal"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "literal"
              },
              "type": {
                "type": "string",
                "enum": [
                  "boolean",
                  "text",
                  "integer",
                  "duration",
                  "instant"
                ]
              },
              "value": {}
            },
            "required": [
              "kind",
              "type",
              "value"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "boolean"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "boolean"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "text"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "integer"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "duration"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "$ref": "#/$defs/duration"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "instant"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "predicate": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "present",
            "eq",
            "lt",
            "and",
            "or",
            "not"
          ]
        }
      },
      "required": [
        "op"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "present"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "op": {
                "const": "present"
              },
              "field": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "op",
              "field"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "eq"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "op": {
                "const": "eq"
              },
              "terms": {
                "$ref": "#/$defs/pair"
              }
            },
            "required": [
              "op",
              "terms"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "lt"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "op": {
                "const": "lt"
              },
              "terms": {
                "$ref": "#/$defs/pair"
              }
            },
            "required": [
              "op",
              "terms"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "and"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "op": {
                "const": "and"
              },
              "clauses": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/predicate"
                },
                "maxItems": 64,
                "minItems": 1
              }
            },
            "required": [
              "op",
              "clauses"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "or"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "op": {
                "const": "or"
              },
              "clauses": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/predicate"
                },
                "maxItems": 64,
                "minItems": 1
              }
            },
            "required": [
              "op",
              "clauses"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "not"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "op": {
                "const": "not"
              },
              "clause": {
                "$ref": "#/$defs/predicate"
              }
            },
            "required": [
              "op",
              "clause"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "guard": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "entry",
            "step",
            "effect"
          ]
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "exit": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "scope",
        "when",
        "exit"
      ],
      "additionalProperties": false
    },
    "conditionRoute": {
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "next": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "when",
        "next"
      ],
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/id"
        },
        "keyField": {
          "$ref": "#/$defs/id"
        },
        "next": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "event",
        "keyField",
        "next"
      ],
      "additionalProperties": false
    },
    "reentry": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "never",
            "once",
            "always",
            "after"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "never"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "never"
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "once"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "once"
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "always"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "always"
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "after"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "after"
              },
              "minimum": {
                "$ref": "#/$defs/duration"
              }
            },
            "required": [
              "mode",
              "minimum"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exit",
            "effect",
            "branch",
            "wait"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "exit"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "exit"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "complete",
                  "suppressed",
                  "failed"
                ]
              }
            },
            "required": [
              "kind",
              "id",
              "disposition"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "effect"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "effect"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "effect": {
                "$ref": "#/$defs/id"
              },
              "input": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/binding"
                },
                "maxItems": 256
              },
              "next": {
                "$ref": "#/$defs/id"
              },
              "routes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/outcomeRoute"
                },
                "maxItems": 256
              }
            },
            "required": [
              "kind",
              "id",
              "effect",
              "input"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "branch"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "branch"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "cases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/conditionRoute"
                },
                "maxItems": 256,
                "minItems": 1
              },
              "else": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "kind",
              "id",
              "cases",
              "else"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wait"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "wait"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "for": {
                "$ref": "#/$defs/duration"
              },
              "until": {
                "type": "string"
              },
              "event": {
                "$ref": "#/$defs/correlation"
              },
              "timeout": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "kind",
              "id",
              "timeout"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  }
}
