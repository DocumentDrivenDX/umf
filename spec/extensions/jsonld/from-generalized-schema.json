{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:jsonld:from-generalized:0.1.0",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "lossPolicy": {
      "enum": [
        "report",
        "reject"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "blocked"
      ]
    },
    "complete": {
      "const": false
    },
    "candidate": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "resourcesUsed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "baseIRI": {
      "type": "string",
      "minLength": 1
    },
    "processingMode": {
      "enum": [
        "json-ld-1.0",
        "json-ld-1.1"
      ]
    }
  },
  "required": [
    "source",
    "lossPolicy",
    "status",
    "complete",
    "resourcesUsed",
    "diagnostics",
    "id",
    "baseIRI",
    "processingMode"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "required": [
          "candidate"
        ]
      },
      "else": {
        "not": {
          "required": [
            "candidate"
          ]
        }
      }
    }
  ]
}
