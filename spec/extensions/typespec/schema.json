{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:typespec:0.1.0",
  "type": "object",
  "required": [
    "profile",
    "entrypoint",
    "files"
  ],
  "properties": {
    "profile": {
      "const": "typespec-1.16.0-sources"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "libraries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
