{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:shacl:path:0.1.0",
  "$ref": "#/$defs/path",
  "$defs": {
    "path": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "predicate"
            },
            "iri": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "iri"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sequence"
            },
            "paths": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/path"
              }
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "alternative"
            },
            "paths": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/path"
              }
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "inverse"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "zeroOrMore"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "oneOrMore"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "zeroOrOne"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
