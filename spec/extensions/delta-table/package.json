{
  "id": "umf.delta.table",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "Exact Delta metadata/protocol pair with embedded schema string and preserved future features",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:delta-table:0.1.0",
    "type": "object",
    "properties": {
      "profile": {
        "const": "delta-table-context"
      },
      "root": {
        "$ref": "#/$defs/node"
      }
    },
    "required": [
      "profile",
      "root"
    ],
    "additionalProperties": true,
    "$defs": {
      "node": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "null"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "boolean"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "number"
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "items"
            ],
            "properties": {
              "kind": {
                "const": "array"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "members"
            ],
            "properties": {
              "kind": {
                "const": "object"
              },
              "members": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        ]
      }
    }
  },
  "semantics": "CONTRACT-018 table context. An explicitly supplied metadata/protocol pair is not a reconciled transaction-log snapshot or a write authorization.",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "Delta transaction-log metadata and protocol context",
      "version": "Protocol 3b1b99cd077ec9c84c8a94c250dea3730cc33392; deltalake 1.6.4 examples",
      "subset": "Exact context preservation, known shape checks, incomplete feature diagnostics and guarded mapped rename candidates. No log reconciliation, transaction commit or general table evolution claim."
    },
    "evidence": [
      "tests/delta/upstream.test.ts",
      "fixtures/delta/upstream/oracle-results.json",
      "fixtures/delta/upstream/browser-results.json",
      "tests/delta/table.test.ts",
      "fixtures/delta/tables/results.json",
      "fixtures/delta/table-results.json",
      "fixtures/delta/table-browser-results.json",
      "tests/delta/column-mapping.test.ts",
      "tests/delta/rename.test.ts",
      "fixtures/delta/mapping/oracle-results.json",
      "fixtures/delta/mapped-data/rename-oracle-results.json",
      "tests/delta/mapped-nested.test.ts",
      "fixtures/delta/mapped-nested/oracle-results.json"
    ]
  }
}
