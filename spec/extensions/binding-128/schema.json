{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:binding:0.3.0",
  "title": "UMF 128-bit physical carriers",
  "type": "object",
  "required": [
    "profile",
    "logical",
    "target",
    "elements",
    "fields",
    "relationships",
    "indexes"
  ],
  "properties": {
    "profile": {
      "const": "umf-binding-3"
    },
    "logical": {
      "type": "object",
      "required": [
        "documentId",
        "coreVersion"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "coreVersion": {
          "const": "0.9.0"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "system",
        "version",
        "subset"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "subset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "element"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "minLength": 1
          },
          "partition": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "table": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000000
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "element",
          "storage"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "minLength": 1
          },
          "storage": {
            "enum": [
              "column",
              "embedded",
              "scalar-carrier"
            ]
          },
          "column": {
            "type": "string",
            "minLength": 1
          },
          "documentColumn": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "carrier": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "column"
                ],
                "properties": {
                  "kind": {
                    "const": "native-uuid"
                  },
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000000
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "column"
                ],
                "properties": {
                  "kind": {
                    "const": "bytes16"
                  },
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000000
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "column"
                ],
                "properties": {
                  "kind": {
                    "const": "uuid-text"
                  },
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000000
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "column"
                ],
                "properties": {
                  "kind": {
                    "const": "hex128-text"
                  },
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000000
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "highColumn",
                  "lowColumn",
                  "signed"
                ],
                "properties": {
                  "kind": {
                    "const": "words64"
                  },
                  "highColumn": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000000
                  },
                  "lowColumn": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000000
                  },
                  "signed": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "enum": [
                        "native-uuid",
                        "bytes16",
                        "uuid-text",
                        "hex128-text",
                        "words64"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "embedded"
                }
              },
              "required": [
                "storage"
              ]
            },
            "then": {
              "required": [
                "documentColumn",
                "path"
              ],
              "properties": {
                "documentColumn": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "$ref": "#/$defs/path"
                }
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "documentColumn"
                    ]
                  },
                  {
                    "required": [
                      "path"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "scalar-carrier"
                }
              },
              "required": [
                "storage"
              ]
            },
            "then": {
              "required": [
                "carrier"
              ],
              "properties": {
                "field": false,
                "column": false,
                "documentColumn": false,
                "path": false,
                "carrier": {}
              }
            }
          },
          {
            "if": {
              "properties": {
                "storage": {
                  "enum": [
                    "column",
                    "embedded"
                  ]
                }
              },
              "required": [
                "storage"
              ]
            },
            "then": {
              "properties": {
                "carrier": false
              }
            }
          }
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "id",
          "storage"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "storage": {
            "enum": [
              "edge",
              "foreign_key",
              "junction",
              "inline"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "indexes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/index"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "element",
          "members"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/elementRef"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "elementRef": {
      "type": "object",
      "required": [
        "module",
        "element"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationshipRef": {
      "type": "object",
      "required": [
        "module",
        "id"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "indexTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "$ref": "#/$defs/elementRef"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "documentPath"
          ],
          "properties": {
            "documentPath": {
              "type": "object",
              "required": [
                "field",
                "path"
              ],
              "properties": {
                "field": {
                  "$ref": "#/$defs/elementRef"
                },
                "path": {
                  "$ref": "#/$defs/path"
                }
              }
            }
          }
        }
      ]
    },
    "index": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "on",
        "unique"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "btree",
            "hash",
            "gin",
            "gist",
            "expression",
            "partial",
            "unique",
            "clustering"
          ]
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indexTarget"
          }
        },
        "predicate": {
          "type": "object",
          "required": [
            "language",
            "version",
            "expression"
          ],
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "expression": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "unique": {
          "type": "boolean"
        },
        "include": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementRef"
          }
        }
      }
    }
  }
}
