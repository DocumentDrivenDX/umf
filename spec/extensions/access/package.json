            "record": {
              "type": "object",
              "required": [
                "module",
                "element"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "element": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "kind": {
              "enum": [
                "vector",
                "keyword"
              ]
            },
            "exactness": {
              "enum": [
                "exact",
                "approximate"
              ]
            },
            "filterable": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "module",
                  "element"
                ],
                "properties": {
                  "module": {
                    "type": "string",
                    "minLength": 1
                  },
                  "element": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "vector": {
              "type": "object",
              "required": [
                "field",
                "model",
                "dimensions",
                "metric",
                "computedBy"
              ],
              "properties": {
                "field": {
                  "type": "object",
                  "required": [
                    "module",
                    "element"
                  ],
                  "properties": {
                    "module": {
                      "type": "string",
                      "minLength": 1
                    },
                    "element": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                },
                "model": {
                  "type": "object",
                  "required": [
                    "id",
                    "version"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                },
                "dimensions": {
                  "type": "integer",
                  "minimum": 1
                },
                "metric": {
                  "enum": [
                    "cosine",
                    "dot",
                    "l2"
                  ]
                },
                "computedBy": {
                  "enum": [
                    "host",
                    "target"
                  ]
                },
                "source": {
                  "type": "object",
                  "required": [
                    "module",
                    "element"
                  ],
                  "properties": {
                    "module": {
                      "type": "string",
                      "minLength": 1
                    },
                    "element": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            },
            "keyword": {
              "type": "object",
              "required": [
                "source",
                "ranking",
                "analyzer",
                "syntax"
              ],
              "properties": {
                "source": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "module",
                      "element"
                    ],
                    "properties": {
                      "module": {
                        "type": "string",
                        "minLength": 1
                      },
                      "element": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "ranking": {
                  "type": "object",
                  "required": [
                    "family"
                  ],
                  "properties": {
                    "family": {
                      "enum": [
                        "bm25",
                        "implementation-defined"
                      ]
                    },
                    "k1": {
                      "type": "number"
                    },
                    "b": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": true
                },
                "analyzer": {
                  "oneOf": [
                    {
                      "const": "implementation-defined"
                    },
                    {
                      "type": "object",
                      "required": [
                        "language",
                        "stemming"
                      ],
                      "properties": {
                        "language": {
                          "type": "string",
                          "minLength": 1
                        },
                        "stemming": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "syntax": {
                  "const": "plain"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "searchBindings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "index",
            "target",
            "native",
            "freshness",
            "maxK",
            "filtering"
          ],
          "properties": {
            "index": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "object",
              "required": [
                "platform",
                "majorVersion"
              ],
              "properties": {
                "platform": {
                  "enum": [
                    "postgresql",
                    "lakebase",
                    "spark-delta",
                    "unity-catalog"
                  ]
                },
                "majorVersion": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "native": {
              "type": "string",
              "minLength": 1
            },
            "freshness": {
              "enum": [
                "transactional",
                "asynchronous"
              ]
            },
            "maxK": {
              "type": "integer",
              "minimum": 1
            },
            "filtering": {
              "enum": [
                "complete",
                "partial"
              ]
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  },
  "semantics": "CONTRACT-070; contextual validation through the compilation admission API",
  "scopes": [
    "module"
  ],
  "capabilities": {
    "validation": "structural",
    "directions": [],
    "evidence": [
      "tests/compilation/access-extension.test.ts",
      "tests/compilation/access-context.test.ts"
    ]
  }
}
