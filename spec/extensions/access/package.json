                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 63
                          }
                        },
                        "additionalProperties": true
                      }
                    ]
                  },
                  "generation": {
                    "enum": [
                      null,
                      "identity",
                      "stored-expression",
                      "default"
                    ]
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "search": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "record",
            "kind",
            "exactness",
            "filterable"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
