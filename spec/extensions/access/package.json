{
  "id": "umf.access",
  "version": "0.1.0",
  "coreVersion": "0.1.0",
  "description": "Authored typed access views over core 0.8.0; experimental metadata validation",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:access:0.1.0",
    "type": "object",
    "required": [
      "views",
      "columns",
      "search",
      "searchBindings"
    ],
    "properties": {
