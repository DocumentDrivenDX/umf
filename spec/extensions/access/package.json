          "properties": {
            "record": {
              "type": "object",
              "required": [
                "module",
                "element"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "element": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "field",
                  "row",
                  "create",
                  "mutable",
                  "generated"
                ],
                "properties": {
                  "field": {
                    "type": "object",
                    "required": [
                      "module",
                      "element"
                    ],
                    "properties": {
                      "module": {
                        "type": "string",
                        "minLength": 1
                      },
                      "element": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  },
                  "row": {
                    "type": "object",
                    "required": [
                      "missing",
                      "null"
                    ],
                    "properties": {
                      "missing": {
                        "type": "boolean"
                      },
                      "null": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": true
                  },
                  "create": {
                    "type": "object",
                    "required": [
                      "missing",
                      "null"
                    ],
                    "properties": {
                      "missing": {
                        "type": "boolean"
                      },
                      "null": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": true
                  },
                  "mutable": {
                    "type": "boolean"
                  },
                  "generated": {
                    "type": "boolean"
                  },
                  "temporal": {
                    "enum": [
                      "instant",
                      "local"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "selectedKey": {
              "type": "object",
              "required": [
                "module",
                "element",
                "key"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "element": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "columns": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "binding",
            "target",
            "columns"
          ],
          "properties": {
            "binding": {
              "type": "object",
              "required": [
                "sourceId",
                "module"
              ],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "module": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "target": {
              "type": "object",
              "required": [
                "platform",
                "majorVersion"
              ],
              "properties": {
                "platform": {
                  "enum": [
                    "postgresql",
                    "lakebase",
                    "spark-delta",
                    "unity-catalog"
                  ]
                },
                "majorVersion": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "field",
                  "type",
                  "notNull",
                  "generation"
                ],
                "properties": {
                  "field": {
                    "type": "object",
                    "required": [
                      "module",
                      "element"
                    ],
                    "properties": {
                      "module": {
                        "type": "string",
                        "minLength": 1
                      },
                      "element": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "notNull": {
                    "type": "boolean"
                  },
                  "collation": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "schema",
                          "name"
                        ],
                        "properties": {
                          "schema": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 63
