{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:linkml:merge:0.1.0",
  "type": "object",
  "properties": {
    "context": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "document": {
                "$ref": "urn:umf:core:0.1.0"
              }
            },
            "required": [
              "key",
              "document"
            ],
            "additionalProperties": true
          }
        },
        "bindings": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "import": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "from",
              "import",
              "target"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "entry",
        "schemas",
        "bindings"
      ],
      "additionalProperties": true
    },
    "mode": {
      "enum": [
        "view",
        "merge-imports"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "blocked"
      ]
    },
    "complete": {
      "const": false
    },
    "closure": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection": {
            "enum": [
              "prefixes",
              "classes",
              "slots",
              "enums",
              "subsets",
              "types"
            ]
          },
          "name": {
            "type": "string"
          },
          "winner": {
            "type": "string"
          },
          "shadowed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "collection",
          "name",
          "winner",
          "shadowed"
        ],
        "additionalProperties": false
      }
    },
    "candidate": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "context",
    "mode",
    "status",
    "complete",
    "closure",
    "selections",
    "diagnostics"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "required": [
          "candidate"
        ]
      },
      "else": {
        "not": {
          "required": [
            "candidate"
          ]
        }
      }
    }
  ]
}
