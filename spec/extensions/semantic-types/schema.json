{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:semantic-types:0.1.0",
  "title": "Versioned semantic type annotations",
  "type": "object",
  "required": [
    "types"
  ],
  "properties": {
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "vocabulary",
        "version",
        "term"
      ],
      "properties": {
        "vocabulary": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "term": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
