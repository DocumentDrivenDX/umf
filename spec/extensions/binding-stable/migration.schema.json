{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:binding:migration:1.0.0",
  "title": "Physical binding stable relationship migration and rollback results",
  "$defs": {
    "original": {
      "allOf": [
        {
          "anyOf": [
            {
              "$ref": "urn:umf:core:0.1.0"
            },
            {
              "$ref": "urn:umf:core:0.2.0"
            },
            {
              "$ref": "urn:umf:core:0.3.0"
            },
            {
              "$ref": "urn:umf:core:0.4.0"
            },
            {
              "$ref": "urn:umf:core:0.5.0"
            },
            {
              "$ref": "urn:umf:core:0.6.0"
            },
            {
              "$ref": "urn:umf:core:0.7.0"
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "vocabularies",
            "extensions"
          ],
          "properties": {
            "vocabularies": {
              "type": "object",
              "required": [
                "umf.binding"
              ],
              "properties": {
                "umf.binding": {
                  "type": "object",
                  "required": [
                    "version"
                  ],
                  "properties": {
                    "version": {
                      "const": "0.1.0"
                    }
                  }
                }
              }
            },
            "extensions": {
              "type": "object",
              "required": [
                "umf.binding"
              ],
              "properties": {
                "umf.binding": {
                  "$ref": "urn:umf:binding:0.1.0"
                }
              }
            }
          }
        }
      ]
    },
    "migrated": {
      "allOf": [
        {
          "anyOf": [
            {
              "$ref": "urn:umf:core:0.1.0"
            },
            {
              "$ref": "urn:umf:core:0.2.0"
            },
            {
              "$ref": "urn:umf:core:0.3.0"
            },
            {
              "$ref": "urn:umf:core:0.4.0"
            },
            {
              "$ref": "urn:umf:core:0.5.0"
            },
            {
              "$ref": "urn:umf:core:0.6.0"
            },
            {
              "$ref": "urn:umf:core:0.7.0"
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "vocabularies",
            "extensions"
          ],
          "properties": {
            "vocabularies": {
              "type": "object",
              "required": [
                "umf.binding"
              ],
              "properties": {
                "umf.binding": {
                  "type": "object",
                  "required": [
                    "version"
                  ],
                  "properties": {
                    "version": {
                      "const": "0.2.0"
                    }
                  }
                }
              }
            },
            "extensions": {
              "type": "object",
              "required": [
                "umf.binding"
              ],
              "properties": {
                "umf.binding": {
                  "$ref": "urn:umf:binding:0.2.0"
                }
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "required": [
        "profile",
        "original",
        "logical",
        "migrated",
        "mappings"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "umf-binding-migration-1"
        },
        "original": {
          "$ref": "#/$defs/original"
        },
        "logical": {
          "$ref": "urn:umf:core:0.7.0"
        },
        "migrated": {
          "$ref": "#/$defs/migrated"
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "original",
              "stable"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/extensions/umf\\.binding/relationships/[0-9]+$"
              },
              "original": {
                "$ref": "urn:umf:binding:0.1.0#/properties/relationships/items"
              },
              "stable": {
                "$ref": "urn:umf:binding:0.2.0#/properties/relationships/items"
              }
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "document",
        "receipt"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/migrated"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      }
    },
    "rollback": {
      "type": "object",
      "required": [
        "document",
        "residuals"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/original"
        },
        "residuals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "value": {}
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/migration"
    },
    {
      "$ref": "#/$defs/rollback"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ]
}
