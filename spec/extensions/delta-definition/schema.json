{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:delta-definition:0.1.0",
  "type": "object",
  "properties": {
    "profile": {
      "const": "databricks-managed-delta/0.1"
    },
    "name": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clusterBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partitionBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "profile",
    "name",
    "clusterBy",
    "partitionBy",
    "properties"
  ],
  "additionalProperties": true
}
