            "enforcement": {
              "enum": [
                "immediate-unique-nonnull",
                "conditional",
                "deferred",
                "nullable",
                "not-unique",
                "unavailable",
                "unknown"
              ]
            },
            "equality": {
              "enum": [
                "exact-on-representable-values",
                "incompatible",
                "unknown"
              ]
            },
            "authorIntent": {
              "const": "unknown"
            },
            "provenance": {
              "const": "inferred"
            },
            "scope": {
              "const": "relation-with-descendants"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
