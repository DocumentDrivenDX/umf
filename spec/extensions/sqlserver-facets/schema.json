{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:sqlserver:facet-binding:1.0.0",
  "title": "Retained SQL Server facet interpretation profile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "origin",
    "binding",
    "profile",
    "obligation",
    "outcome",
    "observations",
    "physicalColumn"
  ],
  "properties": {
    "origin": {
      "const": "classified"
    },
    "binding": {
      "const": {
        "id": "umf.sqlserver.facets",
        "version": "1.0.0"
      }
    },
    "profile": {
      "enum": [
        "stored-value",
        "ordinary-checked-write",
        "unresolved"
      ]
    },
    "obligation": {
      "enum": [
        "value-domain",
        "exact-input"
      ]
    },
    "outcome": {
      "enum": [
        "exact",
        "approximated",
        "not-expressible",
        "unknown"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept",
          "idealPath",
          "nativePath",
          "interpretation",
          "outcome",
          "basis"
        ],
        "properties": {
          "concept": {
            "enum": [
              "length",
              "decimal",
              "integerWidth",
              "conversion",
              "native"
            ]
          },
          "idealPath": {
            "type": "string",
            "minLength": 1
          },
          "nativePath": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "enum": [
              "declared",
              "inferred",
              "unknown",
              "unsupported"
            ]
          },
          "outcome": {
            "enum": [
              "exact",
              "approximated",
              "not-expressible",
              "unknown"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "physicalColumn": {
      "type": "string",
      "minLength": 1
    }
  }
}
