{
  "id": "umf.sqlserver.facets",
  "version": "1.0.0",
  "coreVersion": "0.1.0",
  "description": "Experimental SQL Server scoped facet classification and authored DDL projection with retained meaning",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:sqlserver:facet-binding:1.0.0",
    "title": "Retained SQL Server facet interpretation profile",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "origin",
      "binding",
      "profile",
      "obligation",
      "outcome",
      "observations",
      "physicalColumn"
    ],
    "properties": {
      "origin": {
        "const": "classified"
      },
      "binding": {
        "const": {
          "id": "umf.sqlserver.facets",
          "version": "1.0.0"
        }
      },
      "profile": {
        "enum": [
          "stored-value",
          "ordinary-checked-write",
          "unresolved"
        ]
      },
      "obligation": {
        "enum": [
          "value-domain",
          "exact-input"
        ]
      },
      "outcome": {
        "enum": [
          "exact",
          "approximated",
          "not-expressible",
          "unknown"
        ]
      },
      "observations": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concept",
            "idealPath",
            "nativePath",
            "interpretation",
            "outcome",
            "basis"
          ],
          "properties": {
            "concept": {
              "enum": [
                "length",
                "decimal",
                "integerWidth",
                "conversion",
                "native"
              ]
            },
            "idealPath": {
              "type": "string",
              "minLength": 1
            },
            "nativePath": {
              "type": "string",
              "minLength": 1
            },
            "interpretation": {
              "enum": [
                "declared",
                "inferred",
                "unknown",
                "unsupported"
              ]
            },
            "outcome": {
              "enum": [
                "exact",
                "approximated",
                "not-expressible",
                "unknown"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "physicalColumn": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "semantics": "CONTRACT-040 and TD-043; experimental core 0.5.0 scoped classification, authored DDL projection and verified native/ideal recovery. Full binding acceptance remains gated by composition and compatibility qualification.",
  "scopes": [
    "element"
  ],
  "capabilities": {
    "validation": "structural",
    "directions": [
      "import",
      "export"
    ],
    "native": {
      "system": "SQL Server",
      "version": "2022 16.0.4295.3",
      "subset": "Scalar catalog-column facets with explicit stored/ordinary-checked-write non-null value scope, bounded catalog CHECKs and retained native refinements; no native equivalence"
    },
    "evidence": [
      "tests/core-ideals/facets-sqlserver.test.ts",
      "fixtures/validation/facets-sqlserver-discovery-native.json",
      "fixtures/validation/facets-sqlserver-constraints-evidence.json",
      "spec/core/sqlserver-facet-classification.schema.json",
      "fixtures/validation/facets-sqlserver-classification-browser.json",
      "spec/core/facets-sqlserver-projection.schema.json",
      "tests/core-ideals/facets-sqlserver-projection.test.ts",
      "fixtures/validation/facets-sqlserver-projection-native.json",
      "fixtures/validation/facets-sqlserver-projection-browser.json"
    ]
  }
}
