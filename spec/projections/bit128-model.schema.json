{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:projection:bit128-model:1.0.0",
  "title": "Exact128-bit model projection",
  "type": "object",
  "required": [
    "operation",
    "version",
    "source",
    "binding",
    "lossPolicy",
    "status",
    "residuals",
    "mappings",
    "nativeRequirements"
  ],
  "properties": {
    "operation": {
      "const": "project-bit128-model"
    },
    "version": {
      "const": "1.0.0"
    },
    "source": {
      "$ref": "urn:umf:core:0.9.0"
    },
    "binding": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "lossPolicy": {
      "enum": [
        "strict",
        "report"
      ]
    },
    "status": {
      "enum": [
        "projected",
        "reported",
        "blocked"
      ]
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "record",
          "table",
          "fields"
        ],
        "properties": {
          "record": {
            "type": "object",
            "required": [
              "module",
              "element"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "element": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "identity",
                "slots",
                "paths"
              ],
              "properties": {
                "identity": {
                  "type": "object",
                  "required": [
                    "module",
                    "element"
                  ],
                  "properties": {
                    "module": {
                      "type": "string",
                      "minLength": 1
                    },
                    "element": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "slots": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "format",
        "text"
      ],
      "properties": {
        "format": {
          "enum": [
            "sql",
            "avro",
            "parquet",
            "tablespec"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 4000000
        }
      },
      "additionalProperties": false
    },
    "nativeRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "statements"
        ],
        "properties": {
          "scope": {
            "const": "connection"
          },
          "statements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "candidate": false
        }
      },
      "else": {
        "required": [
          "candidate"
        ]
      }
    }
  ]
}
