{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:nullability-operation:5.0.0",
  "title": "Core nullability inspection and explicit author declaration results (Key envelope) (Relationship envelope)",
  "$defs": {
    "nullability": {
      "enum": [
        "required",
        "absent-allowed",
        "unspecified"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "element"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "$ref": "urn:umf:core:0.10.0"
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "source",
        "target",
        "identity",
        "provenance"
      ],
      "properties": {
        "operation": {
          "const": "declare-core-nullability"
        },
        "version": {
          "const": "5.0.0"
        },
        "source": {
          "$ref": "urn:umf:core:0.10.0"
        },
        "target": {
          "$ref": "urn:umf:core:0.10.0"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "idealPath",
            "nullability",
            "binding",
            "basis",
            "nativePath"
          ],
          "properties": {
            "origin": {
              "const": "authored"
            },
            "idealPath": {
              "type": "string"
            },
            "nullability": {
              "$ref": "#/$defs/nullability"
            },
            "binding": {
              "const": {
                "id": "umf.core.nullability.authoring",
                "version": "5.0.0"
              }
            },
            "basis": {
              "const": "explicit-author-declaration"
            },
            "nativePath": {
              "type": "null"
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/declaration"
    }
  ]
}
