{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:facet-operation:4.0.0",
  "title": "Read-only facet inspection (Schema properties envelope)",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "element"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "$ref": "urn:umf:core:0.8.0"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "enum": [
                "unicode-scalar",
                "byte"
              ]
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "anyOf": [
            {
              "required": [
                "min"
              ],
              "properties": {
                "min": {}
              }
            },
            {
              "required": [
                "max"
              ],
              "properties": {
                "max": {}
              }
            }
          ]
        },
        "precision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "integerWidth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bits",
            "signed"
          ],
          "properties": {
            "bits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "signed": {
              "type": "boolean"
            }
          }
        },
        "collectionSize": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "min"
              ],
              "properties": {
                "min": {}
              }
            },
            {
              "required": [
                "max"
              ],
              "properties": {
                "max": {}
              }
            }
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "range": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "min"
              ],
              "properties": {
                "min": {}
              }
            },
            {
              "required": [
                "max"
              ],
              "properties": {
                "max": {}
              }
            }
          ],
          "properties": {
            "min": {
              "$ref": "urn:umf:core:0.8.0#/$defs/literal"
            },
            "max": {
              "$ref": "urn:umf:core:0.8.0#/$defs/literal"
            },
            "minInclusive": {
              "type": "boolean"
            },
            "maxInclusive": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "dependentRequired": {
        "precision": [
          "scale"
        ],
        "scale": [
          "precision"
        ]
      }
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "source",
        "identity",
        "path",
        "meaning",
        "provenance"
      ],
      "properties": {
        "operation": {
          "const": "inspect-core-facets"
        },
        "version": {
          "const": "4.0.0"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "path": {
          "type": "string"
        },
        "meaning": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "facets",
                "interpreted",
                "uninterpretedPaths"
              ],
              "properties": {
                "state": {
                  "const": "known"
                },
                "facets": {
                  "$ref": "urn:umf:core:0.8.0#/$defs/facets"
                },
                "interpreted": {
                  "$ref": "#/$defs/bounds"
                },
                "uninterpretedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "facets",
                "interpreted",
                "uninterpretedPaths"
              ],
              "properties": {
                "state": {
                  "const": "partial"
                },
                "facets": {
                  "$ref": "urn:umf:core:0.8.0#/$defs/facets"
                },
                "interpreted": {
                  "$ref": "#/$defs/bounds"
                },
                "uninterpretedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "const": "missing"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "const": "inapplicable"
                }
              }
            }
          ]
        },
        "provenance": {
          "const": "unverified"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/lookup"
    }
  ]
}
