{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:sqlserver-key-classification:1.0.0",
  "title": "SQL Server Key observations and explicit residual recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "outcome",
    "source",
    "request",
    "binding",
    "observations",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "classify-sqlserver-keys"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "classified",
        "blocked"
      ]
    },
    "outcome": {
      "enum": [
        "exact",
        "unknown",
        "not-expressible"
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeSource",
        "mode",
        "profile"
      ],
      "properties": {
        "nativeSource": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "profile": {
          "const": "captured-stored-values"
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.sqlserver.keys",
        "version": "1.0.0",
        "nativeVersion": "16.0.4295.3",
        "subset": "Captured SQL Server 2022 v3 rowstore index observations, native equality and enforcement only; no authored identity, source authentication or native equivalence"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "nativePath",
          "fields",
          "primary",
          "enforcement",
          "equality",
          "ignoreDuplicateKey",
          "authorIntent",
          "provenance",
          "scope",
          "reasons"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "table",
              "indexId",
              "name"
            ],
            "properties": {
              "schema": {
                "type": "string",
                "minLength": 1
              },
              "table": {
                "type": "string",
                "minLength": 1
              },
              "indexId": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "nativePath": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "module",
                "element"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "element": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "primary": {
            "type": "boolean"
          },
          "enforcement": {
            "enum": [
              "immediate-unique-nonnull",
              "conditional",
              "nullable",
              "not-unique",
              "unavailable",
              "unknown"
            ]
          },
          "equality": {
            "enum": [
              "exact-on-representable-values",
              "incompatible",
              "unknown"
            ]
          },
          "ignoreDuplicateKey": {
            "type": "boolean"
          },
          "authorIntent": {
            "const": "unknown"
          },
          "provenance": {
            "const": "inferred"
          },
          "scope": {
            "const": "captured-table-stored-values"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "outcome",
          "reason",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "outcome": {
            "enum": [
              "unknown",
              "not-expressible"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "recovery": {
            "const": "Original native catalog retained; authored key intent is not inferred"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target": false,
          "residuals": {
            "type": "array",
            "minItems": 1
          },
          "diagnostics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "exact"
          }
        }
      },
      "then": {
        "properties": {
          "residuals": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "residuals": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          },
          "request": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "strict"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "exact"
          }
        }
      }
    }
  ]
}
