{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:element-selection:0.1.0",
  "type": "object",
  "required": [
    "scope",
    "referenceScope",
    "source",
    "query",
    "sourceValidation",
    "selection",
    "boundaryReferences"
  ],
  "additionalProperties": false,
  "properties": {
    "scope": {
      "const": "core-elements"
    },
    "referenceScope": {
      "const": "explicit-core-references"
    },
    "source": {
      "$ref": "urn:umf:core:0.1.0"
    },
    "query": {
      "type": "object",
      "required": [
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "references": {
          "enum": [
            "none",
            "transitive"
          ]
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scalarTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "identities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "module",
              "element"
            ],
            "additionalProperties": false,
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "element": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sourceValidation": {
      "type": "object",
      "required": [
        "valid",
        "complete",
        "diagnostics"
      ],
      "additionalProperties": false,
      "properties": {
        "valid": {
          "const": true
        },
        "complete": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "path",
              "message",
              "severity"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              }
            }
          }
        }
      }
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "namespace",
          "path",
          "element",
          "includedBy"
        ],
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "element": {
            "$ref": "#/$defs/element"
          },
          "includedBy": {
            "enum": [
              "match",
              "reference"
            ]
          }
        }
      }
    },
    "boundaryReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "reference",
          "targetPath"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "object",
            "required": [
              "module",
              "element"
            ],
            "additionalProperties": false,
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "element": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "reference": {
            "type": "object",
            "required": [
              "role",
              "module",
              "element"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "type": "string",
                "minLength": 1
              },
              "element": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "targetPath": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "knownScalarType": {
      "enum": [
        "boolean",
        "integer",
        "decimal",
        "float",
        "string",
        "binary",
        "date",
        "time",
        "timestamp"
      ],
      "description": "Basic value families; native refinements remain authoritative for ranges, precision, encoding and temporal behavior."
    },
    "scalarType": {
      "anyOf": [
        {
          "$ref": "#/$defs/knownScalarType"
        },
        {
          "type": "string",
          "minLength": 1,
          "not": {
            "$ref": "#/$defs/knownScalarType"
          },
          "description": "Unknown family retained with incomplete semantic validation."
        }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": [
        "role",
        "module",
        "element"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/id"
        },
        "module": {
          "$ref": "#/$defs/id"
        },
        "element": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "scalarType": {
          "$ref": "#/$defs/scalarType"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "namespace",
        "elements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "namespace": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
