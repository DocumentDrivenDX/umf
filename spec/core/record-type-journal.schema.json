{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:record-type-journal:0.1.0",
  "title": "Explicit original0.7/v6 kind and type transition journal consistency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "base",
    "source",
    "events",
    "types",
    "receiptConsistency",
    "issuerAuthority",
    "enforcement"
  ],
  "properties": {
    "operation": {
      "const": "inspect-core-record-type-journal"
    },
    "version": {
      "const": "0.1.0"
    },
    "base": {
      "$ref": "urn:umf:core:0.10.0"
    },
    "source": {
      "$ref": "urn:umf:core:0.10.0"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "urn:umf:core:kind-operation:6.0.0"
              },
              {
                "type": "object",
                "properties": {
                  "operation": {
                    "const": "declare-core-kind"
                  }
                },
                "required": [
                  "operation"
                ]
              }
            ]
          },
          {
            "$ref": "urn:umf:core:record-type-operation:6.0.0"
          }
        ]
      }
    },
    "types": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventIndex",
          "identity",
          "path",
          "recordPath",
          "link",
          "receipt"
        ],
        "properties": {
          "eventIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "element"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "element": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "path": {
            "type": "string",
            "pattern": "^/modules/[0-9]+/elements/[0-9]+/references/[0-9]+$"
          },
          "recordPath": {
            "type": "string",
            "pattern": "^/modules/[0-9]+/elements/[0-9]+$"
          },
          "link": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "path",
              "reference",
              "target",
              "uninterpretedPaths",
              "typeAssertion"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": "string",
                "pattern": "^/modules/[0-9]+/elements/[0-9]+/references/[0-9]+$"
              },
              "reference": {
                "$ref": "urn:umf:core:0.10.0#/$defs/reference",
                "properties": {
                  "role": {
                    "const": "record-type"
                  }
                },
                "type": "object"
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "identity",
                  "path",
                  "kind"
                ],
                "properties": {
                  "identity": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "module",
                      "element"
                    ],
                    "properties": {
                      "module": {
                        "type": "string",
                        "minLength": 1
                      },
                      "element": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^/modules/[0-9]+/elements/[0-9]+$"
                  },
                  "kind": {
                    "const": "record"
                  }
                }
              },
              "uninterpretedPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "typeAssertion": {
                "const": "unverified"
              }
            }
          },
          "receipt": {
            "$ref": "urn:umf:core:record-type-operation:6.0.0"
          }
        }
      }
    },
    "receiptConsistency": {
      "const": "verified"
    },
    "issuerAuthority": {
      "const": "unverified"
    },
    "enforcement": {
      "const": "none"
    }
  }
}
