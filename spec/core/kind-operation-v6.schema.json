{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:kind-operation:6.0.0",
  "title": "Core kind author declaration receipt",
  "$defs": {
    "kind": {
      "enum": [
        "field",
        "record",
        "group"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "element"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "source",
        "target",
        "identity",
        "provenance"
      ],
      "properties": {
        "operation": {
          "const": "declare-core-kind"
        },
        "version": {
          "const": "6.0.0"
        },
        "source": {
          "$ref": "urn:umf:core:0.10.0"
        },
        "target": {
          "$ref": "urn:umf:core:0.10.0"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "idealPath",
            "kind",
            "binding",
            "basis",
            "nativePath"
          ],
          "properties": {
            "origin": {
              "const": "authored"
            },
            "idealPath": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/kind"
            },
            "binding": {
              "const": {
                "id": "umf.core.kind.authoring",
                "version": "6.0.0"
              }
            },
            "basis": {
              "const": "explicit-author-declaration"
            },
            "nativePath": {
              "type": "null"
            }
          }
        }
      }
    }
  },
  "$ref": "#/$defs/declaration"
}
