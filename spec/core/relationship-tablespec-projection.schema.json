{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:relationship-tablespec-projection:1.0.0",
  "title": "Planned authored relationship projection to TableSpec outgoing metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "version",
    "status",
    "outcome",
    "source",
    "author",
    "nativeSource",
    "nativeTarget",
    "request",
    "binding",
    "mappings",
    "residuals",
    "diagnostics"
  ],
  "properties": {
    "operation": {
      "const": "project-relationship-tablespec"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "projected",
        "blocked"
      ]
    },
    "outcome": {
      "enum": [
        "approximated",
        "not-expressible",
        "unknown"
      ]
    },
    "source": {
      "$ref": "urn:umf:core:0.7.0"
    },
    "author": {
      "$ref": "urn:umf:core:relationship-operation:1.0.0#/$defs/declaration"
    },
    "nativeSource": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        },
        {
          "$ref": "urn:umf:core:0.7.0"
        }
      ]
    },
    "nativeTarget": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        },
        {
          "$ref": "urn:umf:core:0.7.0"
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "relationship",
        "mode",
        "columns"
      ],
      "properties": {
        "profile": {
          "const": "outgoing-metadata"
        },
        "relationship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "id"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "mode": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceColumn",
              "targetField",
              "targetColumn"
            ],
            "properties": {
              "sourceColumn": {
                "type": "string",
                "minLength": 1
              },
              "targetField": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "module",
                  "element"
                ],
                "properties": {
                  "module": {
                    "type": "string",
                    "minLength": 1
                  },
                  "element": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "targetColumn": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "binding": {
      "const": {
        "id": "umf.tablespec.relationships",
        "version": "1.0.0",
        "nativeVersion": "647e8e566ad78b864282ec65c0b0b2237aa63084",
        "subset": "Explicit single-source/single-target outgoing metadata with ordered target-Key column pairs; no referential enforcement, lifecycle or authored intent inferred from native import"
      }
    },
    "target": {
      "anyOf": [
        {
          "$ref": "urn:umf:core:0.1.0"
        },
        {
          "$ref": "urn:umf:core:0.2.0"
        },
        {
          "$ref": "urn:umf:core:0.3.0"
        },
        {
          "$ref": "urn:umf:core:0.4.0"
        },
        {
          "$ref": "urn:umf:core:0.5.0"
        },
        {
          "$ref": "urn:umf:core:0.6.0"
        },
        {
          "$ref": "urn:umf:core:0.7.0"
        }
      ]
    },
    "mappings": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idealPath",
          "nativePath",
          "outcome",
          "sourceColumns",
          "targetColumns",
          "targetKey"
        ],
        "properties": {
          "idealPath": {
            "type": "string",
            "minLength": 1
          },
          "nativePath": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "const": "approximated"
          },
          "sourceColumns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "targetColumns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "targetKey": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "residuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "outcome",
          "reason",
          "recovery"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "outcome": {
            "enum": [
              "unknown",
              "not-expressible",
              "approximated"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "recovery": {
            "const": "Retained receipt recovers authored meaning and original native sources; native-only import does not establish authored intent"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "projected"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "report"
              }
            }
          },
          "outcome": {
            "const": "approximated"
          },
          "mappings": {
            "type": "array",
            "minItems": 1
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target": false,
          "mappings": {
            "type": "array",
            "maxItems": 0
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          }
        }
      }
    }
  ]
}
