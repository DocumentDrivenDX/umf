{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:key-operation:3.0.0",
  "title": "Read-only original0.8 Key inspection and lookup",
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "module",
        "element"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "keyIdentity": {
      "type": "object",
      "required": [
        "module",
        "element",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "keyRequest": {
      "type": "object",
      "required": [
        "id",
        "name",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "module",
              "element"
            ],
            "additionalProperties": false,
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "element": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        },
        "primary": {
          "type": "boolean"
        }
      }
    },
    "memberRequest": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "module",
          "element"
        ],
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inspection": {
      "type": "object",
      "required": [
        "operation",
        "version",
        "source",
        "identity",
        "path",
        "meaning",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "inspect-core-keys"
        },
        "version": {
          "const": "3.0.0"
        },
        "source": {
          "$ref": "urn:umf:core:0.8.0"
        },
        "identity": {
          "type": "object",
          "required": [
            "module",
            "element"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "path": {
          "type": "string"
        },
        "provenance": {
          "const": "unverified"
        },
        "meaning": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "state"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "missing"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "inapplicable"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "keys",
                "uninterpretedPaths"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "known"
                },
                "keys": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "urn:umf:core:0.8.0#/$defs/key"
                  }
                },
                "uninterpretedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 0
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "keys",
                "uninterpretedPaths"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "partial"
                },
                "keys": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "urn:umf:core:0.8.0#/$defs/key"
                  }
                },
                "uninterpretedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            }
          ]
        }
      }
    },
    "lookup": {
      "type": "object",
      "required": [
        "operation",
        "version",
        "source",
        "identity",
        "path",
        "key",
        "uninterpretedPaths",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "lookup-core-key"
        },
        "version": {
          "const": "3.0.0"
        },
        "source": {
          "$ref": "urn:umf:core:0.8.0"
        },
        "identity": {
          "type": "object",
          "required": [
            "module",
            "element",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "path": {
          "type": "string"
        },
        "key": {
          "$ref": "urn:umf:core:0.8.0#/$defs/key"
        },
        "uninterpretedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "const": "unverified"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/inspection"
    },
    {
      "$ref": "#/$defs/lookup"
    }
  ],
  "description": "Structural validation does not prove author intent or native enforcement. Recompute receipts and validate their current source/target context before trusting operation results."
}
