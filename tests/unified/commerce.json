{
  "umf": "0.10.0",
  "id": "unified-commerce",
  "title": "Unified client commerce fixture",
  "vocabularies": {
    "umf.actions": { "version": "0.1.0" }
  },
  "modules": [
    {
      "id": "commerce",
      "namespace": "example.commerce",
      "elements": [
        { "id": "customerId", "name": "customerId", "kind": "field", "scalarType": "string", "cardinality": "one", "nullability": "required", "extensions": {} },
        { "id": "customerUuid", "name": "customerUuid", "kind": "field", "scalarType": "uuid", "cardinality": "one", "nullability": "required", "extensions": {} },
        { "id": "externalId", "name": "externalId", "kind": "field", "scalarType": "bits128", "cardinality": "one", "nullability": "required", "extensions": {} },
        { "id": "customerName", "name": "customerName", "kind": "field", "scalarType": "string", "cardinality": "one", "nullability": "required", "extensions": {} },
        { "id": "orderId", "name": "orderId", "kind": "field", "scalarType": "string", "cardinality": "one", "nullability": "required", "extensions": {} },
        { "id": "orderCustomerId", "name": "orderCustomerId", "kind": "field", "scalarType": "string", "cardinality": "one", "nullability": "required", "extensions": {} },
        { "id": "status", "name": "status", "kind": "field", "scalarType": "string", "cardinality": "one", "nullability": "required", "extensions": {} },
        { "id": "amount", "name": "amount", "kind": "field", "scalarType": "decimal", "cardinality": "one", "nullability": "required", "facets": { "precision": 8, "scale": 2 }, "extensions": {} },
        {
          "id": "Customer",
          "name": "Customer",
          "kind": "record",
          "members": [
            { "module": "commerce", "element": "customerId" },
            { "module": "commerce", "element": "customerUuid" },
            { "module": "commerce", "element": "externalId" },
            { "module": "commerce", "element": "customerName" }
          ],
          "keys": [
            { "id": "primary", "name": "primary", "primary": true, "fields": [{ "module": "commerce", "element": "customerId" }] }
          ],
          "extensions": {}
        },
        {
          "id": "Order",
          "name": "Order",
          "kind": "record",
          "members": [
            { "module": "commerce", "element": "orderId" },
            { "module": "commerce", "element": "orderCustomerId" },
            { "module": "commerce", "element": "status" },
            { "module": "commerce", "element": "amount" }
          ],
          "keys": [
            { "id": "primary", "name": "primary", "primary": true, "fields": [{ "module": "commerce", "element": "orderId" }] }
          ],
          "extensions": {}
        }
      ],
      "relationships": [
        {
          "id": "orderCustomer",
          "name": "customer",
          "source": [{ "module": "commerce", "element": "Order" }],
          "target": [{ "module": "commerce", "element": "Customer", "key": "primary" }],
          "sourceMultiplicity": { "min": 0, "max": "*" },
          "targetMultiplicity": { "min": 1, "max": 1 },
          "targetLifecycle": "independent",
          "directed": true,
          "inverse": "orders"
        }
      ],
      "extensions": {
        "umf.actions": {
          "actions": [
            {
              "id": "shipOrder",
              "name": "Ship order",
              "description": "Set an order status to shipped.",
              "parameters": [
                {
                  "id": "entityOrder",
                  "name": "order",
                  "kind": "entity",
                  "target": { "module": "commerce", "element": "Order", "key": "primary" },
                  "required": true
                }
              ],
              "outputs": [],
              "preconditions": [],
              "postconditions": [],
              "failures": [],
              "reads": [],
              "writes": [
                {
                  "id": "orderWrite",
                  "record": { "module": "commerce", "element": "Order" },
                  "selector": {
                    "language": "umf.actions.keys",
                    "version": "1",
                    "expression": "{\"entity\":\"entityOrder\"}",
                    "references": [{ "parameter": "entityOrder" }]
                  },
                  "maxEntities": 1,
                  "fields": [{ "module": "commerce", "element": "status" }],
                  "relationships": [],
                  "create": false,
                  "delete": false
                }
              ],
              "binding": {
                "kind": "recipe",
                "profile": { "id": "graph-write", "version": "1" },
                "effects": [
                  {
                    "id": "setShipped",
                    "kind": "set",
                    "entity": { "parameter": "entityOrder" },
                    "values": [
                      {
                        "field": { "module": "commerce", "element": "status" },
                        "value": { "literal": { "string": "shipped" } }
                      }
                    ]
                  }
                ]
              },
              "authorization": {
                "kind": "roles",
                "profile": { "id": "umf.actions.roles", "version": "1" },
                "roles": ["shipper"]
              },
              "attribution": { "subject": "person-required" },
              "atomicity": "single-store",
              "idempotency": "caller-key-optional",
              "result": { "identities": "created-and-changed", "version": "store-opaque", "receipt": "read-at-least" }
            }
          ]
        }
      }
    }
  ]
}
