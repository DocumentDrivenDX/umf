  "requestEncoding": "Pass requestValue through the existing core-wire encoder. documentRef resolves to a plain UMF Value from sourceFixture; documentPatches are RFC 6902 operations applied before encoding.",
  "cases": [
    {
      "id": "root-exact-int64-json-text",
      "sourceRef": "invoice",
      "requestValue": {
        "op": "avro.schema.proposeNodeEdit",
        "path": "/fields/2/default",
        "replacementJson": "9223372036854775807"
      },
      "expected": {
        "envelope": { "profile": "umf.core-wire/1", "status": "ok" },
        "report": {
          "profile": "umf-r5-avro-candidate/0.1.0",
          "status": "candidate",
          "requiredMembers": ["profile", "status", "source", "document", "edit", "admission", "nativeInspection"],
          "forbiddenMembers": ["validation"],
          "edit": {
            "path": "/fields/2/default",
            "replacement": { "kind": "number", "value": "9223372036854775807" }
          },
          "admission": { "source": { "valid": true, "complete": true }, "candidate": { "valid": true, "complete": true } },
          "sourceAndDocumentDetached": true
        }
      }
    },
    {
      "id": "dependency-edit-uses-artifact-id",
      "sourceRef": "dependency",
      "requestValue": {
        "op": "avro.schema.proposeNodeEdit",
        "path": "/scale",
        "replacementJson": "3",
        "dependencyId": "money.avsc"
      },
      "expected": {
        "envelope": { "profile": "umf.core-wire/1", "status": "ok" },
        "report": {
          "profile": "umf-r5-avro-candidate/0.1.0",
          "edit": {
            "path": "/scale",
            "dependencyId": "money.avsc",
            "replacement": { "kind": "number", "value": "3" }
          },
          "dependencyOrderAndMemberOrderPreserved": true
        }
      }
    },
    {
      "id": "candidate-admission-succeeds-with-inspector-error",
      "sourceRef": "invoice",
      "requestValue": {
        "op": "avro.schema.proposeNodeEdit",
        "path": "/fields/0/type",
        "replacementJson": "\"MissingName\""
      },
      "expected": {
        "envelope": { "status": "ok" },
        "report": {
          "admission": { "candidate": { "valid": true, "complete": true } },
          "nativeInspection": { "candidate": { "valid": false, "complete": false } }
        }
      }
    },
    {
