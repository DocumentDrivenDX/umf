  "cliCases": [
    { "id": "version", "argv": ["avro", "candidate-edit", "--version"], "expectedProfile": "umf-r5-avro-candidate/0.1.0" },
    { "id": "capabilities", "argv": ["avro", "candidate-edit", "--capabilities"], "expectedOperations": ["avro.schema.proposeNodeEdit"], "defaultAdapterActivation": false },
